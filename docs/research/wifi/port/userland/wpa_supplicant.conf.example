# ruan-wifi=5 test config for /private/etc/wifi/wpa_supplicant.conf (build-wifi-userspace.py --conf FILE).
# By default no network is configured: wifid sends the network chosen in Settings over the native control channel.
# A fixed network only for a test image: copy this file OUTSIDE git, fill in the placeholders, pass it with --conf.
# Never commit a real key.
ap_scan=1
network={
    ssid="YOUR_SSID"
    psk="YOUR_WPA2_PASSPHRASE"
    key_mgmt=WPA-PSK
}
