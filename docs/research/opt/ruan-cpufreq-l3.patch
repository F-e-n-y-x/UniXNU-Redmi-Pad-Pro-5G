+static void
+vote(volatile uint32_t *r, uint32_t row)
+{
+	unsigned cores = (r[kDcvs / 4] & 1) ? 4 : 1;   // ruan: 4 CPUs per domain
+	for (unsigned i = 0; i < cores; i++) {
+		r[(kPerf + 4 * i) / 4] = row;
+	}
+}
 
