+	if (!dcvs_running) return;
+	dcvs_stop = 1;
+	for (unsigned i = 0; __atomic_load_n(&dcvs_running, __ATOMIC_ACQUIRE) && i < 200; i++) delay(10000);
+	if (dcvs_running) kprintf("ruan-gpu: dcvs did not stop in 2 s\n");
+}
