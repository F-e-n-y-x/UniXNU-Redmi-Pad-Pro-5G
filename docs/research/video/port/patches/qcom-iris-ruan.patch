--- a/src/IrisVpu.c	2026-11-21 14:34:52.433283293 +0530
+++ b/src/IrisVpu.c	2026-11-21 14:35:09.353741947 +0530
@@ -137,6 +137,26 @@
     wr(io, CPU_CS_AHB_BRIDGE_SYNC_RESET, 0);
 }
 
+void qcom_iris_vpu2_power_off_hardware(const struct qcom_iris_vpu_io *io, unsigned pipes)
+{
+    if (!(rd(io, WRAPPER_CORE_POWER_STATUS) & 2)) return;   /* is_iris2_hw_power_collapsed */
+    if (rd(io, WRAPPER_CORE_CLOCK_CONFIG)) wr(io, WRAPPER_CORE_CLOCK_CONFIG, CORE_CLK_RUN);
+    for (unsigned i = 0; i < pipes; ++i)   /* downstream logs a timeout here and goes on */
+        (void)poll(io, VCODEC_SS_IDLE_STATUSN + 4 * i, 0x400000, 0x400000, 2000, 20000);
+    wr(io, CPU_CS_AHB_BRIDGE_SYNC_RESET, CORE_BRIDGE_SW_RESET | CORE_BRIDGE_HW_RESET_DISABLE);
+    wr(io, CPU_CS_AHB_BRIDGE_SYNC_RESET, CORE_BRIDGE_HW_RESET_DISABLE);
+    wr(io, CPU_CS_AHB_BRIDGE_SYNC_RESET, 0);
+}
+
+void qcom_iris_vpu2_power_off_controller(const struct qcom_iris_vpu_io *io)
+{
+    wr(io, CPU_CS_X2RPMH, MSK_SIGNAL_FROM_TENSILICA | MSK_CORE_POWER_ON);
+    wr(io, WRAPPER_DEBUG_BRIDGE_LPI_CONTROL, 0x7);
+    (void)poll(io, WRAPPER_DEBUG_BRIDGE_LPI_STATUS, 0x7, 0x7, 200, 2000);
+    wr(io, WRAPPER_DEBUG_BRIDGE_LPI_CONTROL, 0);
+    (void)poll(io, WRAPPER_DEBUG_BRIDGE_LPI_STATUS, 0xffffffffu, 0, 200, 2000);
+}
+
 void qcom_iris_vpu_power_off_controller(const struct qcom_iris_vpu_io *io)
 {
     wr(io, CPU_CS_X2RPMH, MSK_SIGNAL_FROM_TENSILICA | MSK_CORE_POWER_ON);
