ruan: owner-dataprotect=1 emulates data-protection classes on the unencrypted Data volume (PosterBoard's poster store)

Port of UniXNU-sheng patches/xnu-12377/zzzz-sheng-ipados27-bringup.patch:533-616 (kpi_vfs.c) to xnu-10063. Without
content protection (MNT_CPROTECT clear) APFS reports class 0 and drops any class a caller sets, so PosterBoard creates its
store with NSFileProtectionNone (class D), reads it back as missing and judges the store non-viable. With owner-dataprotect=1
a writable volume without content protection keeps the class in the xattr com.unixnu.dataprotect-class; a file without one
reads as class D. Beyond sheng: VNOP_CREATE takes the class of open_dprotected_np(O_CREAT, class) out of what APFS sees and
stores it on the new file, and openat_dprotected_internal clamps a class outside A..CX to D. Nothing is encrypted; off
without the boot-arg. A Data volume whose PosterBoard store was judged non-viable before needs that store reset.

--- a/bsd/vfs/kpi_vfs.c
+++ b/bsd/vfs/kpi_vfs.c
@@ -104,6 +104,7 @@
 #include <sys/user.h>
 #include <sys/lockf.h>
 #include <sys/xattr.h>
+#include <pexpert/pexpert.h>
 #include <sys/kdebug.h>
 
 #include <kern/assert.h>
@@ -3498,6 +3499,80 @@
 	return _err;
 }
 
+/*
+ * ruan owner-dataprotect=1 (UniXNU-sheng zzzz-sheng-ipados27-bringup.patch, ported to xnu-10063): data protection on a volume
+ * without content protection. The RAM/UFS Data volume is an unencrypted APFS volume (MNT_CPROTECT clear): APFS answers class 0
+ * for every file and keeps no class a caller sets, so PosterBoard, which creates its poster store with NSFileProtectionNone
+ * (class D) and checks it back, judges the store not viable and has no wallpaper. With the boot-arg a writable volume without
+ * content protection keeps the class in an extended attribute, and a file without one reads as class D. Nothing is encrypted.
+ */
+#define NATIVE_DATAPROTECT_XATTR "com.unixnu.dataprotect-class"
+#define NATIVE_DATAPROTECT_CLASS_D 4
+
+int native_dataprotect_enabled(void);
+
+int
+native_dataprotect_enabled(void)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		uint32_t value = 0;
+		enabled = PE_parse_boot_argn("owner-dataprotect", &value, sizeof(value)) && value == 1;
+	}
+	return enabled;
+}
+
+static int
+native_dataprotect_emulated(vnode_t vp)
+{
+	mount_t mp = vnode_mount(vp);
+	return native_dataprotect_enabled() && mp != NULL && !(vfs_flags(mp) & MNT_CPROTECT) && !vfs_isrdonly(mp) &&
+	       (vnode_isreg(vp) || vnode_isdir(vp));
+}
+
+static void
+native_dataprotect_getattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	uint32_t class = 0;
+	size_t size = sizeof(class);
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	if (uio == NULL) {
+		return;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(&class), sizeof(class));
+	if (vn_getxattr(vp, NATIVE_DATAPROTECT_XATTR, uio, &size, XATTR_NOSECURITY, ctx) != 0 || class == 0 || class > 7) {
+		class = NATIVE_DATAPROTECT_CLASS_D;
+	}
+	uio_free(uio);
+	vap->va_dataprotect_class = class;
+	VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+}
+
+/* Stores the class in the xattr; 0 when stored. */
+static int
+native_dataprotect_store(vnode_t vp, uint32_t class, vfs_context_t ctx)
+{
+	int error;
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	if (uio == NULL) {
+		return ENOMEM;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(&class), sizeof(class));
+	error = vn_setxattr(vp, NATIVE_DATAPROTECT_XATTR, uio, XATTR_NOSECURITY, ctx);
+	uio_free(uio);
+	return error;
+}
+
+/* Keeps the class asked for and takes it out of what the file system is asked to set (which would only drop it). */
+static void
+native_dataprotect_setattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	if (native_dataprotect_store(vp, vap->va_dataprotect_class, ctx) == 0) {
+		VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+		VATTR_CLEAR_ACTIVE(vap, va_dataprotect_class);
+	}
+}
+
