+static void
+nvt_send_active(void)
+{
+	static const uint8_t cmd[2] = { 0x7a, 0x01 };
+
+	if (nvt_active) {
+		nvt_log("active mode write ok, ", nvt_write(NVT_EVENT_BUF + NVT_EV_HOST_CMD, cmd, sizeof cmd), 0);
+	}
+}
