+/* ruan: the same stream graph, linked to the given device graph sink. */
+uint32_t ar_open_playback_stream_to(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, uint32_t sink_iid)
+{
     static const Sg sg = {AR_SG_PLAY, PERF_LOW_LATENCY, DIR_RX, SCENARIO_PLAYBACK};
     static const Container c = {AR_SG_PLAY, POS_STREAM};
