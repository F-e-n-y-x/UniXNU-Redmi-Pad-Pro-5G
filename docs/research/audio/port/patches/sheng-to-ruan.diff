+/* ruan: media format, frame size factor, codec DMA interface (LPAIF_RXTX, intf_index, channels) and power mode of the RX sink. */
+uint32_t ar_config_codec_rx_device(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token, const ArFormat *f, uint32_t intf_index,
+                                   uint32_t channel_mask)
+{
+    W w;
+    begin(&w, out, capacity, port, AR_APM_IID, token, AR_OP_SET_CFG);
+    const uint32_t cmd = cmd_payload_start(&w);
+    hw_ep_mf(&w, AR_IID_SPEAKER_DMA, f);
+    frame_size_factor(&w, AR_IID_SPEAKER_DMA);
+    uint32_t at = param_begin(&w, AR_IID_SPEAKER_DMA, PARAM_CODEC_DMA_INTF);
+    put32(&w, LPAIF_RXTX); put32(&w, intf_index); put32(&w, channel_mask);
+    param_end(&w, at);
+    at = param_begin(&w, AR_IID_SPEAKER_DMA, PARAM_HW_EP_POWER_MODE);
+    put32(&w, 0);
+    param_end(&w, at);
+    cmd_payload_end(&w, cmd);
     return finish(&w);
 }
 
