+/* ruan: device subgraph 0x4005 with one codec DMA sink (as the mic device graph, mirrored: one input, no output). */
+uint32_t ar_open_codec_rx_device(uint8_t *out, uint32_t capacity, uint32_t port, uint32_t token)
+{
+    static const Sg sg = {AR_SG_SPEAKER, PERF_LOW_LATENCY, DIR_RX, SCENARIO_PLAYBACK};
+    static const Container c = {AR_SG_SPEAKER, POS_GLOBAL_DEV};
+    static const Module m[] = {{AR_MOD_CODEC_DMA_SINK, AR_IID_SPEAKER_DMA, 1, 0}};
+    return graph_open(out, capacity, port, token, &sg, &c, m, 1, 0, 0);
+}
