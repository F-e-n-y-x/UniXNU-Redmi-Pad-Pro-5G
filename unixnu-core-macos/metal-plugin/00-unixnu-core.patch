+base = ['xcrun', 'clang', '-target', {'ios': 'arm64-apple-ios17.0', 'ios27': 'arm64e-apple-ios27.0', 'macos27': 'arm64-apple-macos26.0'}[args.target], '-isysroot', sdk, '-O2', '-g', '-Wall', '-Wextra', '-Werror',
+        '-fstack-protector-strong']
+if args.target == 'macos27':
+    base.append('-mcpu=cortex-a78')   # ruan's A78/A55 (ARMv8.2): not the apple-m1 default (LRCPC2/SHA3 -> SIGILL)
+source_hash = hashlib.sha256()
+for path in sorted((ROOT / 'drivers/AdrenoMetal').rglob('*')):
+    if path.is_file() and '.git' not in path.parts and path.relative_to(ROOT / 'drivers/AdrenoMetal').parts[0] != 'tools' and path.suffix in ('.h','.mm','.cpp','.rs','.patch'):
+        source_hash.update(str(path.relative_to(ROOT / 'drivers/AdrenoMetal')).encode())
+        source_hash.update(path.read_bytes())
+metal_build_id = source_hash.hexdigest()
+base += ['-DNATIVE_METAL_BUILD_ID="' + metal_build_id + '"']
+(resources / 'gpu-build.json').write_text(json.dumps({'metal_source_sha256': metal_build_id, 'target': args.target}, indent=2)+'\n')
