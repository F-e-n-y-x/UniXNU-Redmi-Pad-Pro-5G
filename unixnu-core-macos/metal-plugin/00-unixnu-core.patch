+                # IOGPU adapter (IOGPUMetalDeviceShim.h) keeps the accelerator port with IOKit.
+                *(['-F', f'{sdk}/System/Library/PrivateFrameworks', '-framework', 'IOGPU', '-framework', 'IOKit'] if MACOS else []), '-o', exe],
+               check=True)
