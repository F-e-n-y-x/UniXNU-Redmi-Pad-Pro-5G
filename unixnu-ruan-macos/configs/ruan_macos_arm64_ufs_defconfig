# ruan macOS defconfig, plain arm64 kernel (no PAC): ARM64 DT platform and CPU, prelinked crypto, GOP display
# (build-gop-legacy-display-27.py in its arm64 mode: plain vtable pointers).
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
# UFS root variant (macos/tools/make-macos-ufs-board.sh): ShengUfs, root on the "unixnu" partition.
CONFIG_XNU_NATIVE_UFS=y
# Adreno 710 driver (scripts/build-ruan-adreno.py), force-loaded as on iPadOS so its metaclasses register; RuanGpuPower.c and the
# IOAccelerator subclass ride in libNativeLegacyDisplay.late.a (build-gop-legacy-display-27.py).
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/ruan-adreno/libRuanAdreno.a"
