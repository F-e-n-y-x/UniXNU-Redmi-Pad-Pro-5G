diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -1133,6 +1133,15 @@
 	-Wl,-threaded_starts_section
 endif
 
+ifeq ($(XNU_KERNEL_CHAINED_FIXUPS),1)
+# ruan: a plain arm64 (non-PAC) kernel joins the macOS fileset. ld -kernel needs -fixup_chains
+# on arm64 and then writes format 6 (DYLD_CHAINED_PTR_64_OFFSET) chains, which XnuPrelink converts.
+LDFLAGS_KERNEL_ONLY_SUBARCH_arm64 = \
+	-Wl,-add_split_seg_info \
+	-Wl,-fixup_chains \
+	-Wl,-kernel
+endif
+
 LDFLAGS_KERNEL_ONLY_SUBARCH_x86_64 = \
 	-Wl,-add_split_seg_info \
 	-Wl,-kernel
