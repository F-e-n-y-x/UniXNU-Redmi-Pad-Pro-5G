ruan: 16K-equivalent free-page thresholds on the 4K-page macOS kernel, and a log line for every user fault that ends in SIGBUS.

--- a/osfmk/vm/vm_pageout.c
+++ b/osfmk/vm/vm_pageout.c
@@ -267,9 +267,11 @@
 #define VM_PAGE_FREE_MIN_LIMIT          1500
 #define VM_PAGE_FREE_TARGET_LIMIT       2000
 #else /* !XNU_TARGET_OS_OSX */
-#define VM_PAGE_FREE_RESERVED_LIMIT     1700
-#define VM_PAGE_FREE_MIN_LIMIT          3500
-#define VM_PAGE_FREE_TARGET_LIMIT       4000
+/* ruan: macOS tunes these page counts for 16K pages; on this 4K-page kernel they left the scanner only ~14 MB of headroom, and a
+ * no-wait allocation or page-in failed in that window (WindowServer SIGBUS once reclaim began). Same bytes as on Apple silicon. */
+#define VM_PAGE_FREE_RESERVED_LIMIT     (1700 * (16384 / PAGE_SIZE))
+#define VM_PAGE_FREE_MIN_LIMIT          (3500 * (16384 / PAGE_SIZE))
+#define VM_PAGE_FREE_TARGET_LIMIT       (4000 * (16384 / PAGE_SIZE))
 #endif /* !XNU_TARGET_OS_OSX */
 
 /*
