ruan: launchd-normal-boot=1 hides rd=md0 from userland's kern.bootargs (shown as rootdev=md0)

launchd 17.7.11 (sbin/launchd 0x100046674) strstr()s kern.bootargs for "rd=md0" and then runs as a restore environment:
"Restore environment starting.", only PerformInRestore boot tasks (no keybag, usermanagerd, mount phases, featureflags,
xpcroleaccountd), no service cache, its log on the console. The kernel keeps reading rd=md0 itself (bsd_rooted_ramdisk,
IOKit root matching), so the RAM root mounts as before; IOKit also accepts rootdev=md0. Off without the boot-arg.

--- a/bsd/kern/kern_sysctl.c
+++ b/bsd/kern/kern_sysctl.c
@@ -2191,6 +2191,15 @@
 	char buf[BOOT_LINE_LENGTH];
 
 	strlcpy(buf, PE_boot_args(), BOOT_LINE_LENGTH);
+	unsigned normal_boot = 0;
+	char *rd = NULL;
+	if (PE_parse_boot_argn("launchd-normal-boot", &normal_boot, sizeof(normal_boot)) && normal_boot &&
+	    (rd = strnstr(buf, "rd=md0", sizeof(buf))) != NULL && (rd == buf || rd[-1] == ' ') &&
+	    strlen(buf) + 4 < sizeof(buf)) {
+		/* "rd=" -> "rootdev=": shift the rest right by 4 (terminator included) */
+		memmove(rd + 4, rd, strlen(rd) + 1);
+		memcpy(rd, "rootdev=", 8);
+	}
 	error = sysctl_io_string(req, buf, BOOT_LINE_LENGTH, 0, NULL);
 	return error;
 }
