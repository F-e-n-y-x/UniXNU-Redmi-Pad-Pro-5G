+/* One zero-filled pool run (NativeAdrenoPoolAllocate scrubbed it) mapped write-combined in the kernel: Normal NC, so no CPU cache
+ * holds a line of it (holdsCpuLines is false for a grant) and the pages' attribute is never changed (write_combined_ stays false:
+ * the pmap has no page for them). On failure the caller's release() gives back what was taken. */
+IOReturn NativeAdrenoMemory::allocatePoolContiguous(size_t bytes,uint64_t limit)
+{
+    IOReturn status=NativeAdrenoPoolAllocate(bytes,limit,true,&grant_);
+    if(status)return status;
+    prepared_=true;bytes_=bytes;
+    if(grant_->count!=1)return kIOReturnNoResources;
+    status=takeRuns(grant_,bytes,limit);
+    if(status)return status;
+    IOMemoryDescriptor *run=IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress)spans_[0].physical,bytes,kIODirectionInOut);
+    if(!run)return kIOReturnNoMemory;
+    pool_map_=run->createMappingInTask(kernel_task,0,kIOMapAnywhere|kIOMapWriteCombineCache);
+    run->release();
+    if(!pool_map_ || pool_map_->getLength()!=bytes)return kIOReturnNoMemory;
+    mapping_=reinterpret_cast<void *>(pool_map_->getVirtualAddress());
+    if(!mapping_ || ((uintptr_t)mapping_&4095))return kIOReturnUnsupported;
+    bzero(mapping_,bytes);
+    __asm__ volatile("dsb sy":::"memory");
+    NativeAdrenoNotePhase(NativeAdrenoPhaseAllocate,bytes);
+    noteOwned(spans_,span_count_,true);owned_=true;
+    native_adreno_bo_memory[6]=native_adreno_bo_memory[6]+1;
+    return kIOReturnSuccess;
+}
