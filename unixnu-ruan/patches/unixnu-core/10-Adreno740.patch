+class AGXDeviceUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(AGXDeviceUserClient)
+public:
+    bool initWithTask(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties) APPLE_KEXT_OVERRIDE {
+        if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) return false;
+        return true;
+    }
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE {
+        if (!IOUserClient::start(provider)) return false;
+        return true;
+    }
+    void stop(IOService *provider) APPLE_KEXT_OVERRIDE {
+        IOUserClient::stop(provider);
+    }
+    IOReturn clientClose() APPLE_KEXT_OVERRIDE {
+        terminate();
+        return kIOReturnSuccess;
+    }
+    IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *arguments,
+                            IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE {
+        (void)selector; (void)arguments; (void)dispatch; (void)target; (void)reference;
+        return kIOReturnSuccess;
+    }
+};
+OSDefineMetaClassAndStructors(AGXDeviceUserClient, IOUserClient)
+
+extern "C" IOUserClient *native_adreno_user_client_create(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties) {
+    AGXDeviceUserClient *client = new AGXDeviceUserClient;
+    if (!client) return nullptr;
+    if (!client->initWithTask(owningTask, securityID, type, properties)) {
+        client->release();
+        return nullptr;
+    }
+    return client;
+}
