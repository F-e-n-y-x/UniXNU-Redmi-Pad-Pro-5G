ruan: timer-bounded WFI idle (ruan-idle-wfi-us=N): cores WFI although SIGPdisabled stays set (no IPIs under Gunyah), woken by their idle timer.

--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -119,6 +119,21 @@
 //  1 : normal
 //  2 : overhead simulation (delay & flags)
 TUNABLE(unsigned int, wfi, "wfi", 1);
+
+/* ruan: timer-bounded WFI idle. IPIs do not reach ruan's cores (Gunyah; SIGPdisabled is never cleared), so cpu_idle refuses WFI and
+ * the idle thread spins. ruan-idle-wfi-us=N (0 = off, the spin) lets a core whose interrupt handler is installed WFI anyway, with
+ * its idle timer at most N us ahead: it wakes on that timer (or a device interrupt) and processor_idle then sees the work another
+ * core gave it, so wakeup latency is bounded by N. ruan_idle_wfi_sleep_us (package/RuanInput.c, ruan-sleep=1 with the display off)
+ * replaces N while non-zero. ruan_idle_wfi_count: WFIs per CPU, for USB `cpu`. */
+TUNABLE_WRITEABLE(uint32_t, ruan_idle_wfi_us, "ruan-idle-wfi-us", 0);
+uint32_t ruan_idle_wfi_sleep_us;
+uint64_t ruan_idle_wfi_count[MAX_CPUS];
+
+static void
+ruan_idle_timer_nop(__unused void *refcon, uint64_t *new_timeout_ticks)
+{
+	*new_timeout_ticks = 0;
+}
 #if DEVELOPMENT || DEBUG
 
 // wfi_flags
@@ -497,10 +512,16 @@
 	/* Read and reset the next_idle_short flag */
 	bool next_idle_short = processor->next_idle_short;
 	processor->next_idle_short = false;
+	uint32_t ruan_us = os_atomic_load(&ruan_idle_wfi_sleep_us, relaxed);
+	if (ruan_us == 0) {
+		ruan_us = ruan_idle_wfi_us;
+	}
+	/* ruan: without an installed handler the core's timer may not be routed yet, and a WFI could then never end. */
+	const bool ruan_wfi = ruan_us != 0 && wfi != 0 && cpu_data_ptr->interrupt_handler != NULL;
 
 	if (__improbable((!idle_enable))) {
 		idle_disallowed = true;
-	} else if (__improbable(cpu_data_ptr->cpu_signal & SIGPdisabled)) {
+	} else if (__improbable(cpu_data_ptr->cpu_signal & SIGPdisabled) && !ruan_wfi) {
 		idle_disallowed = true;
 	}
 
@@ -563,6 +584,17 @@
 		cpu_data_ptr->cpu_idle_notify(cpu_data_ptr->cpu_id, TRUE, &new_idle_timeout_ticks);
 	}
 
+	if (ruan_wfi) {
+		uint64_t bound = 0;
+		nanoseconds_to_absolutetime((uint64_t)ruan_us * NSEC_PER_USEC, &bound);
+		if (cpu_data_ptr->idle_timer_notify == NULL) {
+			cpu_data_ptr->idle_timer_notify = ruan_idle_timer_nop;   /* timer_intr calls it unchecked once the deadline passes */
+		}
+		if (new_idle_timeout_ticks == 0x0ULL || new_idle_timeout_ticks > bound) {
+			new_idle_timeout_ticks = bound;
+		}
+	}
+
 	if (cpu_data_ptr->idle_timer_notify != NULL) {
 		if (new_idle_timeout_ticks == 0x0ULL) {
 			/* turn off the idle timer */
@@ -605,6 +637,9 @@
 #else
 		__builtin_arm_wfi();
 #endif
+		if (ruan_wfi) {
+			ruan_idle_wfi_count[cpu_data_ptr->cpu_number]++;
+		}
 
 #if defined(APPLETYPHOON)
 		// <rdar://problem/15827409> CPU1 Stuck in WFIWT Because of MMU Prefetch
