ruan: built-in default boot-args looked up when an argument is not on the 1000-byte kernel command line (command line wins).

--- a/pexpert/gen/bootargs.c
+++ b/pexpert/gen/bootargs.c
@@ -187,13 +187,24 @@
 	return arg_found;
 }
 
+/* ruan: built-in default boot-args. UniXNU caps the kernel command line at 1000 bytes and the board's own arguments take ~500,
+ * so ruan's fixed settings live here: an argument missing from the command line is looked up in this list (the command line
+ * always wins, so any of these can still be overridden there). Userland reads only the real command line (kern.bootargs), so
+ * arguments meant for launchd and friends must stay on it. */
+static char ruan_default_boot_args[] =
+    "memory-outside=1 ruan-ramoops=1 ruan_touch=1 touch_fast=1 touch_irq=1 ruan=1 offline-hid-input=1 offline-hid-home=1 "
+    "sheng-touch-hid=1 ruan-cpufreq=3 ruan-usbdbg=1 ruan-usbdbg-reboot=1 ruan-battery=1 ruan-backlight-control=1 ruan-adreno=1 "
+    "ruan-gpu=18 ruan-gpu-perf=1 ruan-gpu-dcvs=1 ruan-gpu-irq=1 vsync=60 vsync-fixed=1 noidle=1 dpu-scanout=2 dpu-retire-flip=1 "
+    "owner-dataprotect=1 fb-wc=1 armcpu-edge=1";
+
 boolean_t
 PE_parse_boot_argn(
 	const char      *arg_string,
 	void            *arg_ptr,
 	int                     max_len)
 {
-	return PE_parse_boot_argn_internal(PE_boot_args(), arg_string, arg_ptr, max_len, FALSE);
+	return PE_parse_boot_argn_internal(PE_boot_args(), arg_string, arg_ptr, max_len, FALSE) ||
+	       PE_parse_boot_argn_internal(ruan_default_boot_args, arg_string, arg_ptr, max_len, FALSE);
 }
 
 boolean_t
@@ -213,7 +224,8 @@
 	char            *arg_ptr,
 	int                     strlen)
 {
-	return PE_parse_boot_argn_internal(PE_boot_args(), arg_string, arg_ptr, strlen, TRUE);
+	return PE_parse_boot_argn_internal(PE_boot_args(), arg_string, arg_ptr, strlen, TRUE) ||
+	       PE_parse_boot_argn_internal(ruan_default_boot_args, arg_string, arg_ptr, strlen, TRUE);
 }
 
 #if defined(CONFIG_XNUPOST)
