ruan: log the os_reason description of LIBXPC/RunningBoard kills (poster extensions killed every ~5 s, rbu130u-rbu140p).

--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1901,6 +1901,32 @@
 	boot_progress_exit(proc_getpid(p),p->p_name,rv,
 	    p->p_exit_reason ? p->p_exit_reason->osr_namespace : 0,
 	    p->p_exit_reason ? p->p_exit_reason->osr_code : 0);
+	/* ruan: print the killer's description for XPC/RunningBoard kills (poster extensions die with LIBXPC code 3, rbu130u-rbu140p);
+	 * the os_reason kcdata buffer holds EXIT_REASON_USER_DESC. Items: {u32 type, u32 size, u64 flags} + data padded to 16. */
+	if (p->p_exit_reason && p->p_exit_reason->osr_kcd_buf &&
+	    (p->p_exit_reason->osr_namespace == OS_REASON_LIBXPC || p->p_exit_reason->osr_namespace == OS_REASON_RUNNINGBOARD)) {
+		static uint32_t ruan_exit_desc;
+		const char *buf = p->p_exit_reason->osr_kcd_buf;
+		uint32_t size = p->p_exit_reason->osr_bufsize, at = 0, flags_seen = 0;
+		while (ruan_exit_desc < 64 && at + 16 <= size) {
+			uint32_t type = *(const uint32_t *)(const void *)(buf + at), len = *(const uint32_t *)(const void *)(buf + at + 4);
+			if (type == 0xF19158ED || len > size - at - 16) {
+				break;
+			}
+			if (type == EXIT_REASON_USER_DESC && len) {
+				ruan_exit_desc++;
+				printf("ruan-exit: %s[%d] ns %u code 0x%llx desc %.*s\n", p->p_name, proc_getpid(p), p->p_exit_reason->osr_namespace,
+				    p->p_exit_reason->osr_code, (int)len, buf + at + 16);
+				flags_seen = 1;
+			}
+			at += 16 + ((len + 15) & ~15u);
+		}
+		if (!flags_seen && ruan_exit_desc < 64) {
+			ruan_exit_desc++;
+			printf("ruan-exit: %s[%d] ns %u code 0x%llx flags 0x%llx (no description)\n", p->p_name, proc_getpid(p),
+			    p->p_exit_reason->osr_namespace, p->p_exit_reason->osr_code, p->p_exit_reason->osr_flags);
+		}
+	}
 
 	if (p->p_crash_behavior != 0 || p == initproc) {
 		proc_handle_critical_exit(p, rv);
