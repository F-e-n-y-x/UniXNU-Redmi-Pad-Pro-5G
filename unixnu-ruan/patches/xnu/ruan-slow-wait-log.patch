 }
 
+/* ruan (rbu166p): see ruan_slow_wait_note() in osfmk/kern/sched_prim.c. Called in the thread's own context on its way back to user
+ * space; prints the process, the wait and up to 14 user return addresses (fp chain) for the first 300 hits. */
+extern uintptr_t ruan_slow_thread[32];
+extern uint64_t ruan_slow_ticks[32];
+extern char *proc_name_address(void *p);
+void ruan_slow_wait_check(void);
+void
+ruan_slow_wait_check(void)
+{
+	static uint32_t printed;
+	thread_t thread = current_thread();
+	for (unsigned i = 0; i < 32; i++) {
+		if (os_atomic_load(&ruan_slow_thread[i], relaxed) != (uintptr_t)thread) {
+			continue;
+		}
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(ruan_slow_ticks[i], &ns);
+		os_atomic_store(&ruan_slow_thread[i], (uintptr_t)0, relaxed);
+		if (printed >= 300) {
+			return;
+		}
+		printed++;
+		struct arm_saved_state *state = get_user_regs(thread);
+		if (!state || !is_saved_state64(state)) {
+			return;
+		}
+		uint64_t fp = saved_state64(state)->fp, ret[16];
+		unsigned n = 0;
+		ret[n++] = saved_state64(state)->pc;
+		ret[n++] = saved_state64(state)->lr;
+		while (n < 16 && fp && !(fp & 7)) {
+			uint64_t frame[2];
+			if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0 || frame[0] <= fp) {
+				break;
+			}
+			ret[n++] = frame[1];
+			fp = frame[0];
+		}
+		void *bsd = get_bsdtask_info(get_threadtask(thread));
+		printf("ruan-slow: %s tid %llu waited %llu ms sc %d bt", bsd ? proc_name_address(bsd) : "?", thread_tid(thread),
+		    ns / 1000000ULL, (int)get_saved_state_svc_number(state));
+		for (unsigned k = 0; k < n; k++) {
+			printf(" %llx", ret[k]);
+		}
+		printf("\n");
+		return;
+	}
+}
+
 __attribute__((noreturn))
 void
 thread_syscall_return(kern_return_t error)
@@ -2316,6 +2368,7 @@
 
 	assert(is_saved_state64(state));
 	saved_state64(state)->x[0] = error;
+	ruan_slow_wait_check();
 
 #if MACH_ASSERT
 	kern_allocation_name_t
diff -ru a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
--- a/osfmk/kern/sched_prim.c	2026-11-21 11:51:16.460079197 +0530
+++ b/osfmk/kern/sched_prim.c	2026-11-21 11:55:35.967973909 +0530
@@ -810,6 +810,30 @@
  *	Thread wait timer expiration.
  *	Runs in timer interrupt context with interrupts disabled.
  */
+/* ruan (rbu166p): user threads whose wait timed out after 4 s or more, for ruan_slow_wait_check() at their return to user space
+ * (osfmk/arm64/sleh.c), which names the process and walks its user frames: backboardd presents one frame every ~5.0 s. */
+#define RUAN_SLOW_RING 32
+uintptr_t ruan_slow_thread[RUAN_SLOW_RING];
+uint64_t ruan_slow_ticks[RUAN_SLOW_RING];
+static void
+ruan_slow_wait_note(thread_t thread)
+{
+	if (get_threadtask(thread) == kernel_task) {
+		return;
+	}
+	uint64_t waited = mach_absolute_time() - thread->last_run_time, limit;
+	nanoseconds_to_absolutetime(4000000000ULL, &limit);
+	if (waited < limit) {
+		return;
+	}
+	for (unsigned i = 0; i < RUAN_SLOW_RING; i++) {
+		if (os_atomic_cmpxchg(&ruan_slow_thread[i], (uintptr_t)0, (uintptr_t)thread, relaxed)) {
+			ruan_slow_ticks[i] = waited;
+			return;
+		}
+	}
+}
+
 void
 thread_timer_expire(void *p0, __unused void *p1)
 {
@@ -823,6 +847,7 @@
 
 	if (thread->wait_timer_armed) {
 		thread->wait_timer_armed = false;
+		ruan_slow_wait_note(thread);
 		clear_wait_internal(thread, THREAD_TIMED_OUT);
 		/* clear_wait_internal may have dropped and retaken the thread lock */
 	}
