ruan: GPU sandbox grant by user-client class (RuanAdreno*/NativeAdreno*) and from the provider chain; logs GPU misses.

rbu114u-rbu118u (UFS root): backboardd, mediaserverd, WidgetRenderer and the posters are refused RuanAdrenoDeviceUserClient;
WidgetRenderer aborts without a GPU and SpringBoard asserts on its dead scene. "ruan-grant:" lines name the service.

--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -3631,6 +3631,26 @@
 	return obj;
 }
 
+#if CONFIG_MACF
+/* ruan: properties of our own display and GPU services (NativeLegacyDisplay, Adreno), or of a service that carries
+ * NativeSandboxGrantProcess, are readable by every process: the original profiles name Apple's display classes (AppleCLCD,
+ * IOMobileFramebuffer), so CollectionsPoster's reads of NativeLegacyDisplay were refused hundreds of times and the poster died (rbu130u). */
+static int
+ruan_check_get_property(kauth_cred_t cred, IORegistryEntry * entry, const char * name)
+{
+	for (const OSMetaClass * m = entry->getMetaClass(); m; m = m->getSuperClass()) {
+		const char * n = m->getClassName();
+		if (strnstr(n, "NativeLegacy", 64) || strnstr(n, "Adreno", 64) || strnstr(n, "IOGPU", 64)) {
+			return 0;
+		}
+	}
+	if (entry->getProperty("NativeSandboxGrantProcess")) {
+		return 0;
+	}
+	return mac_iokit_check_get_property(cred, entry, name);
+}
+#endif
