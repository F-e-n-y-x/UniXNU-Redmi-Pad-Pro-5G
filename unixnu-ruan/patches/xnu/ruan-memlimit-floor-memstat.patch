ruan: ruan-memlimit-floor also clamps the memorystatus active/inactive limits (highwater kills, rbu122u).

--- a/bsd/kern/kern_memorystatus.c
+++ b/bsd/kern/kern_memorystatus.c
@@ -181,9 +181,22 @@
  * soon be in effect down in the ledgers.
  */
 
+/* ruan: ruan-memlimit-floor=<MB> also raises the memorystatus limits (highwater kills read these, not the ledger: rbu122u mediaserverd) */
+static int
+ruan_memlimit_clamp(int limit)
+{
+	static int floor_mb = -1;
+	if (floor_mb < 0) {
+		int v = 0;
+		PE_parse_boot_argn("ruan-memlimit-floor", &v, sizeof(v));
+		floor_mb = v;
+	}
+	return (limit > 0 && limit < floor_mb) ? floor_mb : limit;
+}
+
