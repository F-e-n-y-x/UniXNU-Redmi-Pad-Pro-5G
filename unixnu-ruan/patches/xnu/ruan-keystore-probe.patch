ruan: start the AppleKeyStore stand-in before launchd (aks=1 offline-key-events=1)

keybagd --init, init_data_protection (RequireSuccess) and usermanagerd need an AppleKeyStore service; ruan has no SEP. The
service is UniXNU's AppleKeyStoreState, started by package/KeyStoreProbe.cpp (UniXNU-gts7xlwifi's, unchanged), which the
reference boards call from their display probe; ruan has none, so load_init_program calls it. Stage 3 status 0 on the page
means the service is published. Without both boot-args the probe returns at once.

--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8258,6 +8258,21 @@
 			boot_progress_stage(line);
 		}
 	}
+	/* ruan: the AppleKeyStore stand-in (package/KeyStoreProbe.cpp, UniXNU component AppleKeyStoreState) for keybagd,
+	 * init_data_protection and usermanagerd on a SEP-less board, before launchd; it starts only with aks=1 and
+	 * offline-key-events=1, as on UniXNU-gts7xlwifi. */
+	{
+		extern void native_keystore_probe(void);
+		extern volatile uint32_t native_keyevents_stage;
+		extern volatile int native_keyevents_status;
+		native_keystore_probe();
+		if (native_keyevents_stage) {
+			char aks_line[64];
+			snprintf(aks_line, sizeof(aks_line), "AppleKeyStore stand-in: stage %u status 0x%x", native_keyevents_stage,
+			    native_keyevents_status);
+			boot_progress_stage(aks_line);
+		}
+	}
 #if CONFIG_MEMORYSTATUS
 	(void) memorystatus_init_at_boot_snapshot();
 #endif /* CONFIG_MEMORYSTATUS */
