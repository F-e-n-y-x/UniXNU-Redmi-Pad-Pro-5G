ruan: NativeSandboxGrantProcess="*" on the driver's NativeAdrenoGpu service too (patches/xnu/ruan-native-sandbox-grant-any.patch
matches "*"). rbu83 showed backboardd/mediaserverd opens of it refused by the sandbox; only the accelerator carried the grant.

--- a/drivers/Adreno740/NativeAdrenoPublish.cpp	2026-11-19 21:35:26.582298295 +0530
+++ b/drivers/Adreno740/NativeAdrenoPublish.cpp	2026-11-19 21:35:26.583330897 +0530
@@ -1425,6 +1425,9 @@
         if(kernel_thread_start(nativeAdrenoHangcheck,nullptr,&thread)==KERN_SUCCESS)thread_deallocate(thread);
     }
     service->setName("NativeAdrenoGpu");
+    /* ruan: the same sandbox grant as the accelerator (LegacyDisplayProbe.cpp): opens of this service were refused by the
+     * original profiles (rbu83: backboardd, mediaserverd "deny iokit-open-user-client RuanAdrenoDeviceUserClient"). */
+    service->setProperty("NativeSandboxGrantProcess","*");
     service->registerService();
     return kIOReturnSuccess;
 }
