diff -ru a/drivers/Adreno740/NativeAdrenoPublish.cpp b/drivers/Adreno740/NativeAdrenoPublish.cpp
--- a/drivers/Adreno740/NativeAdrenoPublish.cpp	2026-11-21 11:40:31.927599078 +0530
+++ b/drivers/Adreno740/NativeAdrenoPublish.cpp	2026-11-21 11:40:43.681756999 +0530
@@ -644,7 +644,9 @@
     View *v=viewSlot(type);
     if(v && v->descriptor && v->token==type) {
         v->descriptor->retain();*memory=v->descriptor;
-        *options=kIOMapAnywhere|(OSDynamicCast(NativeAdrenoPoolView,v->descriptor)?kIOMapWriteCombineCache:kIOMapInhibitCache);
+        /* ruan: the same cache mode as the first map: system BOs cached, pool and span views write-combined (see below). */
+        NativeAdrenoMemory *again=live_?core_->memoryForToken(type):nullptr;
+        *options=kIOMapAnywhere|(again && again->system() && again->descriptor()==v->descriptor?0:kIOMapWriteCombineCache);
         native_adreno_view_diag[2]=native_adreno_view_diag[2]+1;
         IOLockUnlock(g.lock);
         return kIOReturnSuccess;
@@ -706,7 +708,11 @@
                         status=kIOReturnNoResources;
                     } else {
                         *memory=descriptor;
-                        *options=kIOMapAnywhere|kIOMapInhibitCache;
+                        /* ruan: write-combined (Normal non-cacheable), not kIOMapInhibitCache (Device): Turnip writes command
+                         * streams with unaligned 8/16-byte stores, which fault on Device memory (SIGBUS, ESR DFSC 0x21 alignment:
+                         * str d0 / stur q0 in libvulkan_freedreno, rbu144p-rbu158p), and Device writes are not gathered. The GPU's
+                         * PTEs stay non-cacheable, so CPU and GPU still agree without cache maintenance. */
+                        *options=kIOMapAnywhere|kIOMapWriteCombineCache;
                         native_adreno_view_diag[1]=native_adreno_view_diag[1]+1;
                         status=kIOReturnSuccess;
                     }
