@@ -0,0 +1,365 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef DARWIN_BOOT_USB_RAMDISK_H
+#define DARWIN_BOOT_USB_RAMDISK_H
+
+// A RAM disk too big for the payload volume, sent by the host over USB once the window is placed.
+//
+// The entry's initrd is then a 32-byte descriptor instead of the image: "DBUSBRD1", version 1 (UINT32), the CRC32 of
+// the image (UINT32), its size (UINT64: whole 4 KiB pages, below 4 GiB) and 8 zero bytes. DarwinBoot lays the window
+// out for that size and receives the image straight into the RAM disk's place in it, so there is never a second copy
+// (a root image of a few GiB fits next to the kernel only once).
+//
+// The transport is the fastboot protocol on Qualcomm's EFI_USB_DEVICE_PROTOCOL, the polled peripheral interface the
+// stock ABL fastboot is built on (QcomModulePkg/Include/Protocol/EFIUsbDevice.h). The host runs:
+//   fastboot getvar product   unixnu-ramdisk
+//   fastboot stage IMAGE      download:<size>, the bytes; OKAY when the CRC32 matches the descriptor
+//   fastboot continue         the boot goes on
+//   fastboot get_staged FILE  upload: the 2 MiB at USBRD_LOG_BASE, read only (ruan: the stock ramoops region, where Android's
+//                             and a ruan-ramoops=1 XNU's last log survive a warm reset; the platform's memory map must
+//                             describe it, ruanPkg MemoryMapLib "RAM Oops")
+// No command writes storage: "reboot" resets, every other command is refused. Without the protocol, or when no host
+// sends the image in time, Boot() fails and the firmware is kept.
+
+#define USBRD_EP_OUT         0x01
+#define USBRD_EP_IN          0x81
+#define USBRD_CHUNK          SIZE_1MB
+#define USBRD_COMMAND_BYTES  511
+#define USBRD_IDLE_US        100
+#define USBRD_HOST_WAIT_US   (600ULL * 1000000)  // for the host to connect and finish, between commands
+#define USBRD_DATA_WAIT_US   (20ULL * 1000000)   // without a byte during a download
+#define USBRD_LOG_BASE       0x80D00000ULL       // ruan: reserved-memory ramoops@80D00000 of the stock device tree
+#define USBRD_LOG_SIZE       SIZE_2MB
+
+typedef struct {
+  CHAR8   Magic[8];
+  UINT32  Version;
+  UINT32  Crc32;
+  UINT64  Size;
+  UINT64  Reserved;
+} DARWIN_USB_RAMDISK;
+
+// Qualcomm EFI_USB_DEVICE_PROTOCOL, as the open-source ABL publishes it.
+#define QCOM_USB_DEVICE_PROTOCOL_GUID \
+  { 0xd9d9ce48, 0x44b8, 0x4f49, { 0x8e, 0x3e, 0x2a, 0x3b, 0x92, 0x7d, 0xc6, 0xc1 } }
+#define QCOM_USB_INIT_EVENT_GUID \
+  { 0x1c0cffce, 0xfc8d, 0x4e44, { 0x8c, 0x78, 0x9c, 0x9e, 0x5b, 0x53, 0x0d, 0x36 } }
+
+enum { UsbRdEventNone, UsbRdEventState, UsbRdEventTransfer };
+enum { UsbRdTransferActive, UsbRdTransferOk };
+enum { UsbRdStateConnected };
+
+typedef union {
+  UINT32  DeviceState;
+  struct {
+    UINT32  Status;
+    UINT8   Endpoint;
+    UINTN   Bytes;
+    VOID    *Buffer;
+  } Transfer;
+  UINT64  Raw[8];
+} USBRD_EVENT_DATA;
+
+typedef struct {
+  CONST VOID  *DeviceDescriptor;
+  CONST VOID  **Descriptors;
+  CONST VOID  *SsDeviceDescriptor;
+  CONST VOID  **SsDescriptors;
+  CONST VOID  *Qualifier;
+  CONST VOID  *Bos;
+  UINT8       StringCount;
+  CONST VOID  **Strings;
+} USBRD_DESCRIPTOR_SET;
+
+typedef struct {
+  UINT64      Revision;
+  VOID        *Start;
+  EFI_STATUS  (EFIAPI *Send)(UINT8 Endpoint, UINTN Size, VOID *Buffer);
+  EFI_STATUS  (EFIAPI *HandleEvent)(UINT32 *Event, UINTN *Size, USBRD_EVENT_DATA *Data);
+  EFI_STATUS  (EFIAPI *AllocateTransferBuffer)(UINTN Size, VOID **Buffer);
+  EFI_STATUS  (EFIAPI *FreeTransferBuffer)(VOID *Buffer);
+  EFI_STATUS  (EFIAPI *Stop)(VOID);
+  EFI_STATUS  (EFIAPI *AbortXfer)(UINT8 Endpoint);
+  EFI_STATUS  (EFIAPI *SetEndpointStallState)(UINT8 Endpoint, BOOLEAN Stall);
+  EFI_STATUS  (EFIAPI *StartEx)(USBRD_DESCRIPTOR_SET *Set);
+} USBRD_PROTOCOL;
+
+// A fastboot device (Google's IDs, interface ff/42/03), as the stock fastboot tool looks for it; super and high speed.
+STATIC CONST UINT8 mUsbRdDevice[18] = { 18, 1, 0x10, 0x02, 0, 0, 0, 64, 0xd1, 0x18, 0x0d, 0xd0, 0x00, 0x01, 1, 2, 3, 1 };
+STATIC CONST UINT8 mUsbRdSsDevice[18] = { 18, 1, 0x00, 0x03, 0, 0, 0, 9, 0xd1, 0x18, 0x0d, 0xd0, 0x00, 0x01, 1, 2, 3, 1 };
+STATIC CONST UINT8 mUsbRdConfig[32] = {
+  9, 2, 32, 0, 1, 1, 0, 0x80, 0x50,
+  9, 4, 0, 0, 2, 0xff, 0x42, 0x03, 4,
+  7, 5, USBRD_EP_IN, 2, 0x00, 0x02, 0,
+  7, 5, USBRD_EP_OUT, 2, 0x00, 0x02, 0,
+};
+STATIC CONST UINT8 mUsbRdSsConfig[44] = {
+  9, 2, 44, 0, 1, 1, 0, 0x80, 0x10,
+  9, 4, 0, 0, 2, 0xff, 0x42, 0x03, 4,
+  7, 5, USBRD_EP_IN, 2, 0x00, 0x04, 0, 6, 0x30, 4, 0, 0, 0,
+  7, 5, USBRD_EP_OUT, 2, 0x00, 0x04, 0, 6, 0x30, 4, 0, 0, 0,
+};
+STATIC CONST UINT8 mUsbRdQualifier[10] = { 10, 6, 0x00, 0x02, 0xff, 0xff, 0xff, 64, 1, 0 };
+STATIC CONST UINT8 mUsbRdBos[42] = {
+  5, 0x0f, 42, 0, 3,
+  7, 0x10, 0x02, 0x06, 0, 0, 0,
+  10, 0x10, 0x03, 0x00, 0x0e, 0x00, 0x01, 0x07, 0x65, 0x00,
+  20, 0x10, 0x0a, 0x00, 0x01, 0, 0, 0, 0x00, 0x11, 0, 0, 0x30, 0x40, 0x0a, 0x00, 0xb0, 0x40, 0x0a, 0x00,
+};
+STATIC CONST UINT8 mUsbRdLang[4] = { 4, 3, 0x09, 0x04 };
+STATIC CONST UINT8 mUsbRdMaker[14] = { 14, 3, 'U', 0, 'n', 0, 'i', 0, 'X', 0, 'N', 0, 'U', 0 };
+STATIC CONST UINT8 mUsbRdProduct[30] = { 30, 3, 'u', 0, 'n', 0, 'i', 0, 'x', 0, 'n', 0, 'u', 0, '-', 0, 'r', 0, 'a', 0,
+                                         'm', 0, 'd', 0, 'i', 0, 's', 0, 'k', 0 };
+STATIC CONST UINT8 mUsbRdIface[18] = { 18, 3, 'f', 0, 'a', 0, 's', 0, 't', 0, 'b', 0, 'o', 0, 'o', 0, 't', 0 };
+
+typedef struct {
+  USBRD_PROTOCOL  *Usb;
+  UINT8           *Rx;
+  UINT8           *Tx;
+  BOOLEAN         Connected;
+} USBRD;
+
+STATIC VOID DiagDraw (CONST CHAR16 *Text, UINTN Row);
+
+// 1 for a well-formed descriptor, 0 for anything that is not one, -1 for a descriptor that is malformed.
+STATIC
+INTN
+UsbRamdiskDescriptor (CONST VOID *Input, UINTN InputSize, UINT64 *Size, UINT32 *Crc)
+{
+  DARWIN_USB_RAMDISK  Descriptor;
+
+  if ((Input == NULL) || (InputSize < 8) || (CompareMem (Input, "DBUSBRD1", 8) != 0)) { return 0; }
+  if (InputSize != sizeof (Descriptor)) { return -1; }
+  CopyMem (&Descriptor, Input, sizeof (Descriptor));
+  if ((Descriptor.Version != 1) || (Descriptor.Reserved != 0) || (Descriptor.Size == 0) ||
+      (Descriptor.Size & (EFI_PAGE_SIZE - 1)) || (Descriptor.Size > 0xFFFFF000ULL)) { return -1; }
+  *Size = Descriptor.Size;
+  *Crc = Descriptor.Crc32;
+  return 1;
+}
+
+// Pump the controller's events until the transfer on Endpoint ends; *Bytes is its byte count. EFI_ABORTED: the cable
+// state changed (Rd->Connected says to what). EFI_TIMEOUT: no event for Limit microseconds (the transfer is aborted).
+STATIC
+EFI_STATUS
+UsbRdWait (USBRD *Rd, UINT8 Endpoint, UINT64 Limit, UINT64 *Bytes)
+{
+  UINT32            Event;
+  UINTN             Size;
+  USBRD_EVENT_DATA  Data;
+  UINT64            Idle;
+
+  for (Idle = 0; ; ) {
+    Event = UsbRdEventNone;
+    Size = 0;
+    ZeroMem (&Data, sizeof (Data));
+    Rd->Usb->HandleEvent (&Event, &Size, &Data);
+    if (Event == UsbRdEventState) {
+      Rd->Connected = (Data.DeviceState == UsbRdStateConnected);
+      return EFI_ABORTED;
+    }
+    if ((Event == UsbRdEventTransfer) && (Data.Transfer.Endpoint == Endpoint)) {
+      *Bytes = Data.Transfer.Bytes;
+      return (Data.Transfer.Status == UsbRdTransferOk) ? EFI_SUCCESS : EFI_DEVICE_ERROR;
+    }
+    if (Event != UsbRdEventNone) { Idle = 0; continue; }
+    if (Idle >= Limit) {
+      if (Endpoint != 0) { Rd->Usb->AbortXfer (Endpoint); }
+      return EFI_TIMEOUT;
+    }
+    gBS->Stall (USBRD_IDLE_US);
+    Idle += USBRD_IDLE_US;
+  }
+}
+
+STATIC
+EFI_STATUS
+UsbRdSend (USBRD *Rd, CONST CHAR8 *Code, CONST CHAR8 *Text)
+{
+  UINTN       Length;
+  UINT64      Bytes;
+  EFI_STATUS  Status;
+
+  Length = AsciiSPrint ((CHAR8 *)Rd->Tx, 64, "%a%a", Code, Text);
+  Status = Rd->Usb->Send (USBRD_EP_IN, Length, Rd->Tx);
+  return EFI_ERROR (Status) ? Status : UsbRdWait (Rd, USBRD_EP_IN, USBRD_DATA_WAIT_US, &Bytes);
+}
+
+// The image, Size bytes, from "download:" into Destination. TRUE when every byte came and the CRC32 matches.
+STATIC
+BOOLEAN
+UsbRdDownload (USBRD *Rd, UINT8 *Destination, UINT64 Size, UINT32 Crc)
+{
+  CHAR8       Reply[16];
+  CHAR16      Line[96];
+  UINT64      Got;
+  UINT64      Want;
+  UINT64      Bytes;
+  UINT32      Actual;
+  EFI_STATUS  Status;
+
+  AsciiSPrint (Reply, sizeof (Reply), "%08x", (UINT32)Size);
+  if (EFI_ERROR (UsbRdSend (Rd, "DATA", Reply))) { return FALSE; }
+  for (Got = 0; Got < Size; Got += Bytes) {
+    Want = MIN (Size - Got, USBRD_CHUNK);
+    Status = Rd->Usb->Send (USBRD_EP_OUT, (UINTN)Want, Rd->Rx);
+    if (!EFI_ERROR (Status)) { Status = UsbRdWait (Rd, USBRD_EP_OUT, USBRD_DATA_WAIT_US, &Bytes); }
+    if (EFI_ERROR (Status) || (Bytes == 0)) { break; }
+    Bytes = MIN (Bytes, Want);  // a controller that reports more than was asked for must not carry the copy past the end
+    CopyMem (Destination + Got, Rd->Rx, (UINTN)Bytes);
+    if (((Got + Bytes) >> 26) != (Got >> 26)) {
+      UnicodeSPrint (Line, sizeof (Line), L"USB RAMDISK %lu / %lu MiB", (Got + Bytes) >> 20, Size >> 20);
+      DiagDraw (Line, 1);
+    }
+  }
+  if (Got != Size) {
+    UsbRdSend (Rd, "FAIL", "short download");
+    return FALSE;
+  }
+  Actual = 0;
+  gBS->CalculateCrc32 (Destination, (UINTN)Size, &Actual);
+  if (Actual != Crc) {
+    UnicodeSPrint (Line, sizeof (Line), L"USB RAMDISK CRC %08x, WANT %08x", Actual, Crc);
+    DiagDraw (Line, 1);
+    UsbRdSend (Rd, "FAIL", "crc32 mismatch");
+    return FALSE;
+  }
+  UnicodeSPrint (Line, sizeof (Line), L"USB RAMDISK %lu MiB CRC OK", Size >> 20);
+  DiagDraw (Line, 1);
+  return !EFI_ERROR (UsbRdSend (Rd, "OKAY", ""));
+}
+
+// "upload": DATA<size>, the log region in USBRD_CHUNK pieces (through the transfer buffer: the controller sends from
+// memory it owns), then OKAY. FALSE when the host went away.
+STATIC
+BOOLEAN
+UsbRdUpload (USBRD *Rd)
+{
+  CHAR8       Reply[16];
+  UINT64      Sent;
+  UINT64      Want;
+  UINT64      Bytes;
+  EFI_STATUS  Status;
+
+  AsciiSPrint (Reply, sizeof (Reply), "%08x", (UINT32)USBRD_LOG_SIZE);
+  if (EFI_ERROR (UsbRdSend (Rd, "DATA", Reply))) { return FALSE; }
+  for (Sent = 0; Sent < USBRD_LOG_SIZE; Sent += Want) {
+    Want = MIN (USBRD_LOG_SIZE - Sent, USBRD_CHUNK);
+    CopyMem (Rd->Rx, (CONST VOID *)(UINTN)(USBRD_LOG_BASE + Sent), (UINTN)Want);
+    Status = Rd->Usb->Send (USBRD_EP_IN, (UINTN)Want, Rd->Rx);
+    if (!EFI_ERROR (Status)) { Status = UsbRdWait (Rd, USBRD_EP_IN, USBRD_DATA_WAIT_US, &Bytes); }
+    if (EFI_ERROR (Status)) { return FALSE; }
+  }
+  DiagDraw (L"USB RAMDISK: LOG REGION SENT, 2 MiB", 2);
+  return !EFI_ERROR (UsbRdSend (Rd, "OKAY", ""));
+}
+
+// Serve fastboot commands until the image is in Destination and the host said "continue".
+STATIC
+EFI_STATUS
+UsbRdServe (USBRD *Rd, UINT8 *Destination, UINT64 Size, UINT32 Crc)
+{
+  CHAR8       Command[USBRD_COMMAND_BYTES + 1];
+  CHAR8       Value[24];
+  UINT64      Bytes;
+  BOOLEAN     Received;
+  EFI_STATUS  Status;
+
+  Received = FALSE;
+  for (;;) {
+    if (!Rd->Connected) {
+      if (UsbRdWait (Rd, 0, USBRD_HOST_WAIT_US, &Bytes) == EFI_TIMEOUT) { break; }
+      continue;
+    }
+    Status = Rd->Usb->Send (USBRD_EP_OUT, USBRD_COMMAND_BYTES, Rd->Rx);
+    if (EFI_ERROR (Status)) { return Status; }
+    Status = UsbRdWait (Rd, USBRD_EP_OUT, USBRD_HOST_WAIT_US, &Bytes);
+    if (Status == EFI_TIMEOUT) { break; }
+    if (EFI_ERROR (Status) || (Bytes == 0)) { continue; }
+    Bytes = MIN (Bytes, USBRD_COMMAND_BYTES);
+    CopyMem (Command, Rd->Rx, (UINTN)Bytes);
+    Command[Bytes] = 0;
+    if (AsciiStrCmp (Command, "getvar:product") == 0) {
+      UsbRdSend (Rd, "OKAY", "unixnu-ramdisk");
+    } else if (AsciiStrCmp (Command, "getvar:max-download-size") == 0) {
+      AsciiSPrint (Value, sizeof (Value), "0x%08x", (UINT32)Size);
+      UsbRdSend (Rd, "OKAY", Value);
+    } else if (AsciiStrnCmp (Command, "download:", 9) == 0) {
+      if ((AsciiStrLen (Command) != 17) || (AsciiStrHexToUint64 (Command + 9) != Size)) {
+        UsbRdSend (Rd, "FAIL", "size differs from the descriptor");
+      } else {
+        Received = UsbRdDownload (Rd, Destination, Size, Crc);
+      }
+    } else if (AsciiStrCmp (Command, "upload") == 0) {
+      UsbRdUpload (Rd);
+    } else if (AsciiStrCmp (Command, "continue") == 0) {
+      if (Received) {
+        UsbRdSend (Rd, "OKAY", "");
+        return EFI_SUCCESS;
+      }
+      UsbRdSend (Rd, "FAIL", "no image yet");
+    } else if (AsciiStrCmp (Command, "reboot") == 0) {
+      UsbRdSend (Rd, "OKAY", "");
+      gST->RuntimeServices->ResetSystem (EfiResetCold, EFI_SUCCESS, 0, NULL);
+    } else {
+      UsbRdSend (Rd, "FAIL", "unsupported");
+    }
+  }
+  DiagDraw (L"USB RAMDISK: NO HOST, FIRMWARE KEPT", 1);
+  return EFI_TIMEOUT;
+}
+
+// Receive the image into Destination (Size bytes, CRC32 Crc) over USB. The controller is stopped on return.
+STATIC
+EFI_STATUS
+UsbRamdiskReceive (VOID *Destination, UINT64 Size, UINT32 Crc)
+{
+  STATIC CONST EFI_GUID  UsbGuid = QCOM_USB_DEVICE_PROTOCOL_GUID;
+  STATIC CONST EFI_GUID  InitGuid = QCOM_USB_INIT_EVENT_GUID;
+  STATIC CONST VOID      *Config[1] = { mUsbRdConfig };
+  STATIC CONST VOID      *SsConfig[1] = { mUsbRdSsConfig };
+  STATIC CONST VOID      *Strings[5] = { mUsbRdLang, mUsbRdMaker, mUsbRdProduct, mUsbRdProduct, mUsbRdIface };
+  USBRD_DESCRIPTOR_SET   Set;
+  USBRD                  Rd;
+  EFI_EVENT              Event;
+  EFI_STATUS             Status;
+
+  ZeroMem (&Rd, sizeof (Rd));
+  // Ask the platform for the controller in peripheral mode, as the stock fastboot does.
+  if (!EFI_ERROR (gBS->CreateEventEx (EVT_NOTIFY_SIGNAL, TPL_CALLBACK, EfiEventEmptyFunction, NULL, &InitGuid, &Event))) {
+    gBS->SignalEvent (Event);
+    gBS->CloseEvent (Event);
+  }
+  Status = gBS->LocateProtocol ((EFI_GUID *)&UsbGuid, NULL, (VOID **)&Rd.Usb);
+  if (EFI_ERROR (Status)) {
+    DiagDraw (L"USB RAMDISK: NO USB DEVICE PROTOCOL", 1);
+    return Status;
+  }
+  ZeroMem (&Set, sizeof (Set));
+  Set.DeviceDescriptor = mUsbRdDevice;
+  Set.Descriptors = Config;
+  Set.SsDeviceDescriptor = mUsbRdSsDevice;
+  Set.SsDescriptors = SsConfig;
+  Set.Qualifier = mUsbRdQualifier;
+  Set.Bos = mUsbRdBos;
+  Set.StringCount = 5;
+  Set.Strings = Strings;
+  Status = Rd.Usb->StartEx (&Set);
+  if (EFI_ERROR (Status)) {
+    DiagDraw (L"USB RAMDISK: USB START FAILED", 1);
+    return Status;
+  }
+  Status = Rd.Usb->AllocateTransferBuffer (USBRD_CHUNK, (VOID **)&Rd.Rx);
+  if (!EFI_ERROR (Status)) { Status = Rd.Usb->AllocateTransferBuffer (64, (VOID **)&Rd.Tx); }
+  if (!EFI_ERROR (Status)) {
+    // The firmware's boot-option watchdog (five minutes) must not reset the device during a long upload.
+    gBS->SetWatchdogTimer (0, 0, 0, NULL);
+    DiagDraw (L"USB RAMDISK: WAITING FOR fastboot stage", 1);
+    Status = UsbRdServe (&Rd, Destination, Size, Crc);
+  }
+  if (Rd.Rx != NULL) { Rd.Usb->FreeTransferBuffer (Rd.Rx); }
+  if (Rd.Tx != NULL) { Rd.Usb->FreeTransferBuffer (Rd.Tx); }
+  Rd.Usb->Stop ();
+  return Status;
+}
+
+#endif
diff --git a/Test/test-usb-ramdisk.py b/Test/test-usb-ramdisk.py
new file mode 100644
index 0000000..aae5440
--- /dev/null
+++ b/Test/test-usb-ramdisk.py
@@ -0,0 +1,205 @@
+#!/usr/bin/env python3
+"""Run the actual USB RAM disk receiver (UsbRamdisk.h) against a scripted fastboot host on a fake controller."""
+import ctypes
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+import zlib
+
+header = Path(__file__).resolve().parents[1] / 'DarwinBootPkg/Driver/UsbRamdisk.h'
+HARNESS = r'''
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdarg.h>
+#include <string.h>
+#include <stdlib.h>
+typedef uint8_t UINT8; typedef uint16_t CHAR16; typedef uint32_t UINT32; typedef uint64_t UINT64;
+typedef size_t UINTN; typedef long INTN; typedef int BOOLEAN; typedef char CHAR8; typedef UINTN EFI_STATUS;
+typedef void *EFI_EVENT; typedef struct { UINT32 a; uint16_t b, c; UINT8 d[8]; } EFI_GUID;
+#define STATIC static
+#define CONST const
+#define VOID void
+#define EFIAPI
+#define TRUE 1
+#define FALSE 0
+#define SIZE_1MB 0x100000
+#define EFI_PAGE_SIZE 4096
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define EFI_SUCCESS 0
+#define EFI_ERR(n) ((EFI_STATUS)1 << 63 | (n))
+#define EFI_ERROR(s) ((INTN)(s) < 0)
+#define EFI_NOT_FOUND EFI_ERR(14)
+#define EFI_TIMEOUT EFI_ERR(18)
+#define EFI_ABORTED EFI_ERR(21)
+#define EFI_DEVICE_ERROR EFI_ERR(7)
+#define EVT_NOTIFY_SIGNAL 0x200
+#define TPL_CALLBACK 8
+#define EfiResetCold 0
+#define CompareMem memcmp
+#define CopyMem memcpy
+#define ZeroMem(p, n) memset(p, 0, n)
+#define AsciiStrCmp strcmp
+#define AsciiStrnCmp strncmp
+#define AsciiStrLen strlen
+static UINT64 AsciiStrHexToUint64(const char *s) { return strtoull(s, NULL, 16); }
+static void EfiEventEmptyFunction(EFI_EVENT e, void *c) { (void)e; (void)c; }
+static UINTN AsciiSPrint(CHAR8 *out, UINTN n, const CHAR8 *format, ...) {
+  char f[64]; size_t j = 0; va_list ap;
+  for (size_t i = 0; format[i] && j < sizeof(f) - 2; i++) {      /* %a is EDK2's ASCII string */
+    f[j++] = format[i];
+    if (format[i] == '%' && format[i + 1] == 'a') { f[j++] = 's'; i++; }
+  }
+  f[j] = 0; va_start(ap, format); int r = vsnprintf(out, n, f, ap); va_end(ap); return (UINTN)r;
+}
+static UINTN UnicodeSPrint(CHAR16 *out, UINTN n, const CHAR16 *format, ...) { (void)format; if (n) out[0] = 0; return 0; }
+static uint32_t crc32(const uint8_t *p, size_t n) {
+  uint32_t c = 0xffffffffu;
+  for (size_t i = 0; i < n; i++) { c ^= p[i]; for (int k = 0; k < 8; k++) c = c >> 1 ^ (0xedb88320u & -(c & 1)); }
+  return ~c;
+}
+/* the boot services the receiver calls; the clock only moves when it stalls */
+static UINT64 now_us; static int resets, stops, watchdog_off;
+static void *usb_protocol;
+struct bs {
+  void (*Stall)(UINTN);
+  EFI_STATUS (*CalculateCrc32)(void *, UINTN, UINT32 *);
+  EFI_STATUS (*CreateEventEx)(UINT32, UINTN, void (*)(EFI_EVENT, void *), void *, const EFI_GUID *, EFI_EVENT *);
+  EFI_STATUS (*SignalEvent)(EFI_EVENT);
+  EFI_STATUS (*CloseEvent)(EFI_EVENT);
+  EFI_STATUS (*LocateProtocol)(EFI_GUID *, void *, void **);
+  EFI_STATUS (*SetWatchdogTimer)(UINTN, UINT64, UINTN, CHAR16 *);
+};
+static void stall(UINTN us) { now_us += us; }
+static EFI_STATUS crc(void *p, UINTN n, UINT32 *out) { *out = crc32(p, n); return 0; }
+static EFI_STATUS create(UINT32 t, UINTN l, void (*f)(EFI_EVENT, void *), void *c, const EFI_GUID *g, EFI_EVENT *e) {
+  (void)t; (void)l; (void)f; (void)c; (void)g; *e = (EFI_EVENT)1; return 0; }
+static EFI_STATUS signal_close(EFI_EVENT e) { (void)e; return 0; }
+static EFI_STATUS locate(EFI_GUID *g, void *r, void **out) {
+  (void)r; if (!usb_protocol || g->a != 0xd9d9ce48) return EFI_NOT_FOUND; *out = usb_protocol; return 0; }
+static EFI_STATUS watchdog(UINTN t, UINT64 c, UINTN n, CHAR16 *d) { (void)c; (void)n; (void)d; watchdog_off = t == 0; return 0; }
+static struct bs boot_services = { stall, crc, create, signal_close, signal_close, locate, watchdog };
+static struct bs *gBS = &boot_services;
+struct rt { void (*ResetSystem)(int, EFI_STATUS, UINTN, void *); };
+static void reset(int k, EFI_STATUS s, UINTN n, void *d) { (void)k; (void)s; (void)n; (void)d; resets++; }
+static struct rt runtime = { reset };
+static struct { struct rt *RuntimeServices; } system_table = { &runtime }, *gST = &system_table;
+static void DiagDraw(const CHAR16 *t, UINTN row) { (void)t; (void)row; }
+#include "UsbRamdisk.h"
+
+/* The fake controller: host packets go to OUT receives in order (a long one is a stream, taken in pieces), every IN
+   send is a reply the host reads. Completions come back one per HandleEvent, after the first "connected". */
+static const uint8_t *host; static size_t host_len, host_at;
+static char replies[8192]; static size_t replies_len;
+static int connected_sent; static struct { int pending; UINT8 ep; UINTN bytes; } done;
+static EFI_STATUS u_send(UINT8 ep, UINTN size, void *buf) {
+  if (done.pending) return EFI_DEVICE_ERROR;               /* one transfer at a time, as the receiver uses it */
+  if (ep == USBRD_EP_IN) {
+    replies_len += (size_t)snprintf(replies + replies_len, sizeof(replies) - replies_len, "%.*s|", (int)size, (char *)buf);
+    done.pending = 1; done.ep = ep; done.bytes = size; return 0;
+  }
+  if (host_at + 4 > host_len) return 0;                    /* nothing more from the host: the receive never ends */
+  uint32_t n; memcpy(&n, host + host_at, 4);
+  uint32_t take = n < size ? n : (uint32_t)size;
+  memcpy(buf, host + host_at + 4, take);
+  if (take == n) host_at += 4 + n;
+  else { host_at += take; n -= take; memcpy((uint8_t *)host + host_at, &n, 4); } /* the rest stays queued */
+  done.pending = 1; done.ep = ep; done.bytes = take; return 0;
+}
+static EFI_STATUS u_event(UINT32 *ev, UINTN *size, USBRD_EVENT_DATA *d) {
+  (void)size;
+  if (!connected_sent) { connected_sent = 1; *ev = UsbRdEventState; d->DeviceState = UsbRdStateConnected; return 0; }
+  if (done.pending) {
+    done.pending = 0; *ev = UsbRdEventTransfer;
+    d->Transfer.Status = UsbRdTransferOk; d->Transfer.Endpoint = done.ep; d->Transfer.Bytes = done.bytes; return 0;
+  }
+  *ev = UsbRdEventNone; return 0;
+}
+static EFI_STATUS u_alloc(UINTN n, void **b) { *b = malloc(n); return *b ? 0 : EFI_DEVICE_ERROR; }
+static EFI_STATUS u_free(void *b) { free(b); return 0; }
+static EFI_STATUS u_stop(void) { stops++; return 0; }
+static EFI_STATUS u_abort(UINT8 ep) { (void)ep; done.pending = 0; return 0; }
+static EFI_STATUS u_start(USBRD_DESCRIPTOR_SET *s) { return s->StringCount == 5 && s->Descriptors[0] == mUsbRdConfig ? 0 : EFI_DEVICE_ERROR; }
+static USBRD_PROTOCOL fake = { 0, 0, u_send, u_event, u_alloc, u_free, u_stop, u_abort, 0, u_start };
+
+long descriptor(const void *p, size_t n, UINT64 *size, UINT32 *crc) { return UsbRamdiskDescriptor(p, n, size, crc); }
+long receive(uint8_t *script, size_t len, int with_usb, uint8_t *dest, UINT64 size, UINT32 want, char *out, size_t cap) {
+  host = script; host_len = len; host_at = 0; replies_len = 0; replies[0] = 0; connected_sent = 0; done.pending = 0;
+  stops = resets = watchdog_off = 0; now_us = 0; usb_protocol = with_usb ? &fake : NULL;
+  EFI_STATUS s = UsbRamdiskReceive(dest, size, want);
+  snprintf(out, cap, "%s#stops=%d#watchdog_off=%d#resets=%d", replies, stops, watchdog_off, resets);
+  return s == 0 ? 0 : (long)(s & 0xff);
+}
+'''
+
+
+def packets(*items):
+    return b''.join(struct.pack('<I', len(item)) + item for item in items)
+
+
+with tempfile.TemporaryDirectory(prefix='darwinboot-usb-') as temporary:
+    work = Path(temporary)
+    (work / 'test.c').write_text(HARNESS)
+    library = work / 'usb.so'
+    subprocess.run(['clang', '-Wall', '-Wextra', '-Werror', '-Wno-unused-function', '-fshort-wchar', '-shared', '-fPIC',
+                    '-I', str(header.parent), str(work / 'test.c'), '-o', str(library)], check=True)
+    lib = ctypes.CDLL(str(library))
+    lib.descriptor.restype = ctypes.c_long
+    lib.descriptor.argtypes = [ctypes.c_char_p, ctypes.c_size_t, ctypes.POINTER(ctypes.c_uint64), ctypes.POINTER(ctypes.c_uint32)]
+    lib.receive.restype = ctypes.c_long
+    lib.receive.argtypes = [ctypes.c_char_p, ctypes.c_size_t, ctypes.c_int, ctypes.c_void_p, ctypes.c_uint64,
+                            ctypes.c_uint32, ctypes.c_char_p, ctypes.c_size_t]
+
+    def describe(blob):
+        size, crc = ctypes.c_uint64(), ctypes.c_uint32()
+        return lib.descriptor(blob, len(blob), ctypes.byref(size), ctypes.byref(crc)), size.value, crc.value
+
+    image = bytes((i * 7 + (i >> 12)) & 0xff for i in range(3 * 1024 * 1024 + 8192))
+    crc = zlib.crc32(image)
+    good = struct.pack('<8sIIQQ', b'DBUSBRD1', 1, crc, len(image), 0)
+    assert describe(good) == (1, len(image), crc)
+    assert describe(b'DBRDISK1' + bytes(24))[0] == 0
+    assert describe(b'not one')[0] == 0
+    assert describe(struct.pack('<8sIIQQ', b'DBUSBRD1', 2, crc, len(image), 0))[0] == -1
+    assert describe(struct.pack('<8sIIQQ', b'DBUSBRD1', 1, crc, len(image) + 1, 0))[0] == -1
+    assert describe(struct.pack('<8sIIQQ', b'DBUSBRD1', 1, crc, 1 << 32, 0))[0] == -1
+    assert describe(good + b'\0')[0] == -1
+
+    def run(script, image_size=len(image), want=crc, with_usb=1):
+        dest = ctypes.create_string_buffer(image_size)
+        out = ctypes.create_string_buffer(8192)
+        status = lib.receive(script, len(script), with_usb, dest, image_size, want, out, len(out))
+        return status, dest.raw, out.value.decode()
+
+    # fastboot getvar, stage (the image in uneven bulk packets, one longer than a receive), continue
+    pieces = [image[:5000], image[5000:5000 + 1536 * 1024], image[5000 + 1536 * 1024:]]
+    script = packets(b'getvar:product', b'getvar:max-download-size', b'download:%08x' % len(image), *pieces, b'continue')
+    status, dest, out = run(script)
+    assert status == 0 and dest == image, out
+    assert out == ('OKAYunixnu-ramdisk|OKAY0x%08x|DATA%08x|OKAY|OKAY|#stops=1#watchdog_off=1#resets=0'
+                   % (len(image), len(image))), out
+
+    # a wrong size and a premature continue are refused; with no more from the host the wait ends, the firmware stays
+    status, _, out = run(packets(b'download:00001000', b'continue', b'flash:boot', b'erase:userdata'))
+    assert status == 18 and out.startswith('FAILsize differs from the descriptor|FAILno image yet|FAILunsupported|FAILunsupported|'), out
+    assert '#stops=1' in out
+
+    # a corrupted byte: the CRC32 refuses the image and "continue" still finds none
+    bad = bytearray(image)
+    bad[12345] ^= 1
+    status, _, out = run(packets(b'download:%08x' % len(image), bytes(bad), b'continue'))
+    assert status == 18 and out.startswith('DATA%08x|FAILcrc32 mismatch|FAILno image yet|' % len(image)), out
+
+    # the host stops half-way: the download gives up after its data wait
+    status, _, out = run(packets(b'download:%08x' % len(image), image[:4096]))
+    assert status == 18 and 'FAILshort download|' in out, out
+
+    # reboot is the only other command that does anything
+    status, _, out = run(packets(b'reboot'))
+    assert '#resets=1' in out, out
+
+    # no USB device protocol: refused before anything is touched
+    status, _, out = run(b'', with_usb=0)
+    assert status == 14 and '#stops=0' in out, out
+print('usb ramdisk: descriptor and fastboot receiver checks passed')
### submodule drivers/AdrenoMetal
