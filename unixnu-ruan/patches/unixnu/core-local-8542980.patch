++/* ruan (patches/mesa/turnip-darwin-open-report.patch): an open failure as a text line in the driver's report row (USB `gpu`, R), sent as
++ * progress-marker opens (type 0x41477ffe starts the line, 0x410000|0x70cc appends character cc), which the driver counts and refuses and
++ * which need no connection: Metal clients only see VK_ERROR_INITIALIZATION_FAILED. */
++/* ruan (rbu74): first-light flags for every process that loads Turnip on the A710 (system memory rendering, no UBWC, no LRZ), before any
++ * instance reads TU_DEBUG; a process or the plugin's tu-debug= boot argument that set TU_DEBUG keeps its own. */
++__attribute__((constructor)) static void
++dw_default_tu_debug(void)
++{
++   setenv("TU_DEBUG", "sysmem,noubwc,nolrz", 0);
++}
++
++static void
++dw_report(const char *service_name, const char *fmt, ...)
++{
++   io_service_t service = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching(service_name));
++   if (!service)
++      return;
++   char text[64];
++   va_list args;
++   va_start(args, fmt);
++   vsnprintf(text, sizeof(text), fmt, args);
++   va_end(args);
++   io_connect_t c = 0;
++   if (IOServiceOpen(service, mach_task_self(), 0x41477ffeu, &c) == KERN_SUCCESS && c)
++      IOServiceClose(c);
++   for (unsigned i = 0; text[i] && i < 63; ++i) {
++      c = 0;
++      if (IOServiceOpen(service, mach_task_self(), 0x41477000u | (uint8_t)text[i], &c) == KERN_SUCCESS && c)
++         IOServiceClose(c);
++   }
++   IOObjectRelease(service);
++}
++
+ static VkResult
+ dw_open_connection(struct tu_instance *instance)
+ {
+@@ -208,6 +242,8 @@
+ 
+    kern_return_t kr = IOServiceOpen(service, mach_task_self(), open_type, &dw.conn);
+    IOObjectRelease(service);
++   if (kr != KERN_SUCCESS)
++      dw_report(service_name, "TU %.12s open %x: %x", getprogname(), open_type, kr);
+    if (kr != KERN_SUCCESS) {
+       return vk_startup_errorf(instance, VK_ERROR_INITIALIZATION_FAILED,
+                                "IOServiceOpen(%s, 0x%x) failed: 0x%x", service_name, open_type, kr);
+@@ -216,6 +252,7 @@
+    if (dw.tunnel && !dw_probe_selector()) {
+       IOServiceClose(dw.conn);
+       dw.conn = 0;
++      dw_report(service_name, "TU %.12s no selector", getprogname());
+       return vk_startup_errorf(instance, VK_ERROR_INITIALIZATION_FAILED, "no external-method selector is admitted for this process");
+    }
+ 
+@@ -227,6 +264,7 @@
+    if (kr != KERN_SUCCESS) {
+       IOServiceClose(dw.conn);
+       dw.conn = 0;
++      dw_report(service_name, "TU %.12s query %x", getprogname(), kr);
+       return vk_startup_errorf(instance, VK_ERROR_INITIALIZATION_FAILED,
