# ruan first boot: generic ARM64 DT platform and CPU, prelinked crypto, no native storage or GPU yet.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# Stand-in ApplePMGR nub for the unchanged AMFI ("No PMGR?"); sheng-pmgr=2 in board.toml publishes it.
CONFIG_XNU_SHENG_PMGR=y
# CONFIG_XNU_NATIVE_UFS is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_ARMVIRT_PLATFORM is not set
# RAM-root diagnostic hooks of patches/xnu/ruan-ram-root-probe.patch (boot-args ram-root-probe, ram-restore-trust) and the
# boot-progress page of patches/xnu/ruan-boot-progress.patch (package/BootProgress.c, boot-arg boot-progress=1).
# CONFIG_XNU_BOOT_PROGRESS stays unset: build-xnu-4k-baseline.sh accepts it only with NATIVE_UFS + OWNER_ROOT_AUDIT.
# libRuanAdreno.a (scripts/build-ruan-adreno.py): force-loaded, as sheng links libAdreno740.a, so the driver's metaclasses register.
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/ram-root-probe/libRamRootProbe.a -Wl,-force_load,{tree}/build/ruan-adreno/libRuanAdreno.a"
# The OS profile enables mockfs for offline tests; on ruan it mounted md0 as mockfs (raw bytes for every file) ahead of
# APFS, so /sbin/launchd read as the APFS container -> ENOEXEC (RAM_ROOT FAIL stage=4 fs=mockfs, 2026-11-14).
CONFIG_XNU_SOURCE_MOCKFS=n
# The GOP display path (GopFramebuffer NativeLegacyDisplay + package/LegacyDisplayProbe.cpp): bsd_init/bsd_autoconf call
# native_legacy_display_probe()/native_legacy_display_late_probe() (offline-component-load-probes.patch, offline-legacy-start.patch)
# and build-xnu-4k-baseline.sh force-loads build/native-legacy-display/libNativeLegacyDisplay.late.a
# (scripts/build-gop-legacy-display.py, a [kernel] archives step). Same switch as UniXNU-gts7xlwifi / j716f / sirius.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
