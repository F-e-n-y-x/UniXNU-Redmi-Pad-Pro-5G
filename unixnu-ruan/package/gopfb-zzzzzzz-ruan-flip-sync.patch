+    // ruan flip sync (dpu-flip-sync=1; default on with ruan-120hz=1): docs/research/120hz/tearing.md. The flush only marks VIG0's
+    // double-buffered SRC registers to latch at the next frame boundary, so a flip at any line cannot tear the scan by itself; but with
+    // retire at the flip the released frame stays on screen until that latch (up to a whole 1/120 s), and the compositor draws into it.
+    // So: flush only in the last kFlipLead lines of the active area (the latch follows within ~1 ms) and retire at the latch.
+    static constexpr uint32_t kIntf1=0x35000,kFlipLead=256,kFlipGuard=8;   // INTF_1 0xae36000 in the 0xae01000 map; lines
+    const OriginalLegacySwapRequest *syncReady=nullptr;   // GPU already done for this request, waiting only for the window
+    static bool flipSync() {
+        static int on=-1;
+        if(on<0){unsigned v=0,hz120=0;PE_parse_boot_argn("ruan-120hz",&hz120,sizeof hz120);if(!PE_parse_boot_argn("dpu-flip-sync",&v,sizeof v))v=hz120==1;on=v==1;}
+        return on;
+    }
+    // 0: flipped now. Otherwise the microseconds until the window opens (the caller comes back then).
+    uint32_t syncedFlip(uint32_t iova,uint32_t stride) {
+        volatile uint32_t *intf=mdp+kIntf1/4;
+        const uint32_t htotal=intf[0x08/4]>>16,vtotal=htotal?intf[0x0c/4]/htotal:0,vEnd=htotal?intf[0x24/4]/htotal:0;
+        if(!flipSync() || vEnd<=kFlipLead || vEnd>=vtotal){flip(iova,stride);return 0;}   // off, or timing unreadable: as before
+        const boolean_t irq=ml_set_interrupts_enabled(FALSE);
+        const uint32_t line=intf[0xb0/4]&0xffff;
+        const bool open=line+kFlipLead>=vEnd && line+kFlipGuard<=vEnd;
+        if(open)flip(iova,stride);
+        ml_set_interrupts_enabled(irq);
+        if(open)return 0;
+        const uint32_t lines=line>=vtotal?kFlipLead:line+kFlipLead<vEnd?vEnd-kFlipLead-line:vtotal-line+vEnd-kFlipLead;
+        unsigned hz=native_legacy_refresh_hz();if(!hz || hz>240)hz=60;
+        const uint64_t us=uint64_t(lines)*1000000ull/(uint64_t(hz)*vtotal);
+        return us<50?50:uint32_t(us);
+    }
