@@ -363,6 +366,31 @@ IOReturn RuanBacklight::setProperties(OSObject *properties) {
 
 static RuanBacklight *s_backlight = nullptr;
 
+/* From UniXNU-sheng package/AppleARMBacklight.cpp (impersonate): AppleARMPlatform already defines AppleARMBacklight, so this
+ * service keeps its own class and answers that metaclass from getMetaClass (vtable slot 7) through a copied vtable. CoreBrightness
+ * takes the built-in backlight only when IOObjectConformsTo(service, "AppleARMBacklight") holds; publishing backlight-control
+ * without that conformance blocks QuartzCore's libEDR send and stops screen updates (sheng int-236). arm64 (non-ptrauth) only. */
+static const OSMetaClass *gAppleClass = nullptr;
+static const OSMetaClass *appleMetaClass(const OSMetaClassBase *) { return gAppleClass; }
+static bool impersonate(IOService *service) {
+    enum { kSlots = 320, kGetMetaClass = 7 };
+    const OSSymbol *name = OSSymbol::withCString("AppleARMBacklight");
+    gAppleClass = name ? OSMetaClass::getMetaClassWithName(name) : nullptr;
+    OSSafeReleaseNULL(name);
+    if (!gAppleClass) return false;
+#if __has_feature(ptrauth_calls)
+    return false;   /* signed vtables: needs sheng's getMetaClass override instead */
+#else
+    uintptr_t *copy = static_cast<uintptr_t *>(IOMalloc(kSlots * sizeof(uintptr_t)));
+    if (!copy) return false;
+    memcpy(copy, *reinterpret_cast<uintptr_t **>(service), kSlots * sizeof(uintptr_t));
+    copy[kGetMetaClass] = reinterpret_cast<uintptr_t>(&appleMetaClass);
+    __asm__ volatile("dmb ish" ::: "memory");
+    *reinterpret_cast<uintptr_t **>(service) = copy;
+    return true;
+#endif
+}
+
 extern "C" bool ruan_backlight_start(void) {
     if (s_backlight) return true;
 
