+    def test_plain_arm64_format6_fixups(self):
+        # ld -fixup_chains -kernel for arm64 (no PAC): DYLD_CHAINED_PTR_64_OFFSET, never authenticated.
+        base = 0xfffffff007004000
+        segment = struct.pack('<II16sQQQQIIII', 0x19, 72, b'__TEXT', base, 0x8000, 0, 0x8000, 7, 5, 0, 0)
+        commands = [segment, struct.pack('<4I', 0x80000034, 16, 0x6000, 0x100)]
+        raw = bytearray(0x8000)
+        raw[:32 + 88] = struct.pack('<8I', 0xfeedfacf, 0x100000c, 0, 2, 2, 88, 0, 0) + b''.join(commands)
+        struct.pack_into('<7I', raw, 0x6000, 0, 0x20, 0, 0, 0, 0, 0)           # header: starts at +0x20, no imports
+        struct.pack_into('<2I', raw, 0x6020, 1, 8)                               # one segment, its starts at +8
+        struct.pack_into('<IHHQIHH', raw, 0x6028, 24, 0x4000, 6, 0, 0, 1, 0x10)  # format 6, page 0 starts at 0x10
+        struct.pack_into('<Q', raw, 0x10, 0x1234 | 2 << 51)                      # target 0x1234, next 8 bytes on
+        struct.pack_into('<Q', raw, 0x18, 0x40)
+        self.assertEqual(Image(bytes(raw)).fixups(), {base + 0x10: (base + 0x1234, 0, None, None, None),
+                                                      base + 0x18: (base + 0x40, 0, None, None, None)})
