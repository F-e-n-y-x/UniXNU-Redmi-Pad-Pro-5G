--- a/IOGPUMetalDeviceShim.h	2026-11-26 10:09:50.681385256 +0530
+++ b/IOGPUMetalDeviceShim.h	2026-11-26 10:09:50.709444835 +0530
@@ -19,6 +19,7 @@
 #include <objc/runtime.h>
 #include <stdio.h>
 #include <string.h>
+#include <sys/sysctl.h>
 
 namespace iogpu {
 
@@ -27,7 +28,21 @@
 inline __weak id gDeviceWrapper;
 
 static void setAcceleratorService(id, SEL, id service) { gAcceleratorService = service; }
-static io_service_t acceleratorPort(id, SEL) { return gAcceleratorPort; }
+// Boot-arg ws-swrender=1: WindowServer gets port 0, so SkyLight composites in software (CompositorSW, as macOS-uke/pixel8a saw);
+// every other process keeps the real port and its Metal device.
+static bool softwareCompositor()
+{
+    static const bool on = [] {
+        char args[1100] = {};
+        size_t size = sizeof args - 1;
+        if (strcmp(getprogname(), "WindowServer") || sysctlbyname("kern.bootargs", args, &size, nullptr, 0)) return false;
+        for (const char *at = args; (at = strstr(at, "ws-swrender=1")); at++)
+            if ((at == args || at[-1] == ' ') && (at[13] == 0 || at[13] == ' ')) return true;
+        return false;
+    }();
+    return on;
+}
+static io_service_t acceleratorPort(id, SEL) { return softwareCompositor() ? 0 : gAcceleratorPort; }
 static void setDeviceWrapper(id, SEL, id wrapper) { gDeviceWrapper = wrapper; }
 static id deviceWrapper(id self, SEL) { id wrapper = gDeviceWrapper; return wrapper ? wrapper : self; }
 static BOOL isBuiltIn(id, SEL) { return YES; }
