+// Live rotate 1<->3 is a 180 degree turn of the panel picture: done in place on the scanout, so a still screen is right at once.
+// Pixel pairs move as 64-bit words with their halves swapped (width must be even).
+static inline int native_legacy_turn180(volatile void *destination, uint64_t destinationBytes, uint64_t destinationStride,
+    uint32_t width, uint32_t height) {
+    uintptr_t dst=(uintptr_t)destination;
+    if (!dst || (dst&7) || (destinationStride&7) || (width&1) ||
+        !native_legacy_surface_bounds(width,height,destinationStride,destinationBytes,destinationBytes)) return 0;
+    const uint32_t n=width/2;
+    for (uint32_t y=0;y<(height+1)/2;++y) {
+        volatile uint64_t *top=(volatile uint64_t *)(dst+(uint64_t)y*destinationStride);
+        volatile uint64_t *bottom=(volatile uint64_t *)(dst+(uint64_t)(height-1-y)*destinationStride);
+        const uint32_t m=top==bottom?(n+1)/2:n;   // the middle row of an odd height turns on itself
+        for (uint32_t i=0;i<m;++i) {
+            const uint64_t a=top[i],b=bottom[n-1-i];
+            top[i]=b<<32|b>>32;bottom[n-1-i]=a<<32|a>>32;
+        }
+    }
+    return 1;
+}
 
