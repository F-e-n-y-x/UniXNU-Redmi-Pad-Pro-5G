diff -ruN a/package/AdspFirmware.c b/package/AdspFirmware.c
--- a/package/AdspFirmware.c	1970-01-01 05:30:00.000000000 +0530
+++ b/package/AdspFirmware.c	2026-11-26 20:00:56.776140083 +0530
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Firmware files for the remote processors (they are never part of the build), from one of two places:
+// - "modem:NAME": the device's own split image NAME.b00, NAME.b01, ... in /image of its firmware partition (modem_a, else modem_b), a
+//   FAT volume read in place through the UFS driver (read only; nothing is installed and the boot image does not grow);
+// - any other path: a file on a mounted volume (such as adsp.mbn installed by the owner below /private/var/firmware), read through VFS.
+// Plain reads on the caller's thread: the ADSP thread is the only caller and it runs no interrupt work, so a slow read only delays that
+// bring-up.
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/vnode.h>
+#include <sys/uio.h>
+#include <sys/fcntl.h>
+#include <sys/kauth.h>
+#include <IOKit/IOLib.h>
+#include "FatVolume.h"
+#include "QcomMdt.h"
+
+int sheng_fw_open(const char *path, void **handle, uint64_t *size);
+int sheng_fw_read(void *handle, uint64_t offset, void *to, size_t length);
+void sheng_fw_close(void *handle);
+
+extern int native_ufs_part_find(const char *name, uint32_t *lun, uint64_t *first, uint64_t *blocks) __attribute__((weak_import));
+extern int native_ufs_part_read(uint32_t lun, uint64_t lba, uint32_t blocks, void *dst) __attribute__((weak_import));
+
+// ---- the firmware partition ----
+struct partition {
+    uint32_t lun;
+    uint64_t first;
+    uint64_t cached;  // block in block (UINT64_MAX: none)
+    uint8_t block[4096];
+};
+static struct partition *gPart;
+static FatVolume *gVolume;
+
+// Bytes of the partition: whole blocks straight into to, the ends of a range through the one-block cache.
+static int partitionRead(void *context, uint64_t offset, void *to, size_t length)
+{
+    struct partition *p = context;
+    uint8_t *out = to;
+    while (length) {
+        const uint64_t lba = offset / 4096;
+        const size_t within = (size_t)(offset % 4096);
+        if (!within && length >= 4096) {
+            const uint32_t n = length / 4096 > 256 ? 256 : (uint32_t)(length / 4096);
+            if (!native_ufs_part_read(p->lun, p->first + lba, n, out)) return EIO;
+            out += (size_t)n * 4096; offset += (uint64_t)n * 4096; length -= (size_t)n * 4096;
+            continue;
+        }
+        if (p->cached != lba) {
+            p->cached = UINT64_MAX;
+            if (!native_ufs_part_read(p->lun, p->first + lba, 1, p->block)) return EIO;
+            p->cached = lba;
+        }
+        const size_t take = 4096 - within < length ? 4096 - within : length;
+        memcpy(out, p->block + within, take);
+        out += take; offset += take; length -= take;
+    }
+    return 0;
+}
+
+static int mountPartition(void)
+{
+    static const char *const names[] = {"modem_a", "modem_b"};
+    if (gVolume) return 0;
+    if (!native_ufs_part_find || !native_ufs_part_read) return ENXIO;
+    struct partition *p = IOMallocType(struct partition);
+    FatVolume *v = IOMallocType(FatVolume);
+    int rc = ENOENT;
+    for (unsigned i = 0; i < 2 && rc; ++i) {
+        uint64_t blocks = 0;
+        // ENXIO while the UFS driver is not ready yet: the caller tries again later
+        if (!native_ufs_part_find(names[i], &p->lun, &p->first, &blocks)) {rc = ENXIO; continue;}
+        p->cached = UINT64_MAX;
+        rc = fat_mount(v, blocks * 4096, partitionRead, p) ? EFTYPE : 0;
+    }
+    if (rc) {IOFreeType(p, struct partition); IOFreeType(v, FatVolume); return rc;}
+    gPart = p;
+    gVolume = v;
+    return 0;
+}
+
+struct modem_image {
+    QcomMdtSplit split;
+    FatFile piece[QCOM_MDT_MAX_SEGMENTS];
+};
+
+static int pieceRead(void *context, unsigned piece, uint64_t offset, void *to, size_t length)
+{
+    struct modem_image *m = context;
+    return fat_read(gVolume, &m->piece[piece], offset, to, length);
+}
+
+static int openModem(const char *name, struct modem_image **image, uint64_t *size)
+{
+    char path[48];
+    int rc = mountPartition();
+    if (rc) return rc;
+    struct modem_image *m = IOMallocType(struct modem_image);
+    snprintf(path, sizeof path, "image/%s.b00", name);
+    FatFile headers;
+    rc = fat_open(gVolume, path, &headers);
+    if (rc == FatNotFound) rc = ENOENT;
+    else if (rc) rc = EIO;
+    else if (headers.size < 52 || headers.size > 64 * 1024) rc = EFTYPE;
+    uint8_t *bytes = rc ? NULL : IOMallocData(headers.size);
+    if (!rc && fat_read(gVolume, &headers, 0, bytes, headers.size)) rc = EIO;
+    if (!rc && qcom_mdt_split(&m->split, bytes, headers.size)) rc = EFTYPE;
+    if (bytes) IOFreeData(bytes, headers.size);
+    for (unsigned i = 0; !rc && i < m->split.count; ++i) {
+        if (!m->split.piece[i].size) continue;
+        snprintf(path, sizeof path, "image/%s.b%02u", name, i);
+        if (fat_open(gVolume, path, &m->piece[i])) rc = ENOENT;
+        else if (m->piece[i].size < m->split.piece[i].size) rc = EFTYPE;
+    }
+    if (rc) {IOFreeType(m, struct modem_image); return rc;}
+    *image = m;
+    *size = m->split.size;
+    return 0;
+}
+
+// ---- both kinds ----
+struct sheng_fw {
+    vnode_t vnode;
+    struct modem_image *modem;
+};
+
+int sheng_fw_open(const char *path, void **handle, uint64_t *size)
+{
+    struct sheng_fw *fw = IOMallocType(struct sheng_fw);
+    int error;
+    if (!strncmp(path, "modem:", 6)) {
+        error = openModem(path + 6, &fw->modem, size);
+    } else {
+        vfs_context_t ctx = vfs_context_kernel();
+        struct vnode_attr va;
+        error = vnode_open(path, FREAD, 0, 0, &fw->vnode, ctx);
+        if (!error) {
+            VATTR_INIT(&va);
+            VATTR_WANTED(&va, va_data_size);
+            if ((error = vnode_getattr(fw->vnode, &va, ctx)) || !VATTR_IS_SUPPORTED(&va, va_data_size) || !va.va_data_size) {
+                vnode_close(fw->vnode, FREAD, ctx);
+                fw->vnode = NULLVP;
+                if (!error) error = EFTYPE;
+            } else {
+                *size = va.va_data_size;
+            }
+        }
+    }
+    if (error) {IOFreeType(fw, struct sheng_fw); return error;}
+    *handle = fw;
+    return 0;
+}
+
+int sheng_fw_read(void *handle, uint64_t offset, void *to, size_t length)
+{
+    struct sheng_fw *fw = handle;
+    if (fw->modem) return qcom_mdt_split_read(&fw->modem->split, pieceRead, fw->modem, offset, to, length) ? EIO : 0;
+    vfs_context_t ctx = vfs_context_kernel();
+    uint8_t *out = (uint8_t *)to;
+    while (length) {
+        const int want = length > (1u << 30) ? (1 << 30) : (int)length;
+        int resid = want;
+        const int error = vn_rdwr(UIO_READ, fw->vnode, (caddr_t)out, want, (off_t)offset, UIO_SYSSPACE, IO_NOAUTH,
+                                  vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+        if (error) return error;
+        if (resid == want) return EIO;  /* end of file before the bytes asked for */
+        out += want - resid;
+        offset += (uint64_t)(want - resid);
+        length -= (size_t)(want - resid);
+    }
+    return 0;
+}
+
+void sheng_fw_close(void *handle)
+{
+    struct sheng_fw *fw = handle;
+    if (!fw) return;
+    if (fw->modem) IOFreeType(fw->modem, struct modem_image);
+    if (fw->vnode) vnode_close(fw->vnode, FREAD, vfs_context_kernel());
+    IOFreeType(fw, struct sheng_fw);
+}
+
+// asteroids: a whole file of the firmware partition (image/..., read in place), for the WiFi module's board data. *data is IOMallocData'd
+// (the caller keeps it for the boot). ENOENT when absent, ENXIO while the UFS driver is not up.
+int asteroids_modem_file(const char *path, uint8_t **data, size_t *size)
+{
+    *data = NULL; *size = 0;
+    int rc = mountPartition();
+    if (rc) return rc;
+    FatFile file;
+    rc = fat_open(gVolume, path, &file);
+    if (rc == FatNotFound) return ENOENT;
+    if (rc) return EIO;
+    if (file.directory || !file.size || file.size > 16u * 1024 * 1024) return EFTYPE;
+    uint8_t *bytes = IOMallocData(file.size);
+    if (!bytes) return ENOMEM;
+    if (fat_read(gVolume, &file, 0, bytes, file.size)) {IOFreeData(bytes, file.size); return EIO;}
+    *data = bytes; *size = file.size;
+    return 0;
+}
+
+// asteroids: the short names in a directory of the firmware partition (for the log); 0 or an errno.
+int asteroids_modem_list(const char *path, char *out, size_t cap)
+{
+    int rc = mountPartition();
+    if (rc) return rc;
+    rc = fat_list(gVolume, path, out, cap);
+    return rc == FatNotFound ? ENOENT : rc ? EIO : 0;
+}
diff -ruN a/package/FatVolume.c b/package/FatVolume.c
--- a/package/FatVolume.c	1970-01-01 05:30:00.000000000 +0530
+++ b/package/FatVolume.c	2026-11-26 20:00:57.090572179 +0530
@@ -0,0 +1,289 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "FatVolume.h"
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static int fits(uint64_t at, uint64_t length, uint64_t size) {return at <= size && length <= size - at;}
+
+static int vread(FatVolume *v, uint64_t offset, void *to, size_t length)
+{
+    if (!fits(offset, length, v->size)) return FatDamaged;
+    return v->read(v->context, offset, to, length) ? FatReadError : FatOk;
+}
+
+int fat_mount(FatVolume *v, uint64_t size, FatRead read, void *context)
+{
+    uint8_t b[512];
+    if (!v || !read) return FatReadError;
+    *v = (FatVolume){0};
+    v->read = read; v->context = context; v->size = size;
+    v->cached_sector = UINT64_MAX;
+    if (size < sizeof b) return FatNotFat;
+    if (vread(v, 0, b, sizeof b)) return FatReadError;
+    const uint32_t bps = le16(b + 11), spc = b[13], reserved = le16(b + 14), fats = b[16], root = le16(b + 17);
+    const uint32_t total = le16(b + 19) ? le16(b + 19) : le32(b + 32);
+    const uint32_t fat_sectors = le16(b + 22) ? le16(b + 22) : le32(b + 36);
+    if (b[510] != 0x55 || b[511] != 0xaa) return FatNotFat;
+    if (bps < 512 || bps > sizeof v->sector || (bps & (bps - 1)) || !spc || (spc & (spc - 1)) || !reserved || !fats || !fat_sectors)
+        return FatNotFat;
+    const uint64_t root_sectors = ((uint64_t)root * 32 + bps - 1) / bps;
+    const uint64_t data_sector = reserved + (uint64_t)fats * fat_sectors + root_sectors;
+    /* The volume may declare more sectors than its partition holds (the 3a's bluetooth_a: 64 MiB of FAT16 in 4 MiB, which Android
+     * mounts); the type comes from the declared size, the tables must fit, and every read stays bounded by the partition (vread). */
+    if (total <= data_sector || data_sector * bps > size) return FatNotFat;
+    const uint64_t clusters = (total - data_sector) / spc;
+    if (clusters < 4085) return FatNotFat;  /* FAT12 */
+    v->fat32 = clusters >= 65525;
+    if (v->fat32 ? root != 0 : root == 0) return FatNotFat;
+    /* the table must hold an entry for every cluster */
+    if ((uint64_t)fat_sectors * bps / (v->fat32 ? 4 : 2) < clusters + 2 || clusters > 0x0ffffff0) return FatNotFat;
+    v->sector_bytes = bps;
+    v->cluster_bytes = bps * spc;
+    v->clusters = (uint32_t)clusters;
+    v->fat_offset = (uint64_t)reserved * bps;
+    v->root_offset = (reserved + (uint64_t)fats * fat_sectors) * bps;
+    v->data_offset = data_sector * bps;
+    v->root_entries = root;
+    v->root_cluster = v->fat32 ? le32(b + 44) & 0x0fffffff : 0;
+    return FatOk;
+}
+
+static int valid(const FatVolume *v, uint32_t cluster) {return cluster >= 2 && cluster - 2 < v->clusters;}
+static uint64_t cluster_offset(const FatVolume *v, uint32_t cluster) {return v->data_offset + (uint64_t)(cluster - 2) * v->cluster_bytes;}
+
+/* The table entry of cluster (valid), through the one-sector cache. */
+static int next_cluster(FatVolume *v, uint32_t cluster, uint32_t *next)
+{
+    const uint64_t at = v->fat_offset + (uint64_t)cluster * (v->fat32 ? 4 : 2);
+    const uint64_t sector = at / v->sector_bytes;
+    if (sector != v->cached_sector) {
+        v->cached_sector = UINT64_MAX;
+        const int rc = vread(v, sector * v->sector_bytes, v->sector, v->sector_bytes);
+        if (rc) return rc;
+        v->cached_sector = sector;
+    }
+    const uint8_t *e = v->sector + at % v->sector_bytes;
+    *next = v->fat32 ? le32(e) & 0x0fffffff : le16(e);
+    return FatOk;
+}
+
+static uint8_t upper(char c) {return (uint8_t)(c >= 'a' && c <= 'z' ? c - 32 : c);}
+
+/* The 11-byte directory form of one path component; 0 when it is no 8.3 name. */
+static int short_name(const char *name, size_t length, uint8_t out[11])
+{
+    size_t dot = length;
+    for (size_t i = 0; i < length; ++i) if (name[i] == '.') {if (dot != length) return 0; dot = i;}
+    const size_t ext = dot < length ? length - dot - 1 : 0;
+    if (!dot || dot > 8 || ext > 3 || (dot < length && !ext)) return 0;
+    for (unsigned i = 0; i < 11; ++i) out[i] = ' ';
+    for (size_t i = 0; i < dot; ++i) out[i] = upper(name[i]);
+    for (size_t i = 0; i < ext; ++i) out[8 + i] = upper(name[dot + 1 + i]);
+    return 1;
+}
+
+/* Long names: up to 20 entries of 13 UCS-2 characters each, before the short entry they belong to (checked by its checksum). */
+#define LFN_ENTRIES 20u
+static const uint8_t lfn_slots[13] = {1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30};
+typedef struct {uint16_t text[LFN_ENTRIES * 13]; uint8_t valid, next, sum, count;} LongName;
+
+static uint8_t short_sum(const uint8_t *d)
+{
+    uint8_t sum = 0;
+    for (unsigned i = 0; i < 11; ++i) sum = (uint8_t)(((sum & 1) << 7) + (sum >> 1) + d[i]);
+    return sum;
+}
+
+static void long_part(LongName *l, const uint8_t *d)
+{
+    const unsigned seq = d[0] & 0x1f;
+    if (d[0] & 0x40) {  /* the last part comes first */
+        l->valid = seq >= 1 && seq <= LFN_ENTRIES;
+        l->count = (uint8_t)seq;
+        l->sum = d[13];
+    } else if (!l->valid || seq != l->next - 1u || d[13] != l->sum) {
+        l->valid = 0;
+    }
+    if (!l->valid) return;
+    l->next = (uint8_t)seq;
+    for (unsigned k = 0; k < 13; ++k) l->text[(seq - 1) * 13 + k] = le16(d + lfn_slots[k]);
+}
+
+static int long_matches(const LongName *l, const uint8_t *d, const char *name, size_t length)
+{
+    if (!l->valid || l->next != 1 || short_sum(d) != l->sum) return 0;
+    size_t n = 0;
+    while (n < (size_t)l->count * 13 && l->text[n]) ++n;
+    if (n != length) return 0;
+    for (size_t i = 0; i < n; ++i) if (l->text[i] > 0x7f || upper((char)l->text[i]) != upper(name[i])) return 0;
+    return 1;
+}
+
+/* Looks for a name in a directory (the FAT16 fixed root for cluster 0, else a cluster chain): its long name, or its short name. */
+static int find(FatVolume *v, uint32_t cluster, const char *name, size_t length, FatFile *file)
+{
+    uint8_t chunk[512], want[11];
+    LongName l;
+    l.valid = 0;
+    const int has_short = short_name(name, length, want);
+    const int fixed = cluster == 0;
+    if (fixed && v->fat32) cluster = v->root_cluster;
+    uint64_t at = fixed && !v->fat32 ? v->root_offset : 0;
+    uint64_t left = fixed && !v->fat32 ? (uint64_t)v->root_entries * 32 : 0;
+    for (uint32_t walked = 0;;) {
+        if (!(fixed && !v->fat32)) {
+            if (!valid(v, cluster) || walked++ > v->clusters) return FatDamaged;
+            at = cluster_offset(v, cluster);
+            left = v->cluster_bytes;
+        }
+        while (left) {
+            const size_t n = left < sizeof chunk ? (size_t)left : sizeof chunk;
+            const int rc = vread(v, at, chunk, n);
+            if (rc) return rc;
+            for (size_t e = 0; e + 32 <= n; e += 32) {
+                const uint8_t *d = chunk + e;
+                if (!d[0]) return FatNotFound;
+                if (d[0] == 0xe5) {l.valid = 0; continue;}
+                if ((d[11] & 0x3f) == 0x0f) {long_part(&l, d); continue;}
+                int same = long_matches(&l, d, name, length);
+                l.valid = 0;
+                if (d[11] & 0x08) continue;  /* the volume label */
+                for (unsigned i = 0; i < 11 && has_short && !same; ++i) {
+                    if (upper((char)d[i]) != want[i]) break;
+                    if (i == 10) same = 1;
+                }
+                if (!same) continue;
+                file->first_cluster = (uint32_t)le16(d + 26) | (v->fat32 ? (uint32_t)le16(d + 20) << 16 : 0);
+                file->size = le32(d + 28);
+                file->directory = (d[11] & 0x10) != 0;
+                return FatOk;
+            }
+            at += n;
+            left -= n;
+        }
+        if (fixed && !v->fat32) return FatNotFound;
+        uint32_t next;
+        const int rc = next_cluster(v, cluster, &next);
+        if (rc) return rc;
+        if (!valid(v, next)) return FatNotFound;  /* the end of the directory */
+        cluster = next;
+    }
+}
+
+int fat_open(FatVolume *v, const char *path, FatFile *file)
+{
+    FatFile at = {0, 0, 1};  /* the root */
+    if (!v || !path || !file) return FatNotFound;
+    while (*path) {
+        while (*path == '/') ++path;
+        size_t n = 0;
+        while (path[n] && path[n] != '/') ++n;
+        if (!n) break;
+        if (!at.directory) return FatNotDirectory;
+        const int rc = find(v, at.first_cluster, path, n, &at);
+        if (rc) return rc;
+        path += n;
+    }
+    *file = at;
+    return FatOk;
+}
+
+int fat_read(FatVolume *v, const FatFile *file, uint64_t offset, void *to, size_t length)
+{
+    uint8_t *out = to;
+    if (!v || !file || !to) return FatReadError;
+    if (file->directory) return FatIsDirectory;
+    if (!fits(offset, length, file->size)) return FatRange;
+    if (!length) return FatOk;
+    uint32_t cluster = file->first_cluster, walked = 0;
+    for (uint64_t skip = offset / v->cluster_bytes; skip; --skip) {
+        if (!valid(v, cluster) || ++walked > v->clusters) return FatDamaged;
+        const int rc = next_cluster(v, cluster, &cluster);
+        if (rc) return rc;
+    }
+    uint64_t within = offset % v->cluster_bytes;
+    while (length) {
+        if (!valid(v, cluster)) return FatDamaged;
+        /* a run of consecutive clusters is one read */
+        uint32_t last = cluster, next = 0;
+        uint64_t span = v->cluster_bytes - within;
+        for (;;) {
+            if (++walked > v->clusters) return FatDamaged;
+            const int rc = next_cluster(v, last, &next);
+            if (rc) return rc;
+            if (span >= length || next != last + 1 || !valid(v, next)) break;
+            last = next;
+            span += v->cluster_bytes;
+        }
+        const size_t take = span < length ? (size_t)span : length;
+        const int rc = vread(v, cluster_offset(v, cluster) + within, out, take);
+        if (rc) return rc;
+        out += take;
+        length -= take;
+        within = 0;
+        cluster = next;
+    }
+    return FatOk;
+}
+
+/* asteroids: the names in a directory (long names where present, else 8.3), space separated, directories with a trailing '/', as
+ * many as fit in out. */
+int fat_list(FatVolume *v, const char *path, char *out, size_t cap)
+{
+    FatFile dir;
+    if (!out || !cap) return FatReadError;
+    out[0] = 0;
+    int rc = fat_open(v, path, &dir);
+    if (rc) return rc;
+    if (!dir.directory) return FatNotDirectory;
+    uint8_t chunk[512];
+    uint32_t cluster = dir.first_cluster;
+    const int fixed = cluster == 0;
+    if (fixed && v->fat32) cluster = v->root_cluster;
+    uint64_t at = fixed && !v->fat32 ? v->root_offset : 0;
+    uint64_t left = fixed && !v->fat32 ? (uint64_t)v->root_entries * 32 : 0;
+    size_t used = 0;
+    LongName l;
+    l.valid = 0;
+    for (uint32_t walked = 0;;) {
+        if (!(fixed && !v->fat32)) {
+            if (!valid(v, cluster) || walked++ > v->clusters) return FatDamaged;
+            at = cluster_offset(v, cluster);
+            left = v->cluster_bytes;
+        }
+        while (left) {
+            const size_t n = left < sizeof chunk ? (size_t)left : sizeof chunk;
+            if ((rc = vread(v, at, chunk, n))) return rc;
+            for (size_t e = 0; e + 32 <= n; e += 32) {
+                const uint8_t *d = chunk + e;
+                if (!d[0]) return FatOk;
+                if (d[0] == 0xe5) {l.valid = 0; continue;}
+                if ((d[11] & 0x3f) == 0x0f) {long_part(&l, d); continue;}
+                const int named = l.valid && l.next == 1 && short_sum(d) == l.sum;
+                l.valid = 0;
+                if ((d[11] & 0x08) || d[0] == '.') continue;
+                char name[64];
+                size_t k = 0;
+                if (named) {
+                    for (size_t i = 0; i < (size_t)l.count * 13 && l.text[i] && k < sizeof name - 2; ++i)
+                        name[k++] = l.text[i] < 0x80 ? (char)l.text[i] : '?';
+                } else {
+                    for (unsigned i = 0; i < 8 && d[i] != ' '; ++i) name[k++] = (char)d[i];
+                    if (d[8] != ' ') {name[k++] = '.'; for (unsigned i = 8; i < 11 && d[i] != ' '; ++i) name[k++] = (char)d[i];}
+                }
+                if (d[11] & 0x10) name[k++] = '/';
+                if (used + k + 2 > cap) return FatOk;
+                if (used) out[used++] = ' ';
+                for (size_t i = 0; i < k; ++i) out[used++] = name[i];
+                out[used] = 0;
+            }
+            at += n;
+            left -= n;
+        }
+        if (fixed && !v->fat32) return FatOk;
+        uint32_t next;
+        if ((rc = next_cluster(v, cluster, &next))) return rc;
+        if (!valid(v, next)) return FatOk;
+        cluster = next;
+    }
+}
diff -ruN a/package/FatVolume.h b/package/FatVolume.h
--- a/package/FatVolume.h	1970-01-01 05:30:00.000000000 +0530
+++ b/package/FatVolume.h	2026-11-26 20:00:57.882569725 +0530
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* A read-only FAT16/FAT32 volume over a byte read callback: enough to find a file by its long or short (8.3) name in a directory path and read
+ * any range of it. Used to take the device's own firmware files from its firmware partition in place. No allocation: the one sector of
+ * the allocation table in use is cached in the volume. The volume's metadata is untrusted: every cluster number and chain is bounds
+ * checked and every chain walk is bounded, so a damaged volume gives an error, never a loop or a read outside the partition. */
+#ifndef FAT_VOLUME_H
+#define FAT_VOLUME_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Reads length bytes at offset (from the partition start) into to; returns 0 on success. */
+typedef int (*FatRead)(void *context, uint64_t offset, void *to, size_t length);
+
+enum {
+    FatOk = 0,
+    FatReadError = -1,
+    FatNotFat = -2,     /* no boot sector of a FAT16 or FAT32 volume */
+    FatNotFound = -3,
+    FatNotDirectory = -4,
+    FatIsDirectory = -5,
+    FatDamaged = -6,    /* a cluster chain leaves the volume, loops or is shorter than the file */
+    FatRange = -7,      /* the read goes past the end of the file */
+};
+
+typedef struct {
+    FatRead read;
+    void *context;
+    uint64_t size;                                    /* partition bytes */
+    uint8_t fat32;
+    uint32_t sector_bytes, cluster_bytes, clusters;   /* clusters: data clusters, numbered 2 .. clusters + 1 */
+    uint64_t fat_offset, root_offset, data_offset;    /* bytes from the partition start; root_offset is FAT16 only */
+    uint32_t root_entries, root_cluster;              /* root_entries: FAT16 fixed root; root_cluster: FAT32 */
+    uint64_t cached_sector;                           /* UINT64_MAX: nothing cached */
+    uint8_t sector[4096];
+} FatVolume;
+
+typedef struct {
+    uint32_t first_cluster, size;
+    uint8_t directory;
+} FatFile;
+
+int fat_mount(FatVolume *v, uint64_t size, FatRead read, void *context);
+/* path: names separated by '/', each matched in any case against the long name, else the 8.3 name ("image/adsp.b00"). */
+int fat_open(FatVolume *v, const char *path, FatFile *file);
+int fat_read(FatVolume *v, const FatFile *file, uint64_t offset, void *to, size_t length);
+/* asteroids: the short names in a directory, space separated (directories end in '/'), as many as fit in out. */
+int fat_list(FatVolume *v, const char *path, char *out, size_t cap);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff -ruN a/package/QcomMdt.c b/package/QcomMdt.c
--- a/package/QcomMdt.c	1970-01-01 05:30:00.000000000 +0530
+++ b/package/QcomMdt.c	2026-11-26 20:00:55.914575823 +0530
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomMdt.h"
+
+#define PT_LOAD_ 1u
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static uint64_t le64(const uint8_t *p) {return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;}
+static int fits(uint64_t at, uint64_t length, uint64_t size) {return at <= size && length <= size - at;}
+
+int qcom_mdt_parse(QcomMdtImage *image, uint64_t file_size, QcomMdtRead read, void *context)
+{
+    uint8_t e[64];
+    if (!image || !read) return QcomMdtReadError;
+    *image = (QcomMdtImage){0};
+    image->hash = -1;
+    image->file_size = file_size;
+    if (file_size < 52 || read(context, 0, e, file_size < 64 ? 52 : 64)) return file_size < 52 ? QcomMdtTooSmall : QcomMdtReadError;
+    if (e[0] != 0x7f || e[1] != 'E' || e[2] != 'L' || e[3] != 'F' || e[5] != 1 /* little endian */) return QcomMdtNotElf;
+    const int elf64 = e[4] == 2;
+    if (!elf64 && e[4] != 1) return QcomMdtNotElf;
+    if (elf64 && file_size < 64) return QcomMdtTooSmall;
+    const uint64_t phoff = elf64 ? le64(e + 32) : le32(e + 28);
+    const unsigned phentsize = elf64 ? le16(e + 54) : le16(e + 42), phnum = elf64 ? le16(e + 56) : le16(e + 44);
+    if (phentsize != (elf64 ? 56u : 32u) || !phnum) return QcomMdtBadHeaders;
+    if (phnum > QCOM_MDT_MAX_SEGMENTS) return QcomMdtTooMany;
+    if (!fits(phoff, (uint64_t)phentsize * phnum, file_size)) return QcomMdtBadHeaders;
+    image->elf64 = (uint8_t)elf64;
+    image->count = phnum;
+    uint64_t lo = UINT64_MAX, hi = 0;
+    for (unsigned i = 0; i < phnum; ++i) {
+        uint8_t p[56];
+        if (read(context, phoff + (uint64_t)i * phentsize, p, phentsize)) return QcomMdtReadError;
+        QcomMdtSegment *s = &image->segment[i];
+        const uint32_t type = le32(p);
+        if (elf64) {
+            s->flags = le32(p + 4); s->file_offset = le64(p + 8); s->address = le64(p + 24);
+            s->file_size = le64(p + 32); s->memory_size = le64(p + 40);
+        } else {
+            s->file_offset = le32(p + 4); s->address = le32(p + 12); s->file_size = le32(p + 16);
+            s->memory_size = le32(p + 20); s->flags = le32(p + 24);
+        }
+        if ((s->flags & QCOM_MDT_TYPE_MASK) == QCOM_MDT_TYPE_HASH) {
+            if (image->hash < 0) image->hash = (int)i;
+            continue;
+        }
+        if (type != PT_LOAD_ || !s->memory_size) continue;
+        if (s->file_size > s->memory_size) return QcomMdtBadHeaders;
+        if (s->address + s->memory_size < s->address) return QcomMdtBadHeaders;
+        s->load = 1;
+        if (s->flags & QCOM_MDT_RELOCATABLE) image->relocatable = 1;
+        if (s->address < lo) lo = s->address;
+        if (s->address + s->memory_size > hi) hi = s->address + s->memory_size;
+    }
+    if (image->hash < 0) return QcomMdtNoHash;
+    if (hi == 0) return QcomMdtNoSegments;
+    image->header_size = image->segment[0].file_size;
+    /* The first program header (PT_NULL) covers the ELF header and the program headers themselves. */
+    if (!image->header_size || !fits(0, image->header_size, file_size) || image->header_size < phoff + (uint64_t)phentsize * phnum)
+        return QcomMdtBadHeaders;
+    image->min_address = lo;
+    image->max_address = hi;
+    return QcomMdtOk;
+}
+
+uint64_t qcom_mdt_metadata_size(const QcomMdtImage *image)
+{
+    return image->header_size + image->segment[image->hash].file_size;
+}
+
+int qcom_mdt_metadata(const QcomMdtImage *image, QcomMdtRead read, void *context, uint8_t *to, uint64_t capacity)
+{
+    const QcomMdtSegment *hash = &image->segment[image->hash];
+    if (capacity < qcom_mdt_metadata_size(image)) return QcomMdtTooSmall;
+    uint64_t hash_offset;
+    /* A hash packed right behind the headers (the split .mdt form) or a hash segment inside the file. */
+    if (image->header_size + hash->file_size == image->file_size) hash_offset = image->header_size;
+    else if (fits(hash->file_offset, hash->file_size, image->file_size)) hash_offset = hash->file_offset;
+    else return QcomMdtOutside;
+    if (read(context, 0, to, (size_t)image->header_size)) return QcomMdtReadError;
+    if (read(context, hash_offset, to + image->header_size, (size_t)hash->file_size)) return QcomMdtReadError;
+    return QcomMdtOk;
+}
+
+/* The secure world takes the span with its end rounded up to a 4 KiB page and refuses an unaligned one. */
+uint64_t qcom_mdt_span(const QcomMdtImage *image) {return ((image->max_address + 0xfff) & ~0xfffull) - image->min_address;}
+
+int qcom_mdt_place(const QcomMdtImage *image, unsigned index, uint64_t region_base, uint64_t region_size, uint64_t *offset)
+{
+    if (index >= image->count || !image->segment[index].load) return QcomMdtOutside;
+    const QcomMdtSegment *s = &image->segment[index];
+    uint64_t at;
+    if (image->relocatable) at = s->address - image->min_address;
+    else if (s->address >= region_base) at = s->address - region_base;
+    else return QcomMdtOutside;
+    if (!fits(at, s->memory_size, region_size)) return QcomMdtOutside;
+    if (s->file_size && !fits(s->file_offset, s->file_size, image->file_size)) return QcomMdtOutside;
+    *offset = at;
+    return QcomMdtOk;
+}
+
+int qcom_mdt_split(QcomMdtSplit *split, const uint8_t *headers, size_t length)
+{
+    if (!split || !headers) return QcomMdtReadError;
+    *split = (QcomMdtSplit){0};
+    if (length < 52) return QcomMdtTooSmall;
+    const uint8_t *e = headers;
+    if (e[0] != 0x7f || e[1] != 'E' || e[2] != 'L' || e[3] != 'F' || e[5] != 1 || (e[4] != 1 && e[4] != 2)) return QcomMdtNotElf;
+    const int elf64 = e[4] == 2;
+    if (elf64 && length < 64) return QcomMdtTooSmall;
+    const uint64_t phoff = elf64 ? le64(e + 32) : le32(e + 28);
+    const unsigned phentsize = elf64 ? le16(e + 54) : le16(e + 42), phnum = elf64 ? le16(e + 56) : le16(e + 44);
+    if (phentsize != (elf64 ? 56u : 32u) || !phnum) return QcomMdtBadHeaders;
+    if (phnum > QCOM_MDT_MAX_SEGMENTS) return QcomMdtTooMany;
+    if (!fits(phoff, (uint64_t)phentsize * phnum, length)) return QcomMdtBadHeaders;
+    split->count = phnum;
+    for (unsigned i = 0; i < phnum; ++i) {
+        const uint8_t *p = e + phoff + (uint64_t)i * phentsize;
+        const uint64_t offset = elf64 ? le64(p + 8) : le32(p + 4), size = elf64 ? le64(p + 32) : le32(p + 16);
+        if (offset + size < offset) return QcomMdtBadHeaders;
+        split->piece[i].offset = offset;
+        split->piece[i].size = size;
+        if (size && offset + size > split->size) split->size = offset + size;
+    }
+    /* piece 0 must be the headers themselves */
+    if (split->piece[0].offset || split->piece[0].size < phoff + (uint64_t)phentsize * phnum) return QcomMdtBadHeaders;
+    return QcomMdtOk;
+}
+
+int qcom_mdt_split_read(const QcomMdtSplit *split, QcomMdtPieceRead read, void *context, uint64_t offset, void *to, size_t length)
+{
+    uint8_t *out = to;
+    if (!split || !read || !to || !fits(offset, length, split->size)) return QcomMdtOutside;
+    while (length) {
+        /* the piece holding offset, or else the distance to the next piece */
+        uint64_t take = length, gap_end = split->size;
+        int hit = -1;
+        for (unsigned i = 0; i < split->count; ++i) {
+            const uint64_t at = split->piece[i].offset, size = split->piece[i].size;
+            if (!size) continue;
+            if (offset >= at && offset - at < size) {hit = (int)i; break;}
+            if (at > offset && at < gap_end) gap_end = at;
+        }
+        if (hit >= 0) {
+            const uint64_t left = split->piece[hit].offset + split->piece[hit].size - offset;
+            if (take > left) take = left;
+            if (read(context, (unsigned)hit, offset - split->piece[hit].offset, out, (size_t)take)) return QcomMdtReadError;
+        } else {
+            if (take > gap_end - offset) take = gap_end - offset;
+            for (uint64_t i = 0; i < take; ++i) out[i] = 0;
+        }
+        out += take;
+        offset += take;
+        length -= (size_t)take;
+    }
+    return QcomMdtOk;
+}
diff -ruN a/package/QcomMdt.h b/package/QcomMdt.h
--- a/package/QcomMdt.h	1970-01-01 05:30:00.000000000 +0530
+++ b/package/QcomMdt.h	2026-11-26 20:00:56.011364022 +0530
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Qualcomm signed firmware images (.mbn, an ELF32 or ELF64 whose program headers carry the segment types in p_flags) as the peripheral
+ * authentication service takes them: the metadata handed to the secure world (the ELF and program headers followed by the hash
+ * segment), the extent of the loadable segments and where each one goes in the carveout. Pure parsing over a read callback: no
+ * allocation, no hardware, so the same code runs in the kernel and in the host tests. */
+#ifndef QCOM_MDT_H
+#define QCOM_MDT_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_MDT_MAX_SEGMENTS 64u
+#define QCOM_MDT_TYPE_MASK (7u << 24)
+#define QCOM_MDT_TYPE_HASH (2u << 24)
+#define QCOM_MDT_RELOCATABLE (1u << 27)
+
+/* Reads length bytes at offset of the image file into to; returns 0 on success. */
+typedef int (*QcomMdtRead)(void *context, uint64_t offset, void *to, size_t length);
+
+typedef struct {
+    uint64_t file_offset, file_size, memory_size, address;  /* address: p_paddr */
+    uint32_t flags;
+    uint8_t load;  /* a loadable segment (PT_LOAD, not the hash, memory size not zero) */
+} QcomMdtSegment;
+
+typedef struct {
+    uint8_t elf64;
+    uint32_t count;
+    QcomMdtSegment segment[QCOM_MDT_MAX_SEGMENTS];
+    int hash;                        /* index of the hash segment */
+    uint64_t header_size;            /* p_filesz of the first program header: ELF header plus program headers */
+    uint64_t min_address, max_address;  /* of the loadable segments */
+    uint8_t relocatable;
+    uint64_t file_size;
+} QcomMdtImage;
+
+enum {
+    QcomMdtOk = 0,
+    QcomMdtReadError = -1,
+    QcomMdtNotElf = -2,
+    QcomMdtBadHeaders = -3,
+    QcomMdtNoHash = -4,
+    QcomMdtTooMany = -5,
+    QcomMdtNoSegments = -6,
+    QcomMdtOutside = -7,
+    QcomMdtTooSmall = -8,
+};
+
+/* Parses the ELF and program headers of an image of file_size bytes. */
+int qcom_mdt_parse(QcomMdtImage *image, uint64_t file_size, QcomMdtRead read, void *context);
+
+/* Bytes of the metadata blob for the authentication service: the header part and the hash segment. */
+uint64_t qcom_mdt_metadata_size(const QcomMdtImage *image);
+
+/* Writes the metadata blob (qcom_mdt_metadata_size bytes) to to. The hash segment must lie inside the file: images split into .bNN
+ * files are joined into one .mbn on the host before they are installed. */
+int qcom_mdt_metadata(const QcomMdtImage *image, QcomMdtRead read, void *context, uint8_t *to, uint64_t capacity);
+
+/* Bytes the loadable segments span (the end rounded up to 4 KiB, minus the lowest address): the size to hand to the memory setup call
+ * of a relocatable image. */
+uint64_t qcom_mdt_span(const QcomMdtImage *image);
+
+/* Offset of a loadable segment inside a carveout of region_size bytes at region_base: relocatable images are placed by their offset from
+ * the lowest segment, fixed ones by their address. Returns QcomMdtOutside if the segment does not fit. */
+int qcom_mdt_place(const QcomMdtImage *image, unsigned index, uint64_t region_base, uint64_t region_size, uint64_t *offset);
+
+/* A split image (NAME.b00, NAME.b01, ... as found on the device's firmware partition) read as the joined image: the bytes of program
+ * header i's segment come from piece i (NAME.bNN) at the segment's file offset, piece 0 being the ELF and program headers; whatever
+ * lies between the pieces reads as zero. The pieces are the caller's files. */
+typedef int (*QcomMdtPieceRead)(void *context, unsigned piece, uint64_t offset, void *to, size_t length);
+typedef struct {
+    uint32_t count;
+    struct {uint64_t offset, size;} piece[QCOM_MDT_MAX_SEGMENTS];  /* size 0: no piece file for this header */
+    uint64_t size;                                                  /* bytes of the joined image */
+} QcomMdtSplit;
+
+/* Lays out the pieces from the headers (the bytes of NAME.b00, or the start of NAME.mdt). */
+int qcom_mdt_split(QcomMdtSplit *split, const uint8_t *headers, size_t length);
+/* Reads a range of the joined image. */
+int qcom_mdt_split_read(const QcomMdtSplit *split, QcomMdtPieceRead read, void *context, uint64_t offset, void *to, size_t length);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff -ruN a/package/QcomQmp.c b/package/QcomQmp.c
--- a/package/QcomQmp.c	1970-01-01 05:30:00.000000000 +0530
+++ b/package/QcomQmp.c	2026-11-26 20:00:56.028332717 +0530
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomQmp.h"
+
+/* Descriptor words (byte offset / 4): magic, version, features; the AOP's link state, its ack, channel state, its ack, mailbox size and
+ * offset; then the same six for our side. */
+#define MAGIC 0x4d41494cu
+#define D_MAGIC 0
+#define D_VERSION 1
+#define D_UCORE_LINK 3
+#define D_UCORE_LINK_ACK 4
+#define D_UCORE_CH 5
+#define D_UCORE_CH_ACK 6
+#define D_MCORE_LINK 9
+#define D_MCORE_LINK_ACK 10
+#define D_MCORE_CH 11
+#define D_MCORE_CH_ACK 12
+#define D_MCORE_SIZE 13
+#define D_MCORE_OFFSET 14
+#define UP 0x0000ffffu
+
+static void barrier(void)
+{
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dsb sy" ::: "memory");
+#endif
+}
+static void kick(QcomQmp *q) {barrier(); if (q->kick) q->kick(q->context);}
+
+void qcom_qmp_init(QcomQmp *q, volatile uint32_t *ram, uint32_t ram_bytes, void (*k)(void *), void *context)
+{
+    *q = (QcomQmp){ram, ram_bytes, 0, 0, QcomQmpIdle, k, context};
+}
+
+int qcom_qmp_step(QcomQmp *q)
+{
+    volatile uint32_t *r = q->ram;
+    switch (q->state) {
+    case QcomQmpIdle: {
+        if (r[D_MAGIC] != MAGIC || r[D_VERSION] != 1) return q->state = QcomQmpBadDescriptor;
+        const uint32_t box = r[D_MCORE_OFFSET], size = r[D_MCORE_SIZE];
+        if ((box & 3) || size < QCOM_QMP_MESSAGE + 4 || box < 0x3c || box > q->ram_bytes || size > q->ram_bytes - box)
+            return q->state = QcomQmpBadDescriptor;
+        q->box = box;
+        q->box_size = size;
+        /* A channel a boot stage left open is used as it is. */
+        if (r[D_MCORE_LINK] == UP && r[D_MCORE_LINK_ACK] == UP && r[D_MCORE_CH] == UP && r[D_UCORE_CH] == UP && r[D_MCORE_CH_ACK] == UP)
+            return q->state = QcomQmpOpen;
+        r[D_UCORE_LINK_ACK] = r[D_UCORE_LINK];
+        r[D_MCORE_LINK] = UP;
+        kick(q);
+        q->state = QcomQmpLinkWait;
+    }
+        /* fall through: the ack may already be there */
+    case QcomQmpLinkWait:
+        if (r[D_MCORE_LINK_ACK] != UP) return q->state;
+        r[D_MCORE_CH] = UP;
+        kick(q);
+        q->state = QcomQmpChannelWait;
+        /* fall through */
+    case QcomQmpChannelWait:
+        if (r[D_UCORE_CH] != UP) return q->state;
+        r[D_UCORE_CH_ACK] = UP;
+        kick(q);
+        q->state = QcomQmpAckWait;
+        /* fall through */
+    case QcomQmpAckWait:
+        if (r[D_MCORE_CH_ACK] != UP) return q->state;
+        return q->state = QcomQmpOpen;
+    case QcomQmpSending:
+        if (r[q->box / 4] != 0) return q->state;
+        return q->state = QcomQmpOpen;
+    default:
+        return q->state;
+    }
+}
+
+int qcom_qmp_send(QcomQmp *q, const char *text)
+{
+    if (q->state != QcomQmpOpen) return QcomQmpBusy;
+    uint32_t words[QCOM_QMP_MESSAGE / 4] = {0};
+    unsigned n = 0;
+    while (text[n]) {
+        if (n >= QCOM_QMP_MESSAGE - 1) return QcomQmpTooLong;
+        words[n / 4] |= (uint32_t)(uint8_t)text[n] << (8 * (n % 4));
+        ++n;
+    }
+    volatile uint32_t *r = q->ram;
+    if (r[q->box / 4] != 0) return QcomQmpBusy;
+    for (unsigned i = 0; i < QCOM_QMP_MESSAGE / 4; ++i) r[q->box / 4 + 1 + i] = words[i];
+    barrier();
+    r[q->box / 4] = QCOM_QMP_MESSAGE;
+    kick(q);
+    return q->state = QcomQmpSending;
+}
+
+void qcom_qmp_abandon(QcomQmp *q)
+{
+    if (q->state != QcomQmpSending) return;
+    q->ram[q->box / 4] = 0;
+    barrier();
+    q->state = QcomQmpOpen;
+}
diff -ruN a/package/QcomQmp.h b/package/QcomQmp.h
--- a/package/QcomQmp.h	1970-01-01 05:30:00.000000000 +0530
+++ b/package/QcomQmp.h	2026-11-26 20:00:56.064428353 +0530
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The AOSS QMP mailbox: a message RAM shared with the always-on processor, a link and channel handshake, then one text message at a
+ * time ("{class: image, res: load_state, name: adsp, val: on}"). Written as a state machine stepped on each doorbell from the AOP (or a
+ * timer): qcom_qmp_step never waits, it returns what it is waiting for and the owner calls it again when the AOP rings or the deadline
+ * passes. Ringing the AOP is the owner's kick callback. */
+#ifndef QCOM_QMP_H
+#define QCOM_QMP_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_QMP_MESSAGE 0x64u  /* message length the AOP takes (padded with zeroes) */
+
+enum {
+    QcomQmpIdle = 0,         /* closed, nothing started */
+    QcomQmpLinkWait = 1,     /* our link is up, waiting for the AOP's ack */
+    QcomQmpChannelWait = 2,  /* our channel is up, waiting for the AOP's channel */
+    QcomQmpAckWait = 3,      /* the AOP's channel acked, waiting for its ack of ours */
+    QcomQmpOpen = 4,
+    QcomQmpSending = 5,      /* a message is in the mailbox, waiting for the AOP to take it */
+    QcomQmpBadDescriptor = -1,
+    QcomQmpBusy = -2,
+    QcomQmpTooLong = -3,
+};
+
+typedef struct {
+    volatile uint32_t *ram;  /* the message RAM (0x400 bytes on SM8550) */
+    uint32_t ram_bytes;
+    uint32_t box, box_size;  /* our mailbox inside it */
+    int state;
+    void (*kick)(void *context);
+    void *context;
+} QcomQmp;
+
+void qcom_qmp_init(QcomQmp *q, volatile uint32_t *ram, uint32_t ram_bytes, void (*kick)(void *), void *context);
+/* Advances the handshake or the pending send; returns the state reached. */
+int qcom_qmp_step(QcomQmp *q);
+/* Puts a message in the mailbox once the channel is open (QcomQmpSending), QcomQmpBusy otherwise. */
+int qcom_qmp_send(QcomQmp *q, const char *text);
+/* Gives up a send the AOP did not take before the owner's deadline: the mailbox is cleared. */
+void qcom_qmp_abandon(QcomQmp *q);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff -ruN a/package/QcomRpmh.c b/package/QcomRpmh.c
--- a/package/QcomRpmh.c	1970-01-01 05:30:00.000000000 +0530
+++ b/package/QcomRpmh.c	2026-11-26 20:00:56.122126022 +0530
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* From UniXNU-sheng package/QcomRpmh.c (BSD-2-Clause-Patent), unchanged; asteroids uses it for the touch rails. */
+#include "QcomRpmh.h"
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static int fits(size_t at, size_t length, size_t size) {return at <= size && length <= size - at;}
+
+/* Header: u32 version, u32 magic, 8 slave records of 16 bytes (u16 id, header offset, data offset, entry count, version, reserved[3]),
+ * u32 checksum, u32 reserved, then the data area the offsets count from (byte 144). Entries are 24 bytes: an 8-byte id, two u32
+ * priorities, u32 address, u16 aux length, u16 aux offset. */
+int qcom_cmd_db_find(const uint8_t *db, size_t bytes, const char *name, QcomRpmhResource *out)
+{
+    if (!db || !name || !out) return QcomRpmhArgument;
+    if (bytes < 144 || le32(db + 4) != QCOM_CMD_DB_MAGIC) return QcomRpmhNoDb;
+    char id[8] = {0};
+    for (unsigned i = 0; i < 8 && name[i]; ++i) id[i] = name[i];
+    for (unsigned s = 0; s < 8; ++s) {
+        const uint8_t *slave = db + 8 + 16 * s;
+        if (!le16(slave)) break;
+        const size_t heads = 144u + le16(slave + 2), data = 144u + le16(slave + 4), count = le16(slave + 6);
+        if (!fits(heads, count * 24, bytes)) return QcomRpmhCorrupt;
+        for (size_t e = 0; e < count; ++e) {
+            const uint8_t *entry = db + heads + 24 * e;
+            unsigned same = 1;
+            for (unsigned i = 0; i < 8 && same; ++i) same = entry[i] == (uint8_t)id[i];
+            if (!same) continue;
+            QcomRpmhResource r = {0};
+            r.address = le32(entry + 16);
+            const size_t length = le16(entry + 20), at = data + le16(entry + 22);
+            if (!r.address || !fits(at, length, bytes)) return QcomRpmhCorrupt;
+            for (size_t l = 0; l + 1 < length && r.level_count < QCOM_RPMH_MAX_LEVELS; l += 2) {
+                const uint16_t level = le16(db + at + l);
+                if (r.level_count && !level) break;  /* the list is zero padded */
+                r.levels[r.level_count++] = level;
+            }
+            *out = r;
+            return QcomRpmhOk;
+        }
+    }
+    return QcomRpmhMissing;
+}
+
+int qcom_rpmh_level_index(const QcomRpmhResource *r, uint32_t level, uint32_t *index)
+{
+    if (!r->level_count) return QcomRpmhNoLevel;
+    if (!level) {*index = 0; return QcomRpmhOk;}
+    for (unsigned i = 0; i < r->level_count; ++i)
+        if (r->levels[i] >= level) {*index = i; return QcomRpmhOk;}
+    *index = r->level_count - 1;
+    return QcomRpmhOk;
+}
+
+QcomRscLayout qcom_rsc_layout(uint32_t drv_id)
+{
+    if (((drv_id >> 16) & 0xff) >= 3) return (QcomRscLayout){672, 24, 0x04, 0x08, 0x20, 0x24, 0x28, 0x2c, 0x34, 0x38, 0x3c};
+    return (QcomRscLayout){672, 20, 0x04, 0x08, 0x10, 0x14, 0x18, 0x1c, 0x30, 0x34, 0x38};
+}
+
+#define MSGID_WRITE_RESPONSE (8u | 1u << 8 | 1u << 16)  /* 4-byte payload code, response requested, write */
+#define CONTROL_ACTIVE_MODE (1u << 16)
+#define CONTROL_TRIGGER (1u << 24)
+
+unsigned qcom_rpmh_active_request(const QcomRscLayout *l, unsigned tcs, const uint32_t *addresses, const uint32_t *values, unsigned count,
+                                  QcomRpmhWrite *w, unsigned capacity)
+{
+    if (!count || count > 4 || capacity < 3 * count + 6) return 0;
+    const uint32_t base = l->tcs_stride * tcs;
+    unsigned n = 0;
+    /* The control register is cleared before the TCS is reprogrammed, then set to active mode and only after that triggered. */
+    w[n++] = (QcomRpmhWrite){base + l->control, 0};
+    w[n++] = (QcomRpmhWrite){l->irq_clear, 1u << tcs};
+    for (unsigned c = 0; c < count; ++c) {
+        const uint32_t cmd = base + l->cmd_stride * c;
+        w[n++] = (QcomRpmhWrite){cmd + l->cmd_msgid, MSGID_WRITE_RESPONSE};
+        w[n++] = (QcomRpmhWrite){cmd + l->cmd_addr, addresses[c]};
+        w[n++] = (QcomRpmhWrite){cmd + l->cmd_data, values[c]};
+    }
+    const uint32_t mask = (1u << count) - 1;
+    w[n++] = (QcomRpmhWrite){base + l->wait_for_cmpl, mask};
+    w[n++] = (QcomRpmhWrite){base + l->cmd_enable, mask};
+    w[n++] = (QcomRpmhWrite){base + l->control, CONTROL_ACTIVE_MODE};
+    w[n++] = (QcomRpmhWrite){base + l->control, CONTROL_ACTIVE_MODE | CONTROL_TRIGGER};
+    return n;
+}
+
+unsigned qcom_rpmh_finish(const QcomRscLayout *l, unsigned tcs, QcomRpmhWrite *w, unsigned capacity)
+{
+    if (capacity < 3) return 0;
+    const uint32_t base = l->tcs_stride * tcs;
+    w[0] = (QcomRpmhWrite){l->irq_clear, 1u << tcs};
+    w[1] = (QcomRpmhWrite){base + l->control, 0};
+    w[2] = (QcomRpmhWrite){base + l->cmd_enable, 0};
+    return 3;
+}
diff -ruN a/package/QcomRpmh.h b/package/QcomRpmh.h
--- a/package/QcomRpmh.h	1970-01-01 05:30:00.000000000 +0530
+++ b/package/QcomRpmh.h	2026-11-26 20:00:56.170575031 +0530
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* From UniXNU-sheng package/QcomRpmh.h (BSD-2-Clause-Patent), unchanged. */
+/* RPMh for a remote processor's proxy votes: find a resource in the AOP command database (cmd-db) and turn a level into the index the
+ * ARC resource takes, and describe the register writes of one active-only request in a TCS of the application processor's RSC, for
+ * both register layouts (the RSC's major version 3 moved the TCS registers). Nothing here touches hardware: the owner applies the
+ * writes and waits for the TCS done interrupt. */
+#ifndef QCOM_RPMH_H
+#define QCOM_RPMH_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_CMD_DB_MAGIC 0x0c0330dbu
+#define QCOM_RPMH_MAX_LEVELS 16u
+
+typedef struct {
+    uint32_t address;
+    uint16_t levels[QCOM_RPMH_MAX_LEVELS];
+    unsigned level_count;
+} QcomRpmhResource;
+
+enum {QcomRpmhOk = 0, QcomRpmhNoDb = -1, QcomRpmhMissing = -2, QcomRpmhCorrupt = -3, QcomRpmhNoLevel = -4, QcomRpmhArgument = -5};
+
+/* Looks name (up to 8 characters) up in a copy of the command database; levels are the ARC's voltage levels (aux data) when it has
+ * them. */
+int qcom_cmd_db_find(const uint8_t *db, size_t bytes, const char *name, QcomRpmhResource *out);
+/* The ARC level index for a request of at least level (the highest index when level is above all of them; 0 turns the vote off). */
+int qcom_rpmh_level_index(const QcomRpmhResource *r, uint32_t level, uint32_t *index);
+
+typedef struct {uint32_t offset, value;} QcomRpmhWrite;
+
+/* The register layout of an RSC DRV; offsets are relative to the TCS block (DRV base + tcs-offset). */
+typedef struct {
+    uint32_t tcs_stride, cmd_stride, irq_status, irq_clear, wait_for_cmpl, control, status, cmd_enable, cmd_msgid, cmd_addr, cmd_data;
+} QcomRscLayout;
+
+/* The layout for a DRV whose id register reads drv_id (major version in bits 23:16). */
+QcomRscLayout qcom_rsc_layout(uint32_t drv_id);
+/* The writes of an active request of count (<= 4) data commands in TCS tcs, in order, ending with the trigger. Returns the number of
+ * writes, 0 on bad arguments. */
+unsigned qcom_rpmh_active_request(const QcomRscLayout *l, unsigned tcs, const uint32_t *addresses, const uint32_t *values, unsigned count,
+                                  QcomRpmhWrite *writes, unsigned capacity);
+/* The writes that return the TCS to idle after its done interrupt. */
+unsigned qcom_rpmh_finish(const QcomRscLayout *l, unsigned tcs, QcomRpmhWrite *writes, unsigned capacity);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff -ruN a/package/QcomScm.h b/package/QcomScm.h
--- a/package/QcomScm.h	1970-01-01 05:30:00.000000000 +0530
+++ b/package/QcomScm.h	2026-11-26 20:00:56.200885066 +0530
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Secure channel manager calls of the peripheral authentication service (PAS) in the SMCCC convention: the function id (standard call,
+ * SMC64, SiP owner, service 2) and the argument-type word in x1. The SMC itself lives in the kernel glue; these encoders are what the
+ * host tests check. */
+#ifndef QCOM_SCM_H
+#define QCOM_SCM_H
+#include <stdint.h>
+
+#define QCOM_SCM_SVC_PIL 0x02u
+#define QCOM_SCM_PAS_INIT_IMAGE 0x01u
+#define QCOM_SCM_PAS_MEM_SETUP 0x02u
+#define QCOM_SCM_PAS_AUTH_AND_RESET 0x05u
+#define QCOM_SCM_PAS_SHUTDOWN 0x06u
+#define QCOM_SCM_PAS_IS_SUPPORTED 0x07u
+#define QCOM_SCM_VAL 0u
+#define QCOM_SCM_RO 1u
+#define QCOM_SCM_RW 2u
+#define QCOM_SCM_INTERRUPTED 1    /* x0 of a call the secure world wants resumed (x6 carries its session) */
+#define QCOM_SCM_V2_EBUSY (-12)   /* busy: retry after a pause */
+
+static inline uint32_t qcom_scm_fn(uint32_t svc, uint32_t cmd)
+{
+    return (1u << 30) /* SMC64 */ | (2u << 24) /* SiP */ | ((svc & 0xff) << 8) | (cmd & 0xff);
+}
+/* Argument count in bits 3:0, the type of argument i in bits 5+2i:4+2i. */
+static inline uint32_t qcom_scm_args(unsigned count, unsigned t0, unsigned t1, unsigned t2)
+{
+    return (count & 0xf) | (t0 & 3) << 4 | (t1 & 3) << 6 | (t2 & 3) << 8;
+}
+
+/* IPCC (the inter-processor doorbells): a doorbell id is client << 16 | signal. */
+#define QCOM_IPCC_SEND 0x0cu
+#define QCOM_IPCC_RECV_ID 0x10u
+#define QCOM_IPCC_RECV_ENABLE 0x14u
+#define QCOM_IPCC_RECV_DISABLE 0x18u
+#define QCOM_IPCC_RECV_CLEAR 0x1cu
+#define QCOM_IPCC_NONE 0xffffffffu
+#define QCOM_IPCC_CLIENT_AOP 0u
+#define QCOM_IPCC_CLIENT_LPASS 3u
+#define QCOM_IPCC_SIGNAL_GLINK_QMP 0u
+#define QCOM_IPCC_SIGNAL_SMP2P 2u
+static inline uint32_t qcom_ipcc_id(uint32_t client, uint32_t signal) {return client << 16 | (signal & 0xffff);}
+
+#endif
diff -ruN a/package/QcomSmem.c b/package/QcomSmem.c
--- a/package/QcomSmem.c	1970-01-01 05:30:00.000000000 +0530
+++ b/package/QcomSmem.c	2026-11-26 20:00:56.302574620 +0530
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomSmem.h"
+
+#define TOC_MAGIC 0x434f5424u   /* "$TOC" */
+#define PART_MAGIC 0x54525024u  /* "$PRT" */
+#define CANARY 0xa5a5u
+#define TOC_HEADER 32u
+#define TOC_ENTRY 48u
+#define PART_HEADER 32u
+#define ENTRY 16u
+
+uint32_t qcom_smem_read32(const QcomSmem *smem, uint32_t offset) {return *(volatile uint32_t *)(smem->base + offset);}
+void qcom_smem_write32(const QcomSmem *smem, uint32_t offset, uint32_t value)
+{
+    *(volatile uint32_t *)(smem->base + offset) = value;
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dmb oshst" ::: "memory");
+#endif
+}
+static uint32_t rd(const QcomSmem *s, uint32_t at) {return qcom_smem_read32(s, at);}
+static int fits(uint64_t at, uint64_t length, uint64_t size) {return at <= size && length <= size - at;}
+static uint32_t align_up(uint32_t value, uint32_t to) {return (value + to - 1) & ~(to - 1);}
+
+int qcom_smem_partition(const QcomSmem *smem, uint16_t host, uint16_t remote, QcomSmemPartition *out)
+{
+    if (!smem || !smem->base || smem->size < 0x2000 || (smem->size & 0xfff)) return QcomSmemNoTable;
+    const uint32_t toc = smem->size - 0x1000;
+    if (rd(smem, toc) != TOC_MAGIC || rd(smem, toc + 4) != 1) return QcomSmemNoTable;
+    const uint32_t count = rd(smem, toc + 8);
+    if (count > (0x1000 - TOC_HEADER) / TOC_ENTRY) return QcomSmemNoTable;
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t e = toc + TOC_HEADER + i * TOC_ENTRY;
+        const uint32_t offset = rd(smem, e), size = rd(smem, e + 4), hosts = rd(smem, e + 12), cacheline = rd(smem, e + 16);
+        const uint16_t h0 = (uint16_t)hosts, h1 = (uint16_t)(hosts >> 16);
+        if (!offset || !size) continue;
+        if (!((h0 == host && h1 == remote) || (h0 == remote && h1 == host))) continue;
+        if (!fits(offset, size, toc) || size < PART_HEADER + 2 * ENTRY || (offset & 7)) return QcomSmemBadPartition;
+        if (cacheline & (cacheline - 1)) return QcomSmemBadPartition;
+        if (rd(smem, offset) != PART_MAGIC || rd(smem, offset + 4) != hosts || rd(smem, offset + 8) != size) return QcomSmemBadPartition;
+        const uint32_t free_uncached = rd(smem, offset + 12), free_cached = rd(smem, offset + 16);
+        if (free_uncached < PART_HEADER || free_uncached > free_cached || free_cached > size) return QcomSmemBadPartition;
+        *out = (QcomSmemPartition){offset, size, cacheline ? cacheline : 8u, h0, h1};
+        return QcomSmemOk;
+    }
+    return QcomSmemNoPartition;
+}
+
+/* Walks the uncached list; returns the offset (relative to the partition) where it ends, or the item's entry when found. */
+static int walk_uncached(const QcomSmem *smem, const QcomSmemPartition *p, uint16_t item, uint32_t *at_out, int *found)
+{
+    const uint32_t end = rd(smem, p->offset + 12);
+    uint32_t at = PART_HEADER;
+    *found = 0;
+    while (at < end) {
+        if (!fits(at, ENTRY, end)) return QcomSmemCorrupt;
+        const uint32_t w0 = rd(smem, p->offset + at), size = rd(smem, p->offset + at + 4), pads = rd(smem, p->offset + at + 8);
+        if ((w0 & 0xffff) != CANARY) return QcomSmemCorrupt;
+        const uint32_t padding_header = pads >> 16;
+        if ((uint64_t)at + ENTRY + padding_header + size > end) return QcomSmemCorrupt;
+        if ((w0 >> 16) == item) {*found = 1; *at_out = at; return QcomSmemOk;}
+        at += ENTRY + padding_header + size;
+    }
+    if (at != end) return QcomSmemCorrupt;
+    *at_out = at;
+    return QcomSmemOk;
+}
+
+int qcom_smem_find(const QcomSmem *smem, const QcomSmemPartition *p, uint16_t item, uint32_t *offset, uint32_t *size)
+{
+    uint32_t at;
+    int found, rc = walk_uncached(smem, p, item, &at, &found);
+    if (rc) return rc;
+    if (found) {
+        const uint32_t bytes = rd(smem, p->offset + at + 4), pads = rd(smem, p->offset + at + 8);
+        if ((pads & 0xffff) > bytes) return QcomSmemCorrupt;
+        *offset = p->offset + at + ENTRY + (pads >> 16);
+        *size = bytes - (pads & 0xffff);
+        return QcomSmemOk;
+    }
+    /* Cached items: each entry sits at the end of its cache line slot, its data right below it. */
+    const uint32_t header = align_up(ENTRY, p->cacheline), last = rd(smem, p->offset + 16);
+    if (p->size < header) return QcomSmemCorrupt;
+    uint32_t e = p->size - header;
+    while (e > last) {
+        const uint32_t w0 = rd(smem, p->offset + e), bytes = rd(smem, p->offset + e + 4), pads = rd(smem, p->offset + e + 8);
+        if ((w0 & 0xffff) != CANARY || bytes > e || (pads & 0xffff) > bytes) return QcomSmemCorrupt;
+        if ((w0 >> 16) == item) {*offset = p->offset + e - bytes; *size = bytes - (pads & 0xffff); return QcomSmemOk;}
+        if (e < bytes + header) return QcomSmemCorrupt;
+        e -= bytes + header;
+    }
+    return QcomSmemMissing;
+}
+
+int qcom_smem_alloc(const QcomSmem *smem, const QcomSmemPartition *p, uint16_t item, uint32_t size)
+{
+    uint32_t at;
+    int found, rc = walk_uncached(smem, p, item, &at, &found);
+    if (rc) return rc;
+    if (found) return QcomSmemExists;
+    uint32_t offset, bytes;
+    if (qcom_smem_find(smem, p, item, &offset, &bytes) == QcomSmemOk) return QcomSmemExists;
+    const uint32_t aligned = align_up(size, 8), need = ENTRY + aligned;
+    if (!size || aligned < size || (uint64_t)at + need > rd(smem, p->offset + 16)) return QcomSmemNoSpace;
+    qcom_smem_write32(smem, p->offset + at, CANARY | (uint32_t)item << 16);
+    qcom_smem_write32(smem, p->offset + at + 4, aligned);
+    qcom_smem_write32(smem, p->offset + at + 8, aligned - size);  /* padding_data, padding_header 0 */
+    qcom_smem_write32(smem, p->offset + at + 12, 0);
+    for (uint32_t i = 0; i < aligned; i += 4) qcom_smem_write32(smem, p->offset + at + ENTRY + i, 0);
+    /* The entry is complete before the free mark moves over it. */
+    qcom_smem_write32(smem, p->offset + 12, at + need);
+    return QcomSmemOk;
+}
diff -ruN a/package/QcomSmem.h b/package/QcomSmem.h
--- a/package/QcomSmem.h	1970-01-01 05:30:00.000000000 +0530
+++ b/package/QcomSmem.h	2026-11-26 20:00:56.351923372 +0530
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Qualcomm shared memory (SMEM): the partition table at the end of the region, the private partitions two processors share, and the
+ * items in them (uncached ones growing up from the partition header, cached ones down from its end). Every access is an aligned 32-bit
+ * one, so the code works on a device mapping. Allocation must run with the hardware mutex held (the caller takes it); nothing here
+ * waits. */
+#ifndef QCOM_SMEM_H
+#define QCOM_SMEM_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_SMEM_HOST_APPS 0u
+#define QCOM_SMEM_HOST_GLOBAL 0xfffeu
+
+typedef struct {
+    volatile uint8_t *base;
+    uint32_t size;
+} QcomSmem;
+
+typedef struct {
+    uint32_t offset, size, cacheline;  /* offset of the partition header from the SMEM base */
+    uint16_t host0, host1;
+} QcomSmemPartition;
+
+enum {
+    QcomSmemOk = 0,
+    QcomSmemNoTable = -1,
+    QcomSmemNoPartition = -2,
+    QcomSmemBadPartition = -3,
+    QcomSmemCorrupt = -4,
+    QcomSmemExists = -5,
+    QcomSmemNoSpace = -6,
+    QcomSmemMissing = -7,
+};
+
+/* The partition shared by the two hosts (QCOM_SMEM_HOST_GLOBAL twice for the global one). */
+int qcom_smem_partition(const QcomSmem *smem, uint16_t host, uint16_t remote, QcomSmemPartition *out);
+/* Offset of the item's data from the SMEM base and its size; QcomSmemMissing when the item is not there. */
+int qcom_smem_find(const QcomSmem *smem, const QcomSmemPartition *part, uint16_t item, uint32_t *offset, uint32_t *size);
+/* Allocates an uncached item of size bytes (rounded up to 8). QcomSmemExists if it is there already (not an error for callers that
+ * only need it to exist). Hardware mutex held by the caller. */
+int qcom_smem_alloc(const QcomSmem *smem, const QcomSmemPartition *part, uint16_t item, uint32_t size);
+
+uint32_t qcom_smem_read32(const QcomSmem *smem, uint32_t offset);
+void qcom_smem_write32(const QcomSmem *smem, uint32_t offset, uint32_t value);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff -ruN a/package/QcomSmp2p.c b/package/QcomSmp2p.c
--- a/package/QcomSmp2p.c	1970-01-01 05:30:00.000000000 +0530
+++ b/package/QcomSmp2p.c	2026-11-26 20:00:56.482574062 +0530
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomSmp2p.h"
+
+/* Word offsets: 0 magic, 1 version (bits 7:0) and features (31:8), 2 local pid (15:0) and remote pid (31:16), 3 total entries (15:0)
+ * and valid entries (31:16), 4 flags, then 5 words per entry: a 16-byte name and the value. */
+#define W_VERSION 1
+#define W_PIDS 2
+#define W_COUNTS 3
+#define W_FLAGS 4
+#define W_ENTRY(i) (5 + 5 * (i))
+
+static void barrier(void)
+{
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dmb oshst" ::: "memory");
+#endif
+}
+/* Names are stored as Linux's smp2p.c stores them (strscpy into 16 bytes): at most 15 characters and a NUL, so a longer name such as
+ * "wlan_ep_power_save" is "wlan_ep_power_s" in the item. */
+static int same_name(const volatile uint32_t *entry, const char *name)
+{
+    for (unsigned i = 0; i < 16; ++i) {
+        const char c = (char)(entry[i / 4] >> (8 * (i % 4)));
+        const char want = i < 15 ? name[i] : 0;
+        if (c != want) return 0;
+        if (!c) return 1;
+    }
+    return 0;
+}
+
+void qcom_smp2p_init_out(QcomSmp2p *s, volatile uint32_t *out, uint16_t local_pid, uint16_t remote_pid)
+{
+    *s = (QcomSmp2p){0};
+    s->out = out;
+    s->local_pid = local_pid;
+    s->remote_pid = remote_pid;
+    for (unsigned i = 0; i < QCOM_SMP2P_ITEM_BYTES / 4; ++i) out[i] = 0;
+    barrier();
+    out[0] = QCOM_SMP2P_MAGIC;
+    out[W_PIDS] = local_pid | (uint32_t)remote_pid << 16;
+    out[W_COUNTS] = QCOM_SMP2P_MAX_ENTRIES;
+    barrier();
+    out[W_VERSION] = QCOM_SMP2P_VERSION | QCOM_SMP2P_FEATURE_SSR_ACK << 8;
+    barrier();
+}
+
+int qcom_smp2p_add_entry(QcomSmp2p *s, const char *name)
+{
+    const uint32_t valid = s->out[W_COUNTS] >> 16;
+    if (valid >= QCOM_SMP2P_MAX_ENTRIES) return -1;
+    uint32_t words[4] = {0};
+    for (unsigned i = 0; i < 15 && name[i]; ++i) words[i / 4] |= (uint32_t)(uint8_t)name[i] << (8 * (i % 4));
+    for (unsigned i = 0; i < 4; ++i) s->out[W_ENTRY(valid) + i] = words[i];
+    s->out[W_ENTRY(valid) + 4] = 0;
+    barrier();
+    s->out[W_COUNTS] = QCOM_SMP2P_MAX_ENTRIES | (valid + 1) << 16;
+    barrier();
+    return (int)valid;
+}
+
+int qcom_smp2p_update(QcomSmp2p *s, int index, uint32_t mask, uint32_t value)
+{
+    volatile uint32_t *v = &s->out[W_ENTRY(index) + 4];
+    const uint32_t old = *v, next = (old & ~mask) | (value & mask);
+    if (next == old) return 0;
+    *v = next;
+    barrier();
+    return 1;
+}
+
+uint32_t qcom_smp2p_out_value(const QcomSmp2p *s, int index) {return s->out[W_ENTRY(index) + 4];}
+
+int qcom_smp2p_check_in(const volatile uint32_t *in, uint16_t local_pid, uint16_t remote_pid)
+{
+    if (!in || in[0] != QCOM_SMP2P_MAGIC) return -1;
+    if ((in[W_VERSION] & 0xff) != QCOM_SMP2P_VERSION) return -2;
+    /* The remote writes its own pid as local. */
+    if (in[W_PIDS] != (remote_pid | (uint32_t)local_pid << 16)) return -3;
+    const uint32_t counts = in[W_COUNTS];
+    if ((counts & 0xffff) > QCOM_SMP2P_MAX_ENTRIES || (counts >> 16) > (counts & 0xffff)) return -4;
+    return 0;
+}
+
+int qcom_smp2p_find_in(const QcomSmp2p *s, const char *name)
+{
+    if (!s->in) return -1;
+    const uint32_t valid = s->in[W_COUNTS] >> 16;
+    for (uint32_t i = 0; i < valid && i < QCOM_SMP2P_MAX_ENTRIES; ++i)
+        if (same_name(&s->in[W_ENTRY(i)], name)) return (int)i;
+    return -1;
+}
+
+uint32_t qcom_smp2p_in_value(const QcomSmp2p *s, int index) {return s->in[W_ENTRY(index) + 4];}
+
+int qcom_smp2p_service(QcomSmp2p *s, const char *entry, uint32_t *value, uint32_t *changed)
+{
+    int ring = 0;
+    *value = 0;
+    *changed = 0;
+    if (qcom_smp2p_check_in(s->in, s->local_pid, s->remote_pid)) return 0;
+    if (!s->negotiated) {
+        const uint32_t ours = s->out[W_VERSION], theirs = s->in[W_VERSION];
+        if ((ours & 0xff) == (theirs & 0xff)) {
+            const uint32_t features = (ours >> 8) & (theirs >> 8);
+            if (features != ours >> 8) {s->out[W_VERSION] = (ours & 0xff) | features << 8; barrier(); ring = 1;}
+            s->ssr_ack_enabled = (features & QCOM_SMP2P_FEATURE_SSR_ACK) != 0;
+            s->negotiated = 1;
+        }
+    }
+    if (s->ssr_ack_enabled) {
+        const uint8_t done = (s->in[W_FLAGS] & QCOM_SMP2P_FLAG_RESTART_DONE) != 0;
+        if (done != s->ssr_acked) {
+            s->ssr_acked = done;
+            const uint32_t flags = s->out[W_FLAGS];
+            s->out[W_FLAGS] = done ? flags | QCOM_SMP2P_FLAG_RESTART_ACK : flags & ~QCOM_SMP2P_FLAG_RESTART_ACK;
+            barrier();
+            ring = 1;
+        }
+    }
+    const int index = qcom_smp2p_find_in(s, entry);
+    if (index >= 0) {
+        const uint32_t now = qcom_smp2p_in_value(s, index);
+        *value = now;
+        *changed = now ^ s->last[index];
+        s->last[index] = now;
+    }
+    return ring;
+}
diff -ruN a/package/QcomSmp2p.h b/package/QcomSmp2p.h
--- a/package/QcomSmp2p.h	1970-01-01 05:30:00.000000000 +0530
+++ b/package/QcomSmp2p.h	2026-11-26 20:00:56.626859253 +0530
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Shared memory point-to-point state (SMP2P): each side owns one SMEM item holding named 32-bit entries the other side watches; a change
+ * is signalled with a doorbell. This is the item layout and the bookkeeping for both directions: our outbound item (entries we set bits
+ * in) and the remote's inbound item (entries whose bit changes become events). Doorbells and SMEM placement belong to the caller. */
+#ifndef QCOM_SMP2P_H
+#define QCOM_SMP2P_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_SMP2P_MAGIC 0x504d5324u  /* "$SMP" */
+#define QCOM_SMP2P_VERSION 1u
+#define QCOM_SMP2P_FEATURE_SSR_ACK 1u
+#define QCOM_SMP2P_FLAG_RESTART_DONE 1u
+#define QCOM_SMP2P_FLAG_RESTART_ACK 2u
+#define QCOM_SMP2P_MAX_ENTRIES 16u
+#define QCOM_SMP2P_ITEM_BYTES (20u + 20u * QCOM_SMP2P_MAX_ENTRIES)
+
+/* The two items' storage: 32-bit aligned, possibly device memory. */
+typedef struct {
+    volatile uint32_t *out, *in;  /* in may be null until the remote has made it */
+    uint16_t local_pid, remote_pid;
+    uint8_t negotiated, ssr_ack_enabled, ssr_acked;
+    uint32_t last[QCOM_SMP2P_MAX_ENTRIES];  /* inbound values last seen, by inbound entry index */
+    uint32_t seen_entries;
+} QcomSmp2p;
+
+/* Writes a fresh outbound item (zeroes, header, then the version word last so the remote never sees a half-made item). */
+void qcom_smp2p_init_out(QcomSmp2p *s, volatile uint32_t *out, uint16_t local_pid, uint16_t remote_pid);
+/* Adds a named outbound entry and returns its index, or -1 when full. */
+int qcom_smp2p_add_entry(QcomSmp2p *s, const char *name);
+/* Sets the bits in mask of outbound entry index to value; returns 1 when the value changed (ring the doorbell). */
+int qcom_smp2p_update(QcomSmp2p *s, int index, uint32_t mask, uint32_t value);
+uint32_t qcom_smp2p_out_value(const QcomSmp2p *s, int index);
+
+/* Validates an inbound item (magic, version, the pids seen from the other side); 0 when usable. */
+int qcom_smp2p_check_in(const volatile uint32_t *in, uint16_t local_pid, uint16_t remote_pid);
+/* Index of the named inbound entry, -1 when the remote has not added it. */
+int qcom_smp2p_find_in(const QcomSmp2p *s, const char *name);
+uint32_t qcom_smp2p_in_value(const QcomSmp2p *s, int index);
+
+/* Called on every doorbell from the remote. Agrees on the features once, answers a restart with the restart ack flag, and reports the
+ * bits of the named inbound entry that changed since the last call (changed) and its current value (value). Returns 1 when our item
+ * changed so the remote has to be rung. */
+int qcom_smp2p_service(QcomSmp2p *s, const char *entry, uint32_t *value, uint32_t *changed);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff -ruN a/package/RuanAdsp.cpp b/package/RuanAdsp.cpp
--- a/package/RuanAdsp.cpp	1970-01-01 05:30:00.000000000 +0530
+++ b/package/RuanAdsp.cpp	2026-11-26 20:03:38.561964740 +0530
@@ -0,0 +1,445 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// ruan-adsp=N (macOS): stage (a) of auto-rotate, the audio DSP (ADSP, LPASS Hexagon) of the Redmi Pad Pro 5G (SM7435 "parrot") booted
+// through TrustZone PAS. The sensor core (SSC, the accelerometer) runs on it. NOT BUILT, NOT BOOTED (adsp-sensors/README.md).
+//
+// Source: iPadOS package/RuanAdsp.cpp (UniXNU-sheng AdspProbe.cpp ported to ruan, audio port), cut to the boot, with the WPSS host's
+// proven-on-ruan pieces (RuanWifiWpss.cpp, Wi-Fi up on rbu169p: same SMEM/IPCC/AOSS/RSC/cmd-db/PAS path and the same Qcom* helpers):
+//   - every SMC holds hakios_spmi_lock (RuanInput.c): TrustZone calls must not overlap SPMI arbiter traffic (buttons/battery), and the
+//     GPU zap's scmCall (RuanAdrenoGlue.cpp) takes the same lock, so PAS calls of the two never interleave either;
+//   - polled, no SPI attached (RuanWifiWpss.cpp's way): IPCC and RSC looked at every 2 ms while booting, every 500 ms once up;
+//   - ruan-adsp-order=1 writes the segments before init_image (the A710 zap needed it, RuanAdrenoGlue.cpp gpu-zap=9); default 0 is
+//     Linux's order, which brought the WPSS up on ruan;
+//   - the image: modem_a's image/adsp.b00.. in place (AdspFirmware.c + FatVolume.c through NativeUfs's native_ufs_part_*), else
+//     ruan-adsp-fw=DIR/adsp.mbn on a mounted volume. NON-HLOS also has adsp2.* chosen by the qfprom adsp_variant fuse (DT
+//     qcom,msm-adsp-loader: fuse 0x221c8117 bits 2..7 == 4 -> adsp2.mdt); ruan-adsp-img=2 forces adsp2, ruan-adsp-fuse=1 reads the fuse.
+// No GLINK yet (stage b): once up the DSP is left running and only its SMP2P state is watched (a fatal is recorded with its reason).
+//
+// ruan values, live DT ruan-live.dts (line): remoteproc-adsp@03000000 "qcom,parrot-adsp-pas" (7625), PAS 1, adsp_region@9a200000 +
+// 0x2900000 (140; adsp.mdt spans exactly 0x2900000, relocatable), cx lcx.lvl / mx lmx.lvl at level 384 (5265, 5390), AOSS qmp,
+// smp2p-adsp (6294) smem 443 in / 429 out, remote pid 2, IPCC client 3 signal 2 (SMP2P) / 0 (glink-edge "lpass", 7650). SMEM
+// 0x80900000+2M, TCSR mutex 3, IPCC 0xed18000, AOSS 0xc300000, RSC DRV2 0x17a20000/+0xd00 (TCS 1; RuanTouch.c owns TCS 0), cmd-db
+// 0x80860000, PAS metadata fallback mpss_region 0x8bc00000 (the modem is never started): RuanWifiWpss.cpp (same DT).
+//
+// Boot arguments: ruan-adsp=1 survey (reads only), 2 boot; ruan-adsp-delay=S (default 20 s after boot_progress_start: IOKit and
+// NativeUfs up), ruan-adsp-order, ruan-adsp-img, ruan-adsp-fuse, ruan-adsp-fw. Without ruan-adsp nothing here runs. USB `adsp`.
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IODeviceMemory.h>
+#include <kern/thread.h>
+#include <sys/errno.h>
+#include <pexpert/pexpert.h>
+extern "C" {
+#include "QcomMdt.h"
+#include "QcomQmp.h"
+#include "QcomRpmh.h"
+#include "QcomScm.h"
+#include "QcomSmem.h"
+#include "QcomSmp2p.h"
+int sheng_fw_open(const char *path, void **handle, uint64_t *size);   // AdspFirmware.c
+int sheng_fw_read(void *handle, uint64_t offset, void *to, size_t length);
+void sheng_fw_close(void *handle);
+void hakios_spmi_lock(void);     // RuanInput.c
+void hakios_spmi_unlock(void);
+}
+#include "RuanZap.h"   // ruan_smc_call
+
+// [0] stage (negative: the step that failed), [1] its error, [2] doorbells seen, [3] slave-kernel bits (-1 no item), [4] items (bit 0
+// SMP2P in 443, 1 out 429, 8 our partition, 9 global), [5] QMP state | AOSS link bits << 8, [6] RSC DRV id, [7] image KiB, [8] ms from
+// auth_and_reset to ready, [9] last SCM x0, [10] its x1, [11] votes lcx | lmx << 8 | no-done << 15, [12] adsp_variant fuse (-1 unread),
+// [13] image (1 adsp, 2 adsp2), [14] metadata 0 kernel page / 1 fixed, [15] fatal count
+extern "C" {volatile int32_t ruan_adsp_stats[16]; char ruan_adsp_text[96];}
+
+namespace {
+enum Stage {StMapped = 1, StSurveyed = 2, StFirmware = 3, StSmp2p = 4, StLoadState = 5, StRails = 6, StLoaded = 7, StStarted = 8, StReady = 9};
+constexpr uint64_t kSmem = 0x80900000, kSmemSize = 0x200000, kMutex = 0x1f40000 + 3 * 0x1000, kIpcc = 0xed18000, kAoss = 0xc300000;
+constexpr uint64_t kRscDrv = 0x17a20000, kRscTcs = 0xd00, kCmdDb = 0x80860000, kCmdDbSize = 0x20000, kMetaPa = 0x8bc00000;
+constexpr uint64_t kAdspBase = 0x9a200000, kAdspSize = 0x2900000, kQfprom = 0x221c8000, kVariantWord = 0x114;
+constexpr uint32_t kPasAdsp = 1, kRemotePid = 2, kItemIn = 443, kItemOut = 429, kItemCrash = 423, kLevel = 384, kTcs = 1;
+constexpr uint32_t kFatal = 1u << 0, kReady = 1u << 1, kHandover = 1u << 2;
+
+struct Window {IOMemoryMap *map; volatile uint8_t *va;};
+bool mapWindow(Window &w, uint64_t base, uint64_t size, IOOptionBits cache = kIOMapInhibitCache) {
+    IODeviceMemory *memory = IODeviceMemory::withRange(base, size);
+    w.map = memory ? memory->map(kIOMapAnywhere | cache) : nullptr;
+    if (memory) memory->release();
+    w.va = w.map ? reinterpret_cast<volatile uint8_t *>(w.map->getVirtualAddress()) : nullptr;
+    return w.va != nullptr;
+}
+void unmap(Window &w) {if (w.map) w.map->release(); w = {};}
+uint32_t rd(const Window &w, uint64_t at) {return *reinterpret_cast<volatile uint32_t *>(w.va + at);}
+void wr(const Window &w, uint64_t at, uint32_t value) {*reinterpret_cast<volatile uint32_t *>(w.va + at) = value; __asm__ volatile("dsb sy" ::: "memory");}
+void fail(int step, int error) {ruan_adsp_stats[1] = error; ruan_adsp_stats[0] = -step;}
+void stage(int value) {ruan_adsp_stats[0] = value;}
+void note(const char *prefix, const char *text) {snprintf(ruan_adsp_text, sizeof ruan_adsp_text, "%s%s", prefix, text);}
+
+Window gSmemW, gMutex, gIpcc, gAoss, gRsc;
+QcomSmem gSmem;
+QcomSmemPartition gPart;
+QcomSmp2p gP2p;
+QcomQmp gQmp;
+QcomRscLayout gLayout;
+QcomRpmhResource gLcx, gLmx;
+uint32_t gSlave;
+bool gHandedOver;
+
+// ---- doorbells, polled: drain the latched ids (only ours are enabled), then sleep ----
+uint32_t gPollMs = 2;
+void kickAop(void *) {wr(gIpcc, QCOM_IPCC_SEND, qcom_ipcc_id(QCOM_IPCC_CLIENT_AOP, QCOM_IPCC_SIGNAL_GLINK_QMP));}
+void kickSmp2p() {wr(gIpcc, QCOM_IPCC_SEND, qcom_ipcc_id(QCOM_IPCC_CLIENT_LPASS, QCOM_IPCC_SIGNAL_SMP2P));}
+void drainIpcc() {
+    for (unsigned n = 0; n < 32; ++n) {
+        const uint32_t id = rd(gIpcc, QCOM_IPCC_RECV_ID);
+        if (id == QCOM_IPCC_NONE) break;
+        wr(gIpcc, QCOM_IPCC_RECV_CLEAR, id);
+        ruan_adsp_stats[2] = ruan_adsp_stats[2] + 1;
+    }
+}
+
+// ---- SMEM (allocation under the TCSR hardware mutex) ----
+bool lockSmem() {
+    for (unsigned i = 0; i < 1000; ++i) {
+        wr(gMutex, 0, 1);
+        if (rd(gMutex, 0) == 1) return true;
+        IODelay(10);
+    }
+    return false;
+}
+volatile uint8_t *item(uint16_t id) {
+    uint32_t at = 0, bytes = 0;
+    return qcom_smem_find(&gSmem, &gPart, id, &at, &bytes) ? nullptr : gSmemW.va + at;
+}
+int allocItem(uint16_t id, uint32_t size) {
+    if (!lockSmem()) return -16;
+    const int rc = qcom_smem_alloc(&gSmem, &gPart, id, size);
+    wr(gMutex, 0, 0);
+    return rc == QcomSmemExists ? 0 : rc;
+}
+void readCrashReason() {
+    QcomSmemPartition global;
+    uint32_t at = 0, size = 0;
+    if (qcom_smem_partition(&gSmem, QCOM_SMEM_HOST_GLOBAL, QCOM_SMEM_HOST_GLOBAL, &global) ||
+        qcom_smem_find(&gSmem, &global, kItemCrash, &at, &size) || !size)
+        return;
+    char text[80];
+    size_t n = 0;
+    for (; n < sizeof text - 1 && n < size; ++n) {const char c = (char)gSmemW.va[at + n]; if (!c) break; text[n] = c >= 32 && c < 127 ? c : '.';}
+    text[n] = 0;
+    if (n) note("crash: ", text);
+}
+
+// ---- the survey (reads only) ----
+void survey(bool fuse) {
+    int32_t bits = 0;
+    if (!qcom_smem_partition(&gSmem, QCOM_SMEM_HOST_APPS, kRemotePid, &gPart)) {
+        bits |= 1 << 8;
+        if (item(kItemIn)) bits |= 1;
+        if (item(kItemOut)) bits |= 2;
+    }
+    QcomSmemPartition global;
+    if (!qcom_smem_partition(&gSmem, QCOM_SMEM_HOST_GLOBAL, QCOM_SMEM_HOST_GLOBAL, &global)) bits |= 1 << 9;
+    ruan_adsp_stats[4] = bits;
+    ruan_adsp_stats[3] = -1;
+    if (volatile uint8_t *in = item(kItemIn)) {
+        QcomSmp2p view = {};
+        view.in = reinterpret_cast<volatile uint32_t *>(in);
+        view.remote_pid = kRemotePid;
+        const int index = qcom_smp2p_check_in(view.in, 0, kRemotePid) ? -1 : qcom_smp2p_find_in(&view, "slave-kernel");
+        if (index >= 0) ruan_adsp_stats[3] = (int32_t)qcom_smp2p_in_value(&view, index);
+    }
+    const uint32_t up = 0xffff;
+    ruan_adsp_stats[5] = (rd(gAoss, 0) == 0x4d41494cu ? 1 : 0) << 12 | (rd(gAoss, 0xc) == up) << 8 | (rd(gAoss, 0x24) == up) << 9 |
+                         (rd(gAoss, 0x14) == up) << 10 | (rd(gAoss, 0x2c) == up) << 11;
+    ruan_adsp_stats[6] = (int32_t)rd(gRsc, 0);
+    ruan_adsp_stats[12] = -1;
+    Window q = {};
+    if (fuse && mapWindow(q, kQfprom, 0x1000)) {   // shortcut: opt-in, a secure-locked fuse read would be an external abort
+        ruan_adsp_stats[12] = (int32_t)((rd(q, kVariantWord) >> 26) & 0x3f);   // byte 0x117, bits 2..7
+        unmap(q);
+    }
+    readCrashReason();
+}
+
+// ---- secure calls: resumed when interrupted, retried when busy; the SPMI lock is held per call, never across the busy pause ----
+struct ScmResult {int64_t x0; uint64_t x1;};
+ScmResult scm(uint32_t command, uint32_t arginfo, uint64_t a, uint64_t b, uint64_t c) {
+    ScmResult result = {-1, 0};
+    for (unsigned busy = 0; busy < 20; ++busy) {
+        uint64_t function = qcom_scm_fn(QCOM_SCM_SVC_PIL, command), session = 0;
+        hakios_spmi_lock();
+        for (unsigned resumes = 0;; ++resumes) {
+            uint64_t r[8] = {function, arginfo, a, b, c, 0, session, 0};
+            ruan_smc_call(r);
+            result = {(int64_t)r[0], r[1]};
+            if (result.x0 != QCOM_SCM_INTERRUPTED || resumes > 100000) break;
+            function = QCOM_SCM_INTERRUPTED;
+            session = r[6];
+        }
+        hakios_spmi_unlock();
+        if (result.x0 != QCOM_SCM_V2_EBUSY) break;
+        IOSleep(30);
+    }
+    ruan_adsp_stats[9] = (int32_t)result.x0;
+    ruan_adsp_stats[10] = (int32_t)result.x1;
+    return result;
+}
+bool scmOk(const ScmResult &r) {return r.x0 == 0 && r.x1 == 0;}
+
+// ---- RPMh proxy votes for LCX/LMX through active TCS 1 (bounded wait for its done bit, as RuanWifiWpss.cpp) ----
+int vote(uint32_t level) {
+    uint32_t lcx = 0, lmx = 0;
+    if (qcom_rpmh_level_index(&gLcx, level, &lcx) || qcom_rpmh_level_index(&gLmx, level, &lmx)) return -22;
+    const uint32_t addresses[2] = {gLcx.address, gLmx.address}, values[2] = {lcx, lmx};
+    QcomRpmhWrite writes[16];
+    const unsigned n = qcom_rpmh_active_request(&gLayout, kTcs, addresses, values, 2, writes, 16);
+    if (!n) return -22;
+    for (unsigned i = 0; i < n; ++i) wr(gRsc, kRscTcs + writes[i].offset, writes[i].value);
+    bool done = false;
+    for (unsigned t = 0; t < 100 && !done; ++t) {done = rd(gRsc, kRscTcs + gLayout.irq_status) & (1u << kTcs); if (!done) IOSleep(1);}
+    if (done) wr(gRsc, kRscTcs + gLayout.irq_clear, 1u << kTcs);
+    const unsigned m = qcom_rpmh_finish(&gLayout, kTcs, writes, 16);
+    for (unsigned i = 0; i < m; ++i) wr(gRsc, kRscTcs + writes[i].offset, writes[i].value);
+    ruan_adsp_stats[11] = (int32_t)(lcx | lmx << 8 | (done ? 0 : 1u << 15));
+    return 0;
+}
+
+// ---- the image: parsed from its file, metadata to TrustZone, segments into the carveout ----
+struct Image {void *file; uint64_t size; QcomMdtImage mdt; IOBufferMemoryDescriptor *meta;};
+Image gImage;   // static: the header table is a few KiB, off the 16 KiB kernel stack
+int fileRead(void *context, uint64_t offset, void *to, size_t length) {return sheng_fw_read(context, offset, to, length);}
+void release(Image &image) {
+    if (image.file) sheng_fw_close(image.file);
+    if (image.meta) image.meta->release();
+    image.file = nullptr; image.meta = nullptr;
+}
+void cleanToPoc(const void *start, size_t length) {
+    uint64_t ctr;
+    __asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+    const uintptr_t line = static_cast<uintptr_t>(4) << ((ctr >> 16) & 15);
+    for (uintptr_t a = reinterpret_cast<uintptr_t>(start) & ~(line - 1); a < reinterpret_cast<uintptr_t>(start) + length; a += line)
+        __asm__ volatile("dc civac, %0" :: "r"(a) : "memory");
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+// init_image with the metadata in contiguous memory (one kernel allocation, else the fixed low pages), then mem_setup.
+int authenticateHeader(Image &image) {
+    const uint64_t bytes = qcom_mdt_metadata_size(&image.mdt);
+    uint64_t phys = 0;
+    image.meta = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task, (IOOptionBits)kIODirectionInOut |
+                                                                  (IOOptionBits)kIOMemoryPhysicallyContiguous, bytes, 0x0000fffffffff000ull);
+    if (image.meta && image.meta->prepare() == kIOReturnSuccess) {
+        uint8_t *va = static_cast<uint8_t *>(image.meta->getBytesNoCopy());
+        if (qcom_mdt_metadata(&image.mdt, fileRead, image.file, va, bytes)) return -5;
+        cleanToPoc(va, bytes);
+        phys = image.meta->getPhysicalSegment(0, nullptr, kIOMemoryMapperNone);
+    } else if (image.meta) {
+        image.meta->release();
+        image.meta = nullptr;
+    }
+    if (!phys) {   // contiguous allocations over one page fail on ruan: the fixed low pages, byte stores into Device memory
+        const uint64_t span = (bytes + 0xfff) & ~0xfffull;
+        uint8_t *bounce = static_cast<uint8_t *>(IOMallocData(bytes));
+        Window fixed = {};
+        if (!bounce || !mapWindow(fixed, kMetaPa, span)) {if (bounce) IOFreeData(bounce, bytes); return -12;}
+        const int rc = qcom_mdt_metadata(&image.mdt, fileRead, image.file, bounce, bytes);
+        for (uint64_t i = 0; !rc && i < bytes; ++i) fixed.va[i] = bounce[i];
+        __asm__ volatile("dsb sy" ::: "memory");
+        IOFreeData(bounce, bytes);
+        unmap(fixed);   // TrustZone reads it during init_image only
+        if (rc) return -5;
+        phys = kMetaPa;
+        ruan_adsp_stats[14] = 1;
+    }
+    if (!scmOk(scm(QCOM_SCM_PAS_INIT_IMAGE, qcom_scm_args(2, QCOM_SCM_VAL, QCOM_SCM_RW, 0), kPasAdsp, phys, 0))) return -1;
+    if (image.mdt.relocatable &&
+        !scmOk(scm(QCOM_SCM_PAS_MEM_SETUP, qcom_scm_args(3, 0, 0, 0), kPasAdsp, kAdspBase, qcom_mdt_span(&image.mdt))))
+        return -2;
+    return 0;
+}
+int loadSegments(Image &image) {
+    Window region = {};
+    if (!mapWindow(region, kAdspBase, kAdspSize, kIOMapWriteCombineCache)) return -12;
+    constexpr size_t kChunk = 256 * 1024;
+    uint8_t *bounce = static_cast<uint8_t *>(IOMallocData(kChunk));
+    int rc = bounce ? 0 : -12;
+    for (unsigned i = 0; !rc && i < image.mdt.count; ++i) {
+        const QcomMdtSegment &s = image.mdt.segment[i];
+        uint64_t at = 0;
+        if (!s.load) continue;
+        if (qcom_mdt_place(&image.mdt, i, kAdspBase, kAdspSize, &at)) {rc = -7; break;}
+        volatile uint8_t *to = region.va + at;
+        for (uint64_t done = 0; !rc && done < s.file_size;) {
+            const size_t n = s.file_size - done < kChunk ? (size_t)(s.file_size - done) : kChunk;
+            if (sheng_fw_read(image.file, s.file_offset + done, bounce, n)) {rc = -5; break;}
+            for (size_t k = 0; k < n; ++k) to[done + k] = bounce[k];
+            done += n;
+        }
+        for (uint64_t k = s.file_size; !rc && k < s.memory_size; ++k) to[k] = 0;
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+    if (bounce) IOFreeData(bounce, kChunk);
+    unmap(region);
+    return rc;
+}
+
+// ---- SMP2P: the DSP's "slave-kernel" bits ----
+void serviceSmp2p() {
+    drainIpcc();
+    if (gQmp.state > QcomQmpIdle && gQmp.state != QcomQmpOpen) qcom_qmp_step(&gQmp);
+    if (!gP2p.in) {
+        volatile uint8_t *in = item(kItemIn);
+        if (!in) return;
+        gP2p.in = reinterpret_cast<volatile uint32_t *>(in);
+    }
+    uint32_t value = 0, changed = 0;
+    if (qcom_smp2p_service(&gP2p, "slave-kernel", &value, &changed)) kickSmp2p();
+    gSlave = value;
+    ruan_adsp_stats[3] = (int32_t)value;
+    if (changed & value & kFatal) {ruan_adsp_stats[15] = ruan_adsp_stats[15] + 1; readCrashReason();}
+    if ((value & kHandover) && !gHandedOver) {gHandedOver = true; vote(0);}   // the DSP holds its own votes now
+}
+template <typename F> bool waitUntil(uint32_t ms, F done) {
+    for (uint32_t t = 0; !done(); t += gPollMs) {
+        if (t >= ms) return done();
+        IOSleep(gPollMs);
+        serviceSmp2p();
+    }
+    return true;
+}
+
+int openImage(Image &image, char *path, size_t size) {
+    char dir[80] = "";
+    unsigned img = 0;
+    PE_parse_boot_argn("ruan-adsp-img", &img, sizeof img);
+    if (!img) img = ruan_adsp_stats[12] == 4 ? 2 : 1;   // DT qcom,msm-adsp-loader: adsp-fw-bit-values 4 -> adsp2
+    ruan_adsp_stats[13] = (int32_t)img;
+    const char *name = img == 2 ? "adsp2" : "adsp";
+    const bool chosen = PE_parse_boot_argn("ruan-adsp-fw", dir, sizeof dir) && dir[0];
+    static const uint32_t pauses[] = {1, 2, 4, 8, 16, 30, 30, 30};   // NativeUfs / the root may not be up yet: about two minutes
+    int rc = 0;
+    for (unsigned i = 0;; ++i) {
+        if (chosen) snprintf(path, size, "%s/%s.mbn", dir, name);
+        else snprintf(path, size, "modem:%s", name);
+        rc = sheng_fw_open(path, &image.file, &image.size);
+        if (!rc) {
+            rc = qcom_mdt_parse(&image.mdt, image.size, fileRead, image.file);
+            if (rc) {release(image); return 1000 - rc;}
+            return 0;
+        }
+        image.file = nullptr;
+        if ((rc != ENOENT && rc != ENXIO && rc != EIO) || i == sizeof pauses / sizeof pauses[0]) return rc;
+        IOSleep(pauses[i] * 1000);
+    }
+}
+
+bool start() {
+    char path[112];
+    Image &image = gImage;
+    int rc = openImage(image, path, sizeof path);
+    if (rc) {note("fw: ", path); fail(StFirmware, rc); return false;}
+    ruan_adsp_stats[7] = (int32_t)(image.size >> 10);
+    if (qcom_mdt_span(&image.mdt) > kAdspSize) {fail(StFirmware, -27); release(image); return false;}
+    stage(StFirmware);
+    if (ruan_adsp_stats[3] > 0) {fail(StFirmware, -114); release(image); return false;}   // running already (a kernel before us): left alone
+
+    // Our SMP2P item before the DSP starts (it looks for it at boot); only our ids enabled on the IPCC.
+    if ((rc = allocItem(kItemOut, QCOM_SMP2P_ITEM_BYTES))) {fail(StSmp2p, rc); release(image); return false;}
+    qcom_smp2p_init_out(&gP2p, reinterpret_cast<volatile uint32_t *>(item(kItemOut)), 0, kRemotePid);
+    qcom_smp2p_add_entry(&gP2p, "master-kernel");
+    const uint32_t ids[3] = {qcom_ipcc_id(QCOM_IPCC_CLIENT_LPASS, QCOM_IPCC_SIGNAL_SMP2P), qcom_ipcc_id(QCOM_IPCC_CLIENT_LPASS, QCOM_IPCC_SIGNAL_GLINK_QMP),
+                             qcom_ipcc_id(QCOM_IPCC_CLIENT_AOP, QCOM_IPCC_SIGNAL_GLINK_QMP)};
+    for (uint32_t id : ids) wr(gIpcc, QCOM_IPCC_RECV_ENABLE, id);
+    kickSmp2p();
+    stage(StSmp2p);
+
+    qcom_qmp_init(&gQmp, reinterpret_cast<volatile uint32_t *>(gAoss.va), 0x400, kickAop, nullptr);
+    waitUntil(4000, [] {return qcom_qmp_step(&gQmp) == QcomQmpOpen || gQmp.state < 0;});
+    ruan_adsp_stats[5] = (ruan_adsp_stats[5] & ~0xff) | (gQmp.state & 0xff);
+    if (gQmp.state != QcomQmpOpen) {fail(StLoadState, gQmp.state); release(image); return false;}
+    qcom_qmp_send(&gQmp, "{class: image, res: load_state, name: adsp, val: on}");
+    if (!waitUntil(1000, [] {return qcom_qmp_step(&gQmp) == QcomQmpOpen;})) {
+        qcom_qmp_abandon(&gQmp);
+        fail(StLoadState, -60); release(image); return false;
+    }
+    stage(StLoadState);
+
+    // The command database copy lives only while the two rails are looked up (heap: __DATA is tight).
+    uint8_t *db = static_cast<uint8_t *>(IOMallocData(kCmdDbSize));
+    Window dbw = {};
+    bool found = db && mapWindow(dbw, kCmdDb, kCmdDbSize);
+    for (uint64_t i = 0; found && i < kCmdDbSize; i += 4) {const uint32_t w = rd(dbw, i); memcpy(db + i, &w, 4);}
+    unmap(dbw);
+    found = found && !qcom_cmd_db_find(db, kCmdDbSize, "lcx.lvl", &gLcx) && !qcom_cmd_db_find(db, kCmdDbSize, "lmx.lvl", &gLmx);
+    if (db) IOFreeData(db, kCmdDbSize);
+    wr(gRsc, kRscTcs + 0, rd(gRsc, kRscTcs + 0) | 1u << kTcs);   // IRQ_ENABLE of our TCS (shared register: RuanTouch.c rmw's it too)
+    if (!found || (rc = vote(kLevel))) {fail(StRails, found ? rc : -2); release(image); return false;}
+    stage(StRails);
+
+    unsigned order = 0;
+    PE_parse_boot_argn("ruan-adsp-order", &order, sizeof order);
+    if ((order == 1 && (rc = loadSegments(image))) || (rc = authenticateHeader(image)) || (order != 1 && (rc = loadSegments(image)))) {
+        fail(StLoaded, rc); scm(QCOM_SCM_PAS_SHUTDOWN, qcom_scm_args(1, 0, 0, 0), kPasAdsp, 0, 0); vote(0); release(image); return false;
+    }
+    stage(StLoaded);
+    const uint64_t began = mach_absolute_time();
+    if (!scmOk(scm(QCOM_SCM_PAS_AUTH_AND_RESET, qcom_scm_args(1, 0, 0, 0), kPasAdsp, 0, 0))) {
+        fail(StStarted, -3); scm(QCOM_SCM_PAS_SHUTDOWN, qcom_scm_args(1, 0, 0, 0), kPasAdsp, 0, 0); vote(0); release(image); return false;
+    }
+    stage(StStarted);
+    const bool ready = waitUntil(10000, [] {return (gSlave & (kReady | kFatal)) != 0;});
+    uint64_t ns = 0;
+    absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+    ruan_adsp_stats[8] = (int32_t)(ns / 1000000);
+    release(image);   // the metadata may go once the image is authenticated
+    if (!ready || (gSlave & kFatal)) {
+        readCrashReason();
+        fail(StReady, ready ? -5 : -60);
+        scm(QCOM_SCM_PAS_SHUTDOWN, qcom_scm_args(1, 0, 0, 0), kPasAdsp, 0, 0);
+        if (!gHandedOver) vote(0);
+        return false;
+    }
+    stage(StReady);
+    return true;
+}
+
+void adspThread(void *, wait_result_t) {
+    thread_set_thread_name(current_thread(), "ruan-adsp");
+    unsigned mode = 0, delay = 20, fuse = 0;
+    PE_parse_boot_argn("ruan-adsp", &mode, sizeof mode);
+    PE_parse_boot_argn("ruan-adsp-delay", &delay, sizeof delay);
+    PE_parse_boot_argn("ruan-adsp-fuse", &fuse, sizeof fuse);
+    IOSleep(delay * 1000);
+    if (!mapWindow(gSmemW, kSmem, kSmemSize) || !mapWindow(gMutex, kMutex, 0x1000) || !mapWindow(gIpcc, kIpcc, 0x1000) ||
+        !mapWindow(gAoss, kAoss, 0x1000) || !mapWindow(gRsc, kRscDrv, 0x10000)) {
+        fail(StMapped, -12);
+        return;
+    }
+    gSmem = {gSmemW.va, (uint32_t)kSmemSize};
+    gLayout = qcom_rsc_layout(rd(gRsc, 0));
+    stage(StMapped);
+    survey(fuse == 1);
+    stage(StSurveyed);
+    if (mode < 2 || !start()) return;
+    // Up: the DSP is kept running; only its SMP2P state is watched (stage b replaces this loop with the GLINK/QRTR service loop).
+    gPollMs = 500;
+    for (;;) {IOSleep(gPollMs); serviceSmp2p();}
+}
+}  // namespace
+
+// USB `adsp`: [usb] ADSP: st S err E slave X items I kib K img N fuse F ready Nms scm x0/x1 qmp Q votes V meta M fatal N doorbells D | note
+extern "C" const char *ruan_adsp_status_str(void) {
+    static char line[256];
+    const volatile int32_t *s = ruan_adsp_stats;
+    snprintf(line, sizeof line, "st %d err %d slave %x items %x kib %d img %d fuse %d ready %dms scm %x/%x qmp %x rsc %x votes %x meta %d "
+             "fatal %d doorbells %d | %s", s[0], s[1], (unsigned)s[3], (unsigned)s[4], s[7], s[13], s[12], s[8], (unsigned)s[9],
+             (unsigned)s[10], (unsigned)s[5], (unsigned)s[6], (unsigned)s[11], s[14], s[15], s[2], ruan_adsp_text);
+    return line;
+}
+
+// RuanMacBootProgress.c boot_progress_start: one thread, only with ruan-adsp >= 1.
+extern "C" void ruan_adsp_probe(void) {
+    unsigned mode = 0;
+    if (!PE_parse_boot_argn("ruan-adsp", &mode, sizeof mode) || !mode || ruan_adsp_stats[0]) return;
+    thread_t thread = nullptr;
+    if (kernel_thread_start(adspThread, nullptr, &thread) != KERN_SUCCESS) {fail(StMapped, -7); return;}
+    thread_deallocate(thread);
+}
