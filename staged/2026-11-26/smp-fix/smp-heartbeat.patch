@@ -23,6 +23,14 @@
 extern uint32_t c_segment_pages_compressed;
 extern volatile uint32_t native_adreno_bo_memory[8] __attribute__((weak_import));   /* [4] GPU system BOs now, MiB */
 extern char ruan_usb_short[48];   /* package/UsbDebugCdc.cpp: "usb e.. r.. c.." or why it stopped */
+/* SMP bring-up evidence (UniXNU-macos ArmCpu, ruan-smp-sigp.patch), one [smp] line per heartbeat while more than one core is
+ * configured: per core step (1 nub .. 4 CPU_ON .. 7 running), fail code, timer and SGI interrupts taken. A core whose timer count stops
+ * growing between two lines is dead or wedged; the line before a hard reset shows which. */
+extern volatile uint32_t armcpu_smp_step[8] __attribute__((weak_import)), armcpu_smp_fail[8] __attribute__((weak_import)),
+    armcpu_core_timer[8] __attribute__((weak_import)), armcpu_core_sgi[8] __attribute__((weak_import));
+extern volatile int32_t armcpu_smp_psci_rc[8] __attribute__((weak_import));
+extern volatile uint32_t sheng_sigp_recovered __attribute__((weak_import)), sheng_idle_sigp_refused __attribute__((weak_import));
+extern int cpu_number(void);
 
 #define ZONE_BASE  0x80D80000UL
 #define ZONE_SIZE  0x80000UL
@@ -189,13 +197,27 @@
 heartbeat(void *arg __unused, wait_result_t wr __unused)
 {
 	for (;;) {
-		char line[256];
+		char line[384];   /* the [smp] line: 8 cores x ~30 bytes */
 		uint64_t t = ms();
 		int n = snprintf(line, sizeof(line), "\n[hb] %llu.%03llu free=%u act=%u inact=%u wire=%u spec=%u cmp=%u gpu=%uM irq=%llu exec=%llu exit=%llu idle=%llus %.47s | %.60s\n",
 		    t / 1000, t % 1000, vm_page_free_count, vm_page_active_count, vm_page_inactive_count, vm_page_wire_count,
 		    vm_page_speculative_count, c_segment_pages_compressed, &native_adreno_bo_memory ? native_adreno_bo_memory[4] : 0u,
 		    irqs, execs, exits, (t - last_event_ms) / 1000, ruan_usb_short, last_event);
 		zone_put(line, n > 0 ? ((unsigned)n < sizeof(line) ? (unsigned)n : sizeof(line) - 1) : 0);
+		unsigned cpus = 1;
+		PE_parse_boot_argn("cpus", &cpus, sizeof(cpus));
+		if (cpus > 1 && &armcpu_smp_step && &armcpu_core_timer) {
+			n = snprintf(line, sizeof(line), "[smp] hb-cpu%d sigp rec=%u refused=%u |", cpu_number(),
+			    &sheng_sigp_recovered ? sheng_sigp_recovered : 0, &sheng_idle_sigp_refused ? sheng_idle_sigp_refused : 0);
+			for (unsigned c = 0; c < 8 && c < cpus && n > 0 && (unsigned)n < sizeof(line); c++) {
+				n += snprintf(line + n, sizeof(line) - n, " c%u s%u f%u rc%d t%u g%u", c, armcpu_smp_step[c], armcpu_smp_fail[c],
