+			}
+			if (n > 0 && (unsigned)n < sizeof(line) - 1) {
+				line[n++] = '\n';
+			}
+			zone_put(line, n > 0 ? ((unsigned)n < sizeof(line) ? (unsigned)n : sizeof(line) - 1) : 0);
+		}
 		assert_wait_timeout((event_t)&heartbeat, THREAD_UNINT, 1000, 1000 * 1000);
 		thread_block(THREAD_CONTINUE_NULL);
 	}
