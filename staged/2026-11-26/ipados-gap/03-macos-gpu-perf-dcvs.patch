+/* The level for a window: lowest perf index in [lo, hi] whose clock runs cur's work (busy_pm per mille) at <= 60 % busy. */
+static unsigned dcvs_want(unsigned cur, unsigned busy_pm, unsigned lo, unsigned hi)
