+/* RuanThermal.c / USB `thermal`: temp-alarm stage (0 = under the first threshold, 1..3; -1 no reading) and the charger's raw
+ * BATTERY_CHARGER_STATUS_7 (CHGR + 0x0D, its JEITA soft/hard hot/cold bits; 0xffffffff no reading). */
+volatile int32_t ruan_battery_alarm_stage[2] = {-1, -1};
+volatile uint32_t ruan_battery_jeita = 0xffffffffu;
 
 static vm_offset_t arb_core = 0, arb_cnfg = 0, arb_observer = 0;
 static bool is_v7 = false;
 
+static bool vadc8_writable;   /* the arbiter gives PM7250B VADC's channel to us (EE 0): ruan-batt-therm=1 may convert */
 static inline uint32_t rd(vm_offset_t addr) { return *(volatile uint32_t *)addr; }
 static inline void wr(vm_offset_t addr, uint32_t val) { *(volatile uint32_t *)addr = val; }
 
@@ -112,6 +121,90 @@ spmi_read(const struct spmi_periph *p, uint8_t reg, uint8_t *bytes, uint32_t cou
 	return NULL;
 }
 
+/* qcom-spmi-temp-alarm.c: STATUS 0x08; subtype (0x05) 0x08 gen1: stage = bits 1:0; 0x09 gen2: state bits 6:4 -> stage
+ * {0,1,1,2,2,3,3,3}. The thresholds of a stage are set by the bootloader / Linux (gen2: 90..105 C first stage). */
+static int32_t
+alarm_stage(const struct spmi_periph *p)
+{
+	static const uint8_t gen2[8] = {0, 1, 1, 2, 2, 3, 3, 3};
+	uint8_t sub = 0, st = 0;
+	if (spmi_read(p, 0x05, &sub, 1) || spmi_read(p, 0x08, &st, 1)) return -1;
+	return sub == 0x08 ? (int32_t)(st & 3) : sub == 0x09 ? gen2[(st >> 4) & 7] : -1;
+}
+
+/* ruan-batt-therm=1: one conversion of PM7250B VADC channel 0x4a (DT bat_therm@4a: 100k NTC, ratiometric, 200 us settle), as
+ * qcom-spmi-adc5.c adc5_configure/adc5_do_conversion: DIG_PARAM 0x42 (ratiometric cal, decimation 2), FAST_AVG 0x43 (on, 1
+ * sample), CH_SEL 0x44, DELAY 0x45 (settle index 2 = 200 us), EN_CTL1 0x46 bit 7, CONV_REQ 0x47 bit 7, then STATUS1 0x08 = EOC
+ * (bits 1:0 == 1) and DATA0/1 0x50. mV = code x 1875 / 0x70e4. Writes go only to these six registers of this one peripheral,
+ * only through its channel when the arbiter's owner table gives it to EE 0, and never while TZ runs (hakios_spmi_lock).
+ * shortcut: if the ADSP converts on the same ADC at the same moment one of the two results is wrong; the 5..95 C window and the
+ * 2-in-a-row check below drop most of those. Returns hundredths of C, 0 = no reading. */
+#define ARB_CHNLS_PHYS 0x0c500000UL     /* "chnls": per-channel read/write window (RuanButtons.c) */
+static const char *
+spmi_write(const struct spmi_periph *p, uint8_t reg, uint8_t value)
+{
+	static vm_offset_t page;
+	uint64_t start = mach_absolute_time(), interval;
+	uint32_t status;
+	if (!vadc8_writable || p != &pmic_vadc8 || reg < 0x42 || reg > 0x47) return "refused";   /* the allowlist */
+	if (!page && !(page = ml_io_map(ARB_CHNLS_PHYS + (is_v7 ? 0x1000UL : 0x10000UL) * p->channel, 0x1000))) return "map failed";
+	nanoseconds_to_absolutetime(2000 * (uint64_t)NSEC_PER_USEC, &interval);
+	hakios_spmi_lock();
+	wr(page + 0x10, value);                   /* WDATA0 */
+	wr(page + 0x00, (uint32_t)reg << 4);      /* extended write, 1 byte */
+	do {
+		status = rd(page + 0x08);
+	} while (!(status & STATUS_DONE) && mach_absolute_time() - start < interval);
+	hakios_spmi_unlock();
+	return !(status & STATUS_DONE) ? "timeout" : (status & 0xe) ? "failure" : NULL;   /* denied 4, failure 2, dropped 8 */
+}
+
+/* 100k NTC (B 4250 K) with 100k pull-up to 1875 mV, every 5 C from -40: mV -> deci-C, from R = 100k exp(B (1/T - 1/298.15)). */
+static const int16_t ntc_mv[][2] = {
+	{1840, -400}, {1825, -350}, {1803, -300}, {1775, -250}, {1737, -200}, {1689, -150}, {1630, -100}, {1559, -50}, {1475, 0},
+	{1380, 50}, {1276, 100}, {1165, 150}, {1051, 200}, {938, 250}, {828, 300}, {724, 350}, {629, 400}, {543, 450}, {467, 500},
+	{401, 550}, {343, 600}, {293, 650}, {251, 700}, {214, 750}, {184, 800}, {158, 850}, {136, 900}, {117, 950}, {101, 1000},
+	{88, 1050}, {76, 1100}, {66, 1150}, {58, 1200}, {51, 1250}};
+
+int32_t
+ruan_ntc_dc(int32_t mv)
+{
+	const unsigned n = sizeof(ntc_mv) / sizeof(ntc_mv[0]);
+	if (mv >= ntc_mv[0][0]) return ntc_mv[0][1];
+	for (unsigned i = 1; i < n; i++) {
+		if (mv >= ntc_mv[i][0]) {   /* linear between rows i-1 and i */
+			return ntc_mv[i - 1][1] + (ntc_mv[i - 1][0] - mv) * (ntc_mv[i][1] - ntc_mv[i - 1][1]) / (ntc_mv[i - 1][0] - ntc_mv[i][0]);
+		}
+	}
+	return ntc_mv[n - 1][1];
+}
+
+static int32_t
+bat_therm_hundredths(void)
+{
+	static int32_t last_dc = INT32_MIN;
+	uint8_t cfg[6], st = 0, data[2];
+	const char *e = spmi_read(&pmic_vadc8, 0x42, cfg, 6);
+	if (e) return 0;
+	cfg[0] = (uint8_t)((cfg[0] & ~0x7cu) | 0x10 | 0x08);
+	cfg[1] = (uint8_t)((cfg[1] & ~0x07u) | 0x80);
+	cfg[2] = 0x4a;
+	cfg[3] = (uint8_t)((cfg[3] & ~0x0fu) | 0x02);
+	cfg[4] |= 0x80;
+	cfg[5] |= 0x80;
+	for (unsigned i = 0; i < 6 && !e; i++) e = spmi_write(&pmic_vadc8, (uint8_t)(0x42 + i), cfg[i]);   /* CONV_REQ last */
+	for (unsigned t = 0; !e && t < 20; t++) {   /* up to ~20 ms: settle 200 us + 840 decimation */
+		delay_for_interval(1, NSEC_PER_MSEC);
+		if ((e = spmi_read(&pmic_vadc8, 0x08, &st, 1)) == NULL && (st & 3) == 1) break;
+	}
+	if (e || (st & 3) != 1 || spmi_read(&pmic_vadc8, 0x50, data, 2)) return 0;
+	const int32_t code = (int16_t)(uint16_t)(data[0] | data[1] << 8), dc = ruan_ntc_dc(code < 0 ? 0 : code * 1875 / 0x70e4);
+	const int32_t prev = last_dc;
+	last_dc = dc;
+	if (dc < 50 || dc > 950 || prev == INT32_MIN || (dc > prev ? dc - prev : prev - dc) > 50) return 0;   /* sane and steady */
+	return dc * 10;
+}
