+	uint32_t therm = 0;
+	PE_parse_boot_argn("ruan-batt-therm", &therm, sizeof(therm));
+	g_ruan_battery.temperature_hundredths = therm == 1 ? bat_therm_hundredths() : 0;
+	ruan_battery_alarm_stage[0] = pmic_tm8.found ? alarm_stage(&pmic_tm8) : -1;
+	ruan_battery_alarm_stage[1] = pmic_tm4.found ? alarm_stage(&pmic_tm4) : -1;
+	uint8_t s7 = 0;
+	ruan_battery_jeita = pmic_chg8.found && spmi_read(&pmic_chg8, 0x0d, &s7, 1) == NULL ? s7 : 0xffffffffu;
 	g_ruan_battery.design_uah = 10000000;         /* 10,000 mAh: the tablet's spec, not a measurement */
 	g_ruan_battery.full_uah = 10000000;
 	g_ruan_battery.charge_uah = (int32_t)(((int64_t)g_ruan_battery.full_uah * percent) / 100);
@@ -276,6 +376,12 @@ ruan_battery_thread(void *parameter, __unused wait_result_t result)
 		find_channel(&pmic_qg8, channels);
 		find_channel(&pmic_vadc0, channels);
