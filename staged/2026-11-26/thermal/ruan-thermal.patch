+// A LUT's non-turbo levels in ascending clock (row index, MHz), same end rule as ruan_cpufreq_pick (iPadOS RuanCpuFreq.c).
+unsigned ruan_cpufreq_levels(const uint32_t *lut, unsigned rows, uint8_t *row, uint16_t *mhz)
+{
+	unsigned n = 0, prev = 0;
+	for (unsigned i = 0; i < rows; i++) {
+		uint32_t d = lut[i];
+		unsigned f = (d >> 30) ? (d & 0xff) * 192 / 10 : 300;
+		if (!(d & 0xff) || (i && f == prev)) {
+			break;
+		}
+		prev = f;
+		if (i && ((d >> 16) & 7) == 1) {
+			continue;
+		}
+		unsigned at = n++;
+		while (at && mhz[at - 1] > f) {
+			mhz[at] = mhz[at - 1], row[at] = row[at - 1], at--;
+		}
+		mhz[at] = (uint16_t)f, row[at] = (uint8_t)i;
+	}
+	return n;
+}
+
 #ifndef RUAN_CPUFREQ_HOST
 #ifndef RUAN_CPUFREQ_DEFAULT
 #define RUAN_CPUFREQ_DEFAULT 0
 #endif
 static unsigned mode = RUAN_CPUFREQ_DEFAULT;
 static volatile uint32_t *dom[2];   // USB `cpufreq`
+static uint8_t lv_row[2][kRows];
+static uint16_t lv_mhz[2][kRows];
+static unsigned lv_n[2], lv_cur[2], lv_cores[2];
+static volatile uint32_t lv_ready[2];   // set once the boot vote is in: ruan_cpufreq_cap may vote from then on
 
 static void
