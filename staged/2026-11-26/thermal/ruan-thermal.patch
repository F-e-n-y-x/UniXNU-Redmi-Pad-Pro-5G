@@ -65,6 +93,7 @@ domain(unsigned d, uint64_t phys)
 		lut[i] = r[(kLut + 4 * i) / 4];
 	}
 	int top = ruan_cpufreq_pick(lut, kRows, &mhz);
+	lv_n[d] = ruan_cpufreq_levels(lut, kRows, lv_row[d], lv_mhz[d]);
 	printf("ruan-cpufreq: d%u state %u MHz, top row %d = %u MHz, dcvs 0x%x\n", d, (r[kState / 4] & 0xff) * 192 / 10, top, mhz,
 	    r[kDcvs / 4]);
 	dom[d] = r;
@@ -78,6 +107,39 @@ domain(unsigned d, uint64_t phys)
 	assert_wait_timeout((event_t)&mode, THREAD_UNINT, 200, NSEC_PER_MSEC);
 	thread_block(THREAD_CONTINUE_NULL);
 	printf("ruan-cpufreq: d%u voted row %d, state now %u MHz\n", d, top, (r[kState / 4] & 0xff) * 192 / 10);
+	if (lv_n[d] && lv_row[d][lv_n[d] - 1] == (uint8_t)top) {   // the boot vote is the top level: caps count down from it
+		lv_cur[d] = lv_n[d] - 1, lv_cores[d] = cores;
+		__atomic_store_n(&lv_ready[d], 1, __ATOMIC_RELEASE);
+	}
+}
+
+// RuanThermal.c: vote domain d at most `below` levels under its top (0 = the boot vote, >= levels = the lowest). Votes only on a
+// change. Returns the level's MHz, 0 when the domain was never voted (mode < 2, cluster down) and nothing was written.
+unsigned
+ruan_cpufreq_cap(unsigned d, unsigned below)
+{
+	if (d > 1 || !__atomic_load_n(&lv_ready[d], __ATOMIC_ACQUIRE)) {
+		return 0;
+	}
+	unsigned l = below >= lv_n[d] ? 0 : lv_n[d] - 1 - below;
+	if (l != lv_cur[d]) {
+		for (unsigned i = 0; i < lv_cores[d]; i++) {
+			dom[d][(kPerf + 4 * i) / 4] = lv_row[d][l];
+		}
+		lv_cur[d] = l;
+	}
+	return lv_mhz[d][l];
+}
+
+// RuanThermal.c / USB `thermal`: domain d's delivered clock (EPSS domain_state, after the LMh limit; what upstream
+// qcom_lmh_get_throttle_freq reads on EPSS), its vote and its level count. 0 = not read yet.
+void
+ruan_cpufreq_domain(unsigned d, unsigned *state_mhz, unsigned *vote_mhz, unsigned *levels)
+{
+	int ok = d < 2 && dom[d];
+	*state_mhz = ok ? (dom[d][kState / 4] & 0xff) * 192 / 10 : 0;
+	*vote_mhz = ok && lv_ready[d] ? lv_mhz[d][lv_cur[d]] : 0;
+	*levels = ok ? lv_n[d] : 0;
 }
 
