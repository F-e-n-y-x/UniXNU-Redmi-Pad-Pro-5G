+		if (pmic_vadc8.found) {
+			vadc8_writable = (rd(arb_cnfg + (is_v7 ? ARB_OWNER_V7(pmic_vadc8.channel) : ARB_OWNER_V5(pmic_vadc8.channel))) & 7) == ARB_SYSTEM;
+			bprintf("battery: PM7250B VADC channel %u owner %s\n", pmic_vadc8.channel, vadc8_writable ? "EE 0 (us)" : "another EE (no conversions)");
+		}
 	}
 
