diff --git a/package/RuanThermal.c b/package/RuanThermal.c
new file mode 100644
index 0000000..a567356
--- /dev/null
+++ b/package/RuanThermal.c
@@ -0,0 +1,239 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// ruan-thermal=<n>: temperatures, CPU caps and macOS's thermal pressure level for ruan (SM7435). Default 2; 1 reads and reports
+// only (no vote), 0 is off. A kernel thread, once a second:
+//   - TSENS (live DT qcom,tsens-v2): tsens0 TM 0x0c263000, tsens1 TM 0x0c265000 (reg[0] of thermal-sensor@c263000/@c265000).
+//     TM_Sn_STATUS 0xa0 + 4n: bits 11:0 signed deci-C, bit 21 valid, up to three reads (tsens-v2.c; iPadOS RuanCpuFreq.c mode 3).
+//     Sensor numbers are the DT thermal-zones cells (table below).
+//   - LMh: per EPSS domain the delivered clock (domain_state 0x20) against our vote (RuanCpuFreq.c ruan_cpufreq_domain). Below the
+//     vote = the firmware limiter (LMh / dcvsh) is holding the domain down; counted in seconds.
+//   - battery: RuanBattery.c's g_ruan_battery.temperature_hundredths (0 = no reading) and its PMIC temp-alarm stage.
+// Policy (deci-C, each step lifts 5 C under its threshold): a group's step is the number of its thresholds crossed.
+//   A78 (cpu-1-0..7)  80 / 90 / 100 C: cap 1 level / the middle level / the lowest level of domain 1
+//   A55 (cpu-0-0..3)  90 / 90 / 100 C: the middle level / the lowest level of domain 0
+//   GPU (gpuss-0/1)   85 / 95 / 105 C: no GPU cap on macOS (one 734 MHz level, RuanGpuPower.c), feeds the level only
+//   battery           45 / 50 / 60 C: report only (the charger belongs to the ADSP: no writes), feeds the level
+// Step 3 anywhere = emergency: both CPU domains at their lowest level and a console line every 10 s while it lasts.
+// No valid reading = step 0 for that group (it can neither raise nor hold a cap), counted in `invalid`.
+// The level for macOS (RuanThermalLevel.cpp, thermal-level=1) is the highest step: 0 nominal, 1 moderate, 2 heavy, 3 trapping.
+#include <stdint.h>
+#ifndef RUAN_THERMAL_HOST
+#include <kern/thread.h>
+#include <kern/misc_protos.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "RuanBattery.h"
+extern wait_result_t assert_wait_timeout(event_t, wait_interrupt_t, uint32_t, uint32_t);
+extern unsigned ruan_cpufreq_cap(unsigned d, unsigned below);
+extern void ruan_cpufreq_domain(unsigned d, unsigned *state_mhz, unsigned *vote_mhz, unsigned *levels);
+extern volatile int32_t ruan_battery_alarm_stage[2];   // RuanBattery.c: PM7250B, PM6150L temp-alarm stage, -1 = no reading
+extern volatile uint32_t ruan_battery_jeita;           // RuanBattery.c: CHGR BATTERY_CHARGER_STATUS_7, 0xffffffff = no reading
+#endif
+
+#define NONE INT32_MIN
+enum {G_A55, G_A78, G_GPU, G_BATT, GROUPS};
+static const char *const group_name[GROUPS] = {"a55", "a78", "gpu", "batt"};
+static const int16_t thr[GROUPS][3] = {{900, 900, 1000}, {800, 900, 1000}, {850, 950, 1050}, {450, 500, 600}};
+
+// tsens-v2 TM_Sn_STATUS in deci-C, NONE when the valid bit (21) is clear (= iPadOS ruan_tsens_dc).
+static int32_t
+tsens_dc(uint32_t v)
+{
+	return (v & (1u << 21)) ? (int32_t)(v << 20) >> 20 : NONE;
+}
+
+// Thresholds crossed by dc, given `cur` crossed before: a crossed one holds until dc is 5 C under it.
+static unsigned
+step(unsigned cur, int32_t dc, const int16_t *t)
+{
+	unsigned s = 0;
+	if (dc == NONE) {
+		return 0;
+	}
+	while (s < 3 && dc > (cur > s ? t[s] - 50 : t[s])) {
+		s++;
+	}
+	return s;
+}
+
+// Levels under the top for a CPU step: 0, 1, the middle level ((n-1)/2 from the bottom), the lowest.
+static unsigned
+below(unsigned s, unsigned n)
+{
+	return s == 0 ? 0 : s == 1 ? 1 : s == 2 ? (n ? (n - 1) - (n - 1) / 2 : 0) : ~0u;
+}
+
+#if defined(RUAN_THERMAL_HOST) && defined(RUAN_THERMAL_SELFTEST)
+// cc -DRUAN_THERMAL_HOST -DRUAN_THERMAL_SELFTEST RuanThermal.c && ./a.out
+#include <assert.h>
+int main(void)
+{
+	assert(tsens_dc((1u << 21) | 0x384) == 900 && tsens_dc((1u << 21) | 0xff6) == -10 && tsens_dc(0x384) == NONE);
+	assert(step(0, 800, thr[G_A78]) == 0 && step(0, 801, thr[G_A78]) == 1 && step(0, 901, thr[G_A78]) == 2);
+	assert(step(2, 860, thr[G_A78]) == 2 && step(2, 850, thr[G_A78]) == 1 && step(1, 751, thr[G_A78]) == 1);
+	assert(step(1, 750, thr[G_A78]) == 0 && step(0, 1001, thr[G_A78]) == 3 && step(3, 951, thr[G_A78]) == 3);
+	assert(step(3, NONE, thr[G_A78]) == 0);
+	assert(step(0, 901, thr[G_A55]) == 2 && step(2, 851, thr[G_A55]) == 2 && step(2, 850, thr[G_A55]) == 0);
+	assert(below(0, 9) == 0 && below(1, 9) == 1 && below(2, 9) == 4 && below(2, 8) == 4 && below(3, 9) >= 9);
+	return 0;
+}
+#endif
+
+#ifndef RUAN_THERMAL_HOST
+#ifndef RUAN_THERMAL_DEFAULT
+#define RUAN_THERMAL_DEFAULT 2
+#endif
+struct sensor {const char *name; uint8_t tsens, n, group;};
+// Live DT thermal-zones (docs/hardware/private/ruan-live.dts 9904-10847): tsens0 = phandle 0x168, tsens1 = 0x175.
+static const struct sensor sensors[] = {
+	{"aoss0", 0, 0, GROUPS}, {"cpuss0", 0, 1, GROUPS}, {"cpuss1", 0, 2, GROUPS},
+	{"cpu1-0", 0, 3, G_A78}, {"cpu1-1", 0, 4, G_A78}, {"cpu1-2", 0, 5, G_A78}, {"cpu1-3", 0, 6, G_A78},
+	{"cpu1-4", 0, 7, G_A78}, {"cpu1-5", 0, 8, G_A78}, {"cpu1-6", 0, 9, G_A78}, {"cpu1-7", 0, 10, G_A78},
+	{"gpu0", 0, 11, G_GPU}, {"gpu1", 0, 12, G_GPU}, {"cam0", 0, 13, GROUPS},
+	{"aoss1", 1, 0, GROUPS}, {"cpu0-0", 1, 1, G_A55}, {"cpu0-1", 1, 2, G_A55}, {"cpu0-2", 1, 3, G_A55}, {"cpu0-3", 1, 4, G_A55},
+	{"nsp0", 1, 5, GROUPS}, {"nsp1", 1, 6, GROUPS}, {"nsp2", 1, 7, GROUPS}, {"video", 1, 8, GROUPS}, {"ddr", 1, 9, GROUPS},
+	{"mdm0", 1, 10, GROUPS}, {"mdm1", 1, 11, GROUPS}, {"mdm2", 1, 12, GROUPS}, {"mdm3", 1, 13, GROUPS},
+};
+enum {SENSORS = sizeof(sensors) / sizeof(sensors[0])};
+
+static unsigned mode = RUAN_THERMAL_DEFAULT;
+static volatile uint32_t *tm[2];
+static int32_t now_dc[SENSORS], group_dc[GROUPS], hottest_dc = NONE;
+static unsigned group_step[GROUPS], capped_below[2];
+static uint32_t rounds, invalid, emergencies, lmh_s[2], lmh_min[2], cap_changes;
+volatile uint32_t ruan_thermal_level;   // RuanThermalLevel.cpp: the pressure level, 0..3
+
+static int32_t
+read_sensor(const struct sensor *s)
+{
+	int32_t v = NONE;
+	for (unsigned i = 0; i < 3 && v == NONE && tm[s->tsens]; i++) {   // tsens.c: up to three reads for the valid bit
+		v = tsens_dc(tm[s->tsens][(0xa0 + 4 * s->n) / 4]);
+	}
+	return v;
+}
+
+static void
+round_once(void)
+{
+	unsigned level = 0, emergency = 0;
+	for (unsigned g = 0; g < GROUPS; g++) {
+		group_dc[g] = NONE;
+	}
+	hottest_dc = NONE;
+	for (unsigned i = 0; i < SENSORS; i++) {
+		int32_t v = now_dc[i] = read_sensor(&sensors[i]);
+		if (v == NONE) {
+			continue;
+		}
+		hottest_dc = v > hottest_dc ? v : hottest_dc;
+		if (sensors[i].group < GROUPS && v > group_dc[sensors[i].group]) {
+			group_dc[sensors[i].group] = v;
+		}
+	}
+	if (g_ruan_battery.temperature_hundredths) {
+		group_dc[G_BATT] = g_ruan_battery.temperature_hundredths / 10;
+	}
+	for (unsigned g = 0; g < GROUPS; g++) {
+		invalid += group_dc[g] == NONE && g != G_BATT;
+		group_step[g] = step(group_step[g], group_dc[g], thr[g]);
+		level = group_step[g] > level ? group_step[g] : level;
+		emergency |= group_step[g] == 3 && g != G_BATT;   // a hot battery cannot be cooled by the CPU clock alone: report it
+	}
+	for (unsigned d = 0; d < 2; d++) {
+		unsigned st, vote, n;
+		ruan_cpufreq_domain(d, &st, &vote, &n);
+		if (vote && st && st < vote) {
+			lmh_s[d]++;
+			lmh_min[d] = !lmh_min[d] || st < lmh_min[d] ? st : lmh_min[d];
+		}
+		unsigned b = emergency ? ~0u : below(group_step[d == 0 ? G_A55 : G_A78], n);
+		if (mode >= 2 && b != capped_below[d] && ruan_cpufreq_cap(d, b)) {
+			printf("ruan-thermal: d%u cap %u -> %u levels under top (a55 %d a78 %d gpu %d dC)\n", d, capped_below[d], b,
+			    group_dc[G_A55], group_dc[G_A78], group_dc[G_GPU]);
+			capped_below[d] = b;
+			cap_changes++;
+		}
+	}
+	if (emergency && emergencies++ % 10 == 0) {
+		printf("ruan-thermal: EMERGENCY hottest %d dC (a55 %d a78 %d gpu %d): CPUs at their lowest level\n", hottest_dc,
+		    group_dc[G_A55], group_dc[G_A78], group_dc[G_GPU]);
+	}
+	if (group_step[G_BATT] && g_ruan_battery.status == 1 && rounds % 60 == 0) {
+		printf("ruan-thermal: battery %d dC while charging (report only: the ADSP owns the charger)\n", group_dc[G_BATT]);
+	}
+	if (level != ruan_thermal_level) {
+		printf("ruan-thermal: level %u -> %u\n", ruan_thermal_level, level);
+	}
+	ruan_thermal_level = level;
+	rounds++;
+}
+
+static void
+run(void *arg __unused, wait_result_t wr __unused)
+{
+	tm[0] = (volatile uint32_t *)ml_io_map(0x0c263000, 0x1000);
+	tm[1] = (volatile uint32_t *)ml_io_map(0x0c265000, 0x1000);
+	printf("ruan-thermal: mode %u, tsens0 %s, tsens1 %s\n", mode, tm[0] ? "mapped" : "MAP FAILED", tm[1] ? "mapped" : "MAP FAILED");
+	for (;;) {
+		round_once();
+		assert_wait_timeout((event_t)&mode, THREAD_UNINT, 1000, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+static void
+put_dc(char *out, unsigned len, unsigned *at, const char *name, int32_t dc)
+{
+	int32_t a = dc < 0 ? -dc : dc;
+	int n = dc == NONE ? snprintf(out + *at, len - *at, " %s -", name)
+	                   : snprintf(out + *at, len - *at, " %s %s%d.%d", name, dc < 0 ? "-" : "", a / 10, a % 10);
+	*at += n > 0 && (unsigned)n < len - *at ? (unsigned)n : 0;
+}
+
+// USB `thermal` (UsbDebugCdc.cpp): row i of the report, 0 when there is no row i.
+unsigned
+ruan_thermal_report(unsigned i, char *out, unsigned len)
+{
+	static const char *const level_name[4] = {"nominal", "moderate", "heavy", "trapping"};
+	unsigned at = 0;
+	if (i == 0) {
+		at = (unsigned)snprintf(out, len, "mode %u level %u %s rounds %u invalid %u emergencies %u caps %u |", mode,
+		    ruan_thermal_level, level_name[ruan_thermal_level & 3], rounds, invalid, emergencies, cap_changes);
+		for (unsigned g = 0; g < GROUPS && at < len; g++) {
+			put_dc(out, len, &at, group_name[g], group_dc[g]);
+			at += (unsigned)snprintf(out + at, len - at, " s%u", group_step[g]);
+		}
+	} else if (i == 1) {
+		for (unsigned d = 0; d < 2; d++) {
+			unsigned st, vote, n;
+			ruan_cpufreq_domain(d, &st, &vote, &n);
+			at += (unsigned)snprintf(out + at, len - at, "d%u vote %u MHz state %u MHz levels %u capped %u%s lmh %us min %u MHz; ",
+			    d, vote, st, n, capped_below[d] > 99 ? 99 : capped_below[d], vote && st < vote ? " THROTTLED" : "", lmh_s[d],
+			    lmh_min[d]);
+		}
+	} else if (i == 2 || i == 3) {
+		at = (unsigned)snprintf(out, len, "tsens%u:", i - 2);
+		for (unsigned s = 0; s < SENSORS; s++) {
+			if (sensors[s].tsens == i - 2) {
+				put_dc(out, len, &at, sensors[s].name, now_dc[s]);
+			}
+		}
+	} else if (i == 4) {
+		at = (unsigned)snprintf(out, len, "pmic: pm7250b alarm stage %d pm6150l %d, jeita 0x%x, battery %d.%02d C%s",
+		    ruan_battery_alarm_stage[0], ruan_battery_alarm_stage[1], ruan_battery_jeita, g_ruan_battery.temperature_hundredths / 100,
+		    g_ruan_battery.temperature_hundredths % 100, g_ruan_battery.temperature_hundredths ? "" : " (no reading: ruan-batt-therm=1)");
+	}
+	return at;
+}
+
+// RuanMacBootProgress.c boot_progress_start, after ruan_cpufreq_start.
+void
+ruan_thermal_start(void)
+{
+	thread_t thread;
+	PE_parse_boot_argn("ruan-thermal", &mode, sizeof(mode));
+	if (mode && kernel_thread_start(run, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif
diff --git a/package/RuanThermalLevel.cpp b/package/RuanThermalLevel.cpp
new file mode 100644
index 0000000..1eb7f11
--- /dev/null
+++ b/package/RuanThermalLevel.cpp
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// thermal-level=1: macOS's thermal pressure level from RuanThermal.c (ruan_thermal_level, 0..3). Off by default.
+// Taken from UniXNU-sheng package/ThermalLevel.{h,cpp} (same macOS 27.3 26C5035r; not run on hardware there either), trimmed to
+// ruan's one input. What it rests on (sheng ThermalLevel.h has the addresses):
+//   thermalmonitord does not compute a level: once a second it opens IOServiceMatching("AppleSMCSensorDispatcher") with type 0,
+//   asks selector 0 (key count), 1 (fifteen 32-bit key codes, 60 bytes) and 2 (their values, 60 bytes), and posts the value of key
+//   'mTPL' as notify_set_state + notify_post of com.apple.system.thermalpressurelevel (kOSThermalNotificationPressureLevelName).
+//   Foundation maps 1/2 to NSProcessInfoThermalStateFair, 3 Serious, 4 Critical. No SMC is needed: AppleSMC is not in the image,
+//   so this service carries Apple's class names and the user client checks the original's entitlement
+//   com.apple.private.smcsensor.user-access (thermalmonitord has it).
+// ruan_thermal_level 0..3 goes out as OSThermalPressureLevel 0 nominal, 1 moderate, 2 heavy, 3 trapping (never 4 sleeping).
+// Built as a "late" object (build-gop-legacy-display-27.py: __mod_init_func removed, initializer globalized) and registered by
+// ruan_thermal_level_probe() from LegacyDisplayProbe.cpp, as NativeHidInput / KeyStoreProbe are.
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <libkern/c++/OSSymbol.h>
+#include <mach/kmod.h>
+#include <pexpert/pexpert.h>
+
+extern kmod_info_t g_kernel_kmod_info;
+extern "C" {
+extern volatile uint32_t ruan_thermal_level __attribute__((weak_import));   // RuanThermal.c
+void ruan_thermal_level_static_init(void) __asm__("__GLOBAL__sub_I_RuanThermalLevel.cpp");
+int proc_selfpid(void);
+volatile int32_t ruan_thermal_level_state;   // 0 off, 1 published, -2 no memory, -3 attach/start, -10/-11 classes, -12 name taken
+volatile uint32_t ruan_thermal_level_use[4];  // opens, refused (no entitlement), value reads, last reader pid
+}
+
+namespace {
+constexpr uint32_t kKeyMTPL = 0x6d54504cu;   // 'mTPL'
+constexpr unsigned kSlots = 15;
+}
+
+class AppleSMCSensorDispatcher : public IOService {
+    OSDeclareDefaultStructors(AppleSMCSensorDispatcher)
+};
+OSDefineMetaClassAndStructors(AppleSMCSensorDispatcher, IOService)
+
+class AppleSMCSensorDispatcherUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(AppleSMCSensorDispatcherUserClient)
+    int32_t pid = 0;
+
+    static IOReturn sCount(OSObject *, void *, IOExternalMethodArguments *a) {
+        a->scalarOutput[0] = 1;
+        return kIOReturnSuccess;
+    }
+    static IOReturn sKeys(OSObject *, void *, IOExternalMethodArguments *a) {
+        uint32_t k[kSlots] = {kKeyMTPL};
+        if (!a->structureOutput) return kIOReturnBadArgument;
+        memcpy(a->structureOutput, k, sizeof k);
+        return kIOReturnSuccess;
+    }
+    static IOReturn sValues(OSObject *t, void *, IOExternalMethodArguments *a) {
+        uint32_t v[kSlots] = {&ruan_thermal_level ? ruan_thermal_level : 0};
+        if (!a->structureOutput) return kIOReturnBadArgument;
+        memcpy(a->structureOutput, v, sizeof v);
+        ruan_thermal_level_use[2]++;
+        ruan_thermal_level_use[3] = (uint32_t)static_cast<AppleSMCSensorDispatcherUserClient *>(t)->pid;
+        return kIOReturnSuccess;
+    }
+    static IOReturn sWrite(OSObject *, void *, IOExternalMethodArguments *a) {   // the original writes SMC keys: dropped
+        return a->structureInput ? kIOReturnSuccess : kIOReturnBadArgument;
+    }
+
+public:
+    bool initWithTask(task_t task, void *security, UInt32 type) override {
+        OSObject *e = copyClientEntitlement(task, "com.apple.private.smcsensor.user-access");
+        const bool ok = e == kOSBooleanTrue;
+        OSSafeReleaseNULL(e);
+        if (!ok) {ruan_thermal_level_use[1]++; return false;}
+        if (!IOUserClient::initWithTask(task, security, type)) return false;
+        pid = proc_selfpid();
+        return true;
+    }
+    bool start(IOService *provider) override {
+        if (!OSDynamicCast(AppleSMCSensorDispatcher, provider) || !IOUserClient::start(provider)) return false;
+        setProperty(kIOUserClientDefaultLockingKey, kOSBooleanTrue);
+        ruan_thermal_level_use[0]++;
+        return true;
+    }
+    IOReturn clientClose() override {
+        terminate();
+        return kIOReturnSuccess;
+    }
+    // Apple's table for selectors 0..3 (scalar counts and structure sizes checked by IOUserClient::externalMethod).
+    IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args, IOExternalMethodDispatch *, OSObject *, void *) override {
+        static const IOExternalMethodDispatch methods[4] = {
+            {&AppleSMCSensorDispatcherUserClient::sCount, 0, 0, 1, 0},
+            {&AppleSMCSensorDispatcherUserClient::sKeys, 0, 0, 0, 4 * kSlots},
+            {&AppleSMCSensorDispatcherUserClient::sValues, 0, 0, 0, 4 * kSlots},
+            {&AppleSMCSensorDispatcherUserClient::sWrite, 0, 88, 0, 0},
+        };
+        if (selector >= 4) return kIOReturnUnsupported;
+        return IOUserClient::externalMethod(selector, args, const_cast<IOExternalMethodDispatch *>(&methods[selector]), this, nullptr);
+    }
+};
+OSDefineMetaClassAndStructors(AppleSMCSensorDispatcherUserClient, IOUserClient)
+
+extern "C" void ruan_thermal_level_probe(void) {
+    unsigned on = 0;
+    PE_parse_boot_argn("thermal-level", &on, sizeof on);
+    if (on != 1 || ruan_thermal_level_state) return;
+    static const char *const kNames[2] = {"AppleSMCSensorDispatcher", "AppleSMCSensorDispatcherUserClient"};
+    for (const char *name : kNames) {   // must be free: AppleSMC is not in the image
+        const OSSymbol *sym = OSSymbol::withCString(name);
+        const bool taken = sym && OSMetaClass::getMetaClassWithName(sym);
+        OSSafeReleaseNULL(sym);
+        if (taken) {ruan_thermal_level_state = -12; return;}
+    }
+    void *handle = OSMetaClass::preModLoad(g_kernel_kmod_info.name);
+    if (!handle) {ruan_thermal_level_state = -10; return;}
+    ruan_thermal_level_static_init();
+    if (OSMetaClass::postModLoad(handle)) {ruan_thermal_level_state = -11; return;}
+    AppleSMCSensorDispatcher *service = OSTypeAlloc(AppleSMCSensorDispatcher);
+    IOService *platform = IOService::getPlatform();
+    if (!service || !service->init()) {OSSafeReleaseNULL(service); ruan_thermal_level_state = -2; return;}
+    service->setProperty("IOUserClientClass", "AppleSMCSensorDispatcherUserClient");
+    if (!service->attach(platform)) {service->release(); ruan_thermal_level_state = -3; return;}
+    if (!service->start(platform)) {service->detach(platform); service->release(); ruan_thermal_level_state = -3; return;}
+    service->registerService();
+    service->release();   // the platform's attachment keeps it
+    ruan_thermal_level_state = 1;
+}
