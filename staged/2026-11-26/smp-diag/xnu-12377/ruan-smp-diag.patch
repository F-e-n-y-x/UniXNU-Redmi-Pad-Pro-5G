+/*
+ * ruan SMP diagnostics: a breadcrumb per core (index MPIDR Aff1 & 7), written with plain stores so it also works with the MMU
+ * off. ruan_smp_crumb (package/RuanMacBootProgress.c) gives each core its own 64-byte line: [0] step, [1] CNTVCT, [2] ESR,
+ * [3] ELR, [4] FAR. The heartbeat cleans+invalidates the lines and prints them into ramoops once a second.
+ * Steps: 1 reset_vector, 2 cpu data found, 3 handler validated, 4 start_cpu, 5 common_start before MMU on, 0xe no cpu data /
+ * bad handler, 0xf0+n exception at LowExceptionVectorBase slot n (MMU off). Clobbers x16, x17 only.
+ */
+.macro RUAN_CRUMB step
+	mrs		x16, MPIDR_EL1
+	ubfx	x16, x16, #8, #3
+	adrp	x17, EXT(ruan_smp_crumb)@page
+	add		x17, x17, EXT(ruan_smp_crumb)@pageoff
+	add		x17, x17, x16, lsl #6
+	mov		x16, #(\step)
+	str		x16, [x17]
+	mrs		x16, CNTVCT_EL0
+	str		x16, [x17, #8]
+	dsb		sy
+.endmacro
+
+.macro RUAN_CRUMB_EXC slot
+	RUAN_CRUMB (0xf0 + \slot)
+	mrs		x16, ESR_EL1
+	str		x16, [x17, #16]
+	mrs		x16, ELR_EL1
+	str		x16, [x17, #24]
+	mrs		x16, FAR_EL1
+	str		x16, [x17, #32]
+	dsb		sy
+	b		.
+.endmacro
+
