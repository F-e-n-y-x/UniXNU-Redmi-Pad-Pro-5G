+// Why the last reset happened, read only: PMK8350 (SID 0) PON registers through the observer channel. Gen3 PON keeps its reason
+// registers in the PBS peripheral 0x08 (Linux qpnp-power-on.c, PON_OFFSET gen2/3 column): 0xc0 PON_REASON1, 0xc2 WARM_RESET_REASON1,
+// 0xc5 POFF_REASON1, 0xc7 OFF_REASON, 0xc8/0xc9 FAULT_REASON1/2, 0xca S3_RESET_REASON. Printed raw: compare with Android's decode
+// ("PMIC@SID0: Power-off reason ..." in dmesg) once. POFF bit 1 = PS_HOLD (SoC/TZ/hypervisor reset: PSCI reset or a watchdog bite),
+// bit 2 = PMIC watchdog, bits 6/7 = keys; S3 reason set = PMIC-level hard reset. The SDAM reboot cell 0x48 is read as well.
+static int pon_apid(const struct br_arbiter *a, uint32_t apids, uint32_t ppid) {
+  int apid = -1;
+  for (uint32_t i = 0; i < apids; ++i) {
+    uint32_t map = a->core[(BR_APID_MAP + 4 * i) / 4];
+    if (map && ((map >> 8) & 0xfff) == ppid) {apid = (int)i; break;}
+  }
+  return apid;
+}
+int boot_reset_pon(char *text, unsigned cap) {
+  struct reset_maps m;
+  int rc = open_maps(&m, 0);   // maps the observer up to the SDAM's APID; remapped below to cover the PON APIDs
+  if (rc) {snprintf(text, cap, "pon: arbiter open=%d find=%d", rc, m.find); unmap_all(&m); return rc;}
+  uint8_t cell = 0xff;
+  br_read8(m.obs, &m.a, m.f.apid, BR_REBOOT_CELL, &cell);
+  const int pbs = pon_apid(&m.a, m.f.apids, 0x008), hlos = pon_apid(&m.a, m.f.apids, 0x013);
+  const int top = pbs > hlos ? pbs : hlos;
+  if (top < 0) {snprintf(text, cap, "pon: no APID for PON (pbs %d hlos %d) sdam48=%02x", pbs, hlos, cell); unmap_all(&m); return 6;}
+  ml_io_unmap((vm_offset_t)m.obs, (vm_size_t)m.obs_size);
+  m.obs_size = ((uint64_t)BR_OBS_APID_STRIDE * ((uint64_t)top + 1) + 0xfff) & ~0xfffull;
+  m.obs = map(SpmiObsrvr, m.obs_size);
+  if (!m.obs) {snprintf(text, cap, "pon: observer map failed"); unmap_all(&m); return 7;}
+  uint8_t r[16], h[8];
+  int bad = 0;
+  for (unsigned i = 0; i < 16; i++) {r[i] = 0xee; if (pbs >= 0 && br_read8(m.obs, &m.a, pbs, (uint8_t)(0xc0 + i), &r[i])) bad++;}
+  for (unsigned i = 0; i < 8; i++) {h[i] = 0xee; if (hlos >= 0 && br_read8(m.obs, &m.a, hlos, (uint8_t)(0x08 + i), &h[i])) bad++;}
+  snprintf(text, cap, "pon: pbs[c0..cf]=%02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x "
+           "(pon_reason1 %02x warm1 %02x poff1 %02x off %02x fault1 %02x fault2 %02x s3 %02x) hlos[08..0f]=%02x %02x %02x %02x %02x %02x %02x %02x "
+           "sdam48=%02x bad=%d",
+           r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10], r[11], r[12], r[13], r[14], r[15],
+           r[0], r[2], r[5], r[7], r[8], r[9], r[10], h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7], cell, bad);
+  unmap_all(&m);
+  return bad ? 8 : 0;
+}
