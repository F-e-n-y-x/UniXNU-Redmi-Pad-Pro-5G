+/* ruan SMP diagnostics. Per core (MPIDR Aff1 & 7) one 64-byte line, written by xnu-12377/ruan-smp-diag.patch start.s with the
+ * MMU off (so the heartbeat cleans+invalidates before reading): [0] step, [1] CNTVCT, [2] ESR, [3] ELR, [4] FAR. */
+uint64_t ruan_smp_crumb[8][8] __attribute__((aligned(64)));
+
+void ruan_smp_event(const char *fmt, ...) __printflike(1, 2);
+void
+ruan_smp_event(const char *fmt, ...)
+{
+	char text[128];
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(text, sizeof(text), fmt, ap);
+	va_end(ap);
+	event(text);
+}
+
+/* " c1=6@183020/a7" for each core that left a crumb (ms of its last crumb, ArmCpu step), with ESR/ELR/FAR for an early exception */
+static int
+smp_crumbs(char *out, size_t size)
+{
+	int n = 0;
+	out[0] = 0;
+	for (unsigned i = 1; i < 8 && n >= 0 && (size_t)n < size; i++) {
+		volatile uint64_t *c = ruan_smp_crumb[i];
+		__asm__ volatile ("dc civac, %0\n\tdsb sy" :: "r"(c) : "memory");
+		const uint64_t step = c[0], when = freq ? c[1] / (freq / 1000) : 0;
+		const uint32_t armcpu = &armcpu_smp_step ? armcpu_smp_step[i] : 0;
+		if (!step && !armcpu) {
+			continue;
+		}
+		n += snprintf(out + n, size - n, " c%u=%llx@%llu/a%u", i, step, when, armcpu);
+		if (step >= 0xf0 && (size_t)n < size) {
+			n += snprintf(out + n, size - n, "(esr %llx elr %llx far %llx)", c[2], c[3], c[4]);
+		}
+	}
+	return n;
+}
