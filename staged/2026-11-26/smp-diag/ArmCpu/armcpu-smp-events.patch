+// Board boot log (ruan: package/RuanMacBootProgress.c writes an [ev] line straight into the ramoops ring, which survives a hard
+// reset). Weak: boards without it log nothing.
+extern "C" void boot_progress_stage (const char *) __attribute__ ((weak_import));
+static void __attribute__ ((format (printf, 1, 2))) armEvent (const char *format, ...)
+{
+  if (&boot_progress_stage == nullptr) { return; }
+  char text[128];
+  va_list ap;
+  va_start (ap, format);
+  vsnprintf (text, sizeof (text), format, ap);
+  va_end (ap);
+  boot_progress_stage (text);
+}
+static volatile uint32_t gFirstIpiLogged = 0;   // bit per logical core: its first IPI is logged once
 
